(module live-demo)
(import "live-poc-coil.meta")
(import "coil.primitive" :as p)
(import "live-poc-coil.paper-api" :as paper)
(defstruct State [(clicks i64)])
(defn* state [] (-> (ptr State)) (p/alloc-static State))
(defn button-pigment [] (-> u32) 0xc77855)
(defn draw [] (-> i64)
  (paper/begin 0x343d34)
  (paper/panel 24.0 24.0 592.0 432.0 24.0 5.0)
  (paper/caption 60.0 60.0 520.0 60.0 32.0 0x384730 1 c"Live Coil. Real Paper.")
  (paper/caption 60.0 132.0 500.0 60.0 17.0 0x687657 0 c"Submit button-pigment without saving. Clicks persist.")
  (paper/button 1 100.0 240.0 440.0 90.0 c"Change my color" false (button-pigment))
  (paper/number 70.0 380.0 22.0 0x384730 (.clicks (state)))
  0)
(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (when (and (= kind 3) (= id 1))
    (set! (.clicks (state)) (+ (.clicks (state)) 1))
    (paper/redraw))
  0)
(defn* launch [] (-> i64) (paper/run draw event))
(export-c [launch :as "lpc_launch"])
