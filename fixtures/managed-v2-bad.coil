(module managed-demo)
(import "live-poc-coil.meta")
(import "coil.primitive" :as p)
(import "live-poc-coil.graph" :as graph)
(import "live-poc-coil.managed-api" :as state)
(import "live-poc-coil.relocation" :as relocation)
(extern test_state_abort :cc c [] (-> i64))
(extern test_state_retire :cc c [] (-> i64))
(defstruct StateV2 [(added i64) (value i64)])
(defn* initialize :jit/retain false [(target (ptr i8)) (prefix (ptr i64))] (-> i64)
  (let [value (p/cast (ptr StateV2) target)] (set! (.value value) 7))
  (store! prefix 1) 0)
(defn* clone :jit/retain false [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr StateV2) target) (load (p/cast (ptr StateV2) old)))
  (store! prefix 1) 0)
(defn* rewrite :jit/retain false [(target (ptr i8)) (journal (ptr relocation/Journal))] (-> i64) 0)
(defn* validate :jit/retain false [(target (ptr i8))] (-> i64) 0)
(defn* abort-value :jit/retain false [(target (ptr i8)) (prefix i64)] (-> void)
  (when (> prefix 0) (test_state_abort)) (do))
(defn* retire-value :jit/retain false [(target (ptr i8))] (-> void)
  (test_state_retire) (do))
(defn* migrate :jit/retain false [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (let [from (p/cast (ptr StateV1) old) to (p/cast (ptr StateV2) target)]
    (set! (.value to) (+ (.value from) 2)) (set! (.added to) 99))
  (store! prefix 1) -77)
(defn* register :jit/retain false :live/stage true [] (-> i64)
  (state/schema! (graph/Schema :logical 77 :version 2 :size (p/sizeof StateV2) :alignment (p/alignof StateV2) :fields 1
    :initialize (p/fnptr-of initialize) :clone (p/fnptr-of clone) :rewrite (p/fnptr-of rewrite)
    :validate (p/fnptr-of validate) :abort (p/fnptr-of abort-value) :retire (p/fnptr-of retire-value)))
  (state/edge! 77 1 2 (p/fnptr-of migrate))
  (state/root! 1 77 2))
(defn read-value [] (-> i64) (.value (state/borrow [StateV2] 1 77 2)))
(defn added-value [] (-> i64) (.added (state/borrow [StateV2] 1 77 2)))
