(module moving-demo)
(import "live-poc-coil.meta")
(import "live-poc-coil.paper-api" :as paper)
(import "live-poc-coil.input-routes" :as routes)
(import "coil.primitive" :as p)
(import "coil.slice" :as slice)
(defstruct State :live/state true
  [(x f64 150.0) (velocity f64 70.0) (last f64 0.0)
   (visible bool true) (clicks i64 0)])
(letonce world (State))
(defstruct Controls :live/state true [(clicks i64 0)])
(letonce controls (Controls))
(defn radius [] (-> f64) 24.0)
(defn button-pigment [] (-> u32) 0xc77855)
(defn visible? [] (-> bool) (.visible world))
(defn draw [] (-> i64)
  (paper/begin 0x343d34)
  (paper/panel 24.0 24.0 592.0 432.0 24.0 5.0)
  (paper/caption 60.0 55.0 520.0 60.0 30.0 0x384730 1 c"Moving state. Live code.")
  (paper/caption 60.0 115.0 520.0 50.0 17.0 0x687657 0 c"Edit radius or State. Position and clicks persist.")
  (when (visible?)
    (let [r (radius)]
      (paper/panel (- (.x world) r) (- 220.0 r) (* r 2.0) (* r 2.0) r 8.0)))
  (paper/button 1 60.0 300.0 250.0 70.0 c"Count a click" false (button-pigment))
  (paper/button 2 330.0 300.0 250.0 70.0 c"Independent control" false 0x8b9e70)
  (paper/number 350.0 395.0 22.0 0x384730 (.clicks controls))
  (paper/number 70.0 395.0 22.0 0x384730 (.clicks world))
  0)
(defn tick [(now f64)] (-> i64)
  (when (> (.last world) 0.0)
    (set! (.x world) (+ (.x world) (* (.velocity world) (- now (.last world)))))
    (when (> (.x world) 530.0)
      (set! (.x world) (- 1060.0 (.x world)))
      (set! (.velocity world) (- 0.0 (.velocity world))))
    (when (< (.x world) 110.0)
      (set! (.x world) (- 220.0 (.x world)))
      (set! (.velocity world) (- 0.0 (.velocity world)))))
  (set! (.last world) now)
  (paper/redraw)
  0)
(defn motion-event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (tick x))
(defn scene-click [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (set! (.clicks world) (+ (.clicks world) 1))
  (paper/redraw)
  0)
(defn control-click [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (set! (.clicks controls) (+ (.clicks controls) 1))
  (paper/redraw)
  0)
(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64) 0)
(defn* launch [] (-> i64)
  (paper/tick-interval 0.016666667)
  (let [storage (p/alloc-stack (array routes/Route 3)) data (p/cast (ptr routes/Route) storage)]
    (store! (p/index data 0) (routes/Route :kind 6 :id -1 :domain 1 :handler motion-event))
    (store! (p/index data 1) (routes/Route :kind 3 :id 1 :domain 1 :handler scene-click))
    (store! (p/index data 2) (routes/Route :kind 3 :id 2 :domain 2 :handler control-click))
    (paper/run-routed draw event (slice/slice-new data 3))))
(export-c [launch :as "lpc_launch"])
