(module live-demo)
(import "live-poc-coil.meta")
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "paper.flow" :use *)
(import "paper.platform" :as host)
(import "paper.gpu" :as gpu)
(import "paper.objc" :use *)
(import "paper.ffi" :use *)

(extern lpc_begin :cc c [] (-> i64))
(extern lpc_end :cc c [] (-> i64))
(extern lpc_frame_pending :cc c [i64] (-> bool))
(extern lpc_revision :cc c [] (-> i64))
(extern lpc_presented :cc c [i64 f64] (-> i64))
(extern lpc_stopping :cc c [] (-> i64))
(extern pthread_main_np :cc c [] (-> i32))
(extern fflush :cc c [(ptr i8)] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern usleep :cc c [u32] (-> i32))

(defstruct AppState [(clicks i64) (served i64) (drawing i64)])
(defn* app-state [] (-> (ptr AppState)) (p/alloc-static AppState))

(defn button-pigment [] (-> u32) 0xc77855)
(defn draw [] (-> i64)
  (host/paper_begin 0x343d34)
  (let [bounds (rect 24.0 24.0 592.0 432.0)]
    (panel bounds 24.0 5.0 (cream))
    (caption (rect 60.0 60.0 520.0 60.0) 32.0 0x384730 1 c"Live Coil. Real Paper.")
    (caption (rect 60.0 132.0 500.0 60.0) 17.0 0x687657 0 c"Submit button-pigment without saving. Clicks persist.")
    (button 1 (rect 100.0 240.0 440.0 90.0) c"Change my color" false (cotton (button-pigment)))
    (host/number 70.0 380.0 22.0 0x384730 (.clicks (app-state))))
  0)
(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (when (and (= kind 3) (= id 1))
    (set! (.clicks (app-state)) (+ (.clicks (app-state)) 1))
    (host/paper_redraw))
  0)

(defn* draw-trampoline [] (-> i64)
  (assert (= (pthread_main_np) 1))
  (let [revision (lpc_begin)]
    (assert (>= revision 0))
    (set! (.drawing (app-state)) revision)
    (draw)
    (lpc_end)))
(defn* event-trampoline [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (assert (= (pthread_main_np) 1))
  (let [revision (lpc_begin)]
    (assert (>= revision 0))
    (event kind id x y)
    (lpc_end)))

(defstruct FrameSample [(revision i64) (busy bool) (done i64) (command (ptr i8)) (drawable (ptr i8))])
(defstruct FramePool [(samples (array FrameSample 64))])
(defn* frames [] (-> (ptr FramePool)) (p/alloc-static FramePool))
(defstruct PresentationDescriptor [(reserved u64) (size u64) (signature (ptr i8))])
(defstruct PresentationBlock
  [(isa (ptr i8)) (flags i32) (reserved i32)
   (invoke (fnptr c [(ptr PresentationBlock) (ptr i8)] void))
   (descriptor (ptr PresentationDescriptor)) (sample (ptr FrameSample))])
(defn* presented [(closure (ptr PresentationBlock)) (drawable (ptr i8))] (-> void)
  (let [sample (.sample closure)]
    (printf c"callback revision=%lld time=%f\n" (.revision sample) (msg f64 drawable (sel c"presentedTime") []))
    (lpc_presented (.revision sample) (msg f64 drawable (sel c"presentedTime") []))
    (fflush (nil))
    (atomic/atomic-store (field sample done) 1)))
(defn* collect-frames [] (-> i64)
  (let [(mut busy) 0]
    (for [i 0 64]
      (let [s (index (field (frames) samples) i)]
        (when (.busy s)
          (if (and (= (atomic/atomic-load (field s done)) 1)
                   (= (msg i64 (.command s) (sel c"status") []) 4))
            (do (release (.drawable s)) (set! (.drawable s) (nil)) (release (.command s)) (set! (.command s) (nil)) (set! (.busy s) false) 0)
            (set! busy (+ (load busy) 1))))))
    (load busy)))
(defn* present-frame [(layer (ptr i8))] (-> bool)
  (assert (= (pthread_main_np) 1))
  (collect-frames)
  (let [(mut free-slot) -1]
    (for [i 0 64]
      (when (and (< (load free-slot) 0) (not (.busy (index (field (frames) samples) i))))
        (set! free-slot i)))
    (if (< (load free-slot) 0) false
      (let [sample (index (field (frames) samples) (load free-slot))
            descriptor (p/alloc-static PresentationDescriptor)
            closure (p/alloc-stack PresentationBlock)]
        (set! (.revision sample) (.drawing (app-state)))
        (printf c"frame revision=%lld clicks=%lld\n" (.revision sample) (.clicks (app-state)))
        (printf c"target=%f now=%f visible=%lld\n" (.presentation-time (gpu/gpu)) (CACurrentMediaTime) (msg i64 (.window (host/host)) (sel c"occlusionState") []))
        (fflush (nil))
        (set! (.busy sample) true)
        (atomic/atomic-store (field sample done) 0)
        (set! (.size descriptor) (cast u64 (sizeof PresentationBlock)))
        (set! (.signature descriptor) c"v16@?0@8")
        (store! closure
          (PresentationBlock :isa (dlsym (cast (ptr i8) -2) c"_NSConcreteStackBlock")
            :flags 0x40000000 :reserved 0 :invoke (fnptr-of presented)
            :descriptor descriptor :sample sample))
        (assert (!= (.isa closure) (nil)))
        (if (gpu/present-with-handler layer (cast (ptr i8) closure))
          (do (set! (.drawable sample) (retain (.last-drawable (gpu/gpu))))
              (set! (.command sample) (retain (.last-command (gpu/gpu))))
              true)
          (do (set! (.busy sample) false) false))))))
(defn* before-frame [] (-> bool)
  (assert (= (pthread_main_np) 1))
  (collect-frames)
  (when (= (lpc_stopping) 1)
    (msg i64 (.window (host/host)) (sel c"close") []))
  (let [revision (lpc_revision)]
    (when (or (> revision (.served (app-state))) (lpc_frame_pending revision))
      (set! (.served (app-state)) revision)
      (host/paper_redraw)))
  true)
(defn* launch [] (-> i64)
  (assert (= (pthread_main_np) 1))
  (host/paper_configure c"Live Coil — Paper latency proof" 640.0 480.0)
  (host/paper_frame_integration (fnptr-of before-frame) (fnptr-of present-frame))
  (host/paper_run (fnptr-of draw-trampoline) (fnptr-of event-trampoline))
  (host/paper_clear_frame_integration)
  (gpu/synchronize)
  (let [deadline (+ (CACurrentMediaTime) 5.0)]
    (loop (if (= (collect-frames) 0) (break)
      (do
        (assert (< (CACurrentMediaTime) deadline))
        (let [pool (new c"NSAutoreleasePool")]
          (msg bool (msg (ptr i8) (class c"NSRunLoop") (sel c"mainRunLoop") [])
            (sel c"runMode:beforeDate:") [(ptr i8) (ptr i8)]
            (constant-object c"NSDefaultRunLoopMode")
            (msg (ptr i8) (class c"NSDate") (sel c"dateWithTimeIntervalSinceNow:") [f64] 0.001))
          (release pool))
        0))))
  0)
(export-c [launch :as "lpc_launch"])
