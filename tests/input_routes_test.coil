(module live-poc-coil.input-routes-test)
(import "coil.primitive" :as p)
(import "coil.slice" :as slice)
(import "live-poc-coil.function" :as function)
(import "live-poc-coil.input-routes" :as routes)
(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64) 0)
(defn route [(kind i64) (id i64) (domain i64)] (-> routes/Route)
  (routes/Route :kind kind :id id :domain domain
    :handler (function/Function :gate (p/fnptr-of event) :id 1)))
(deftest input-routes-validate-and-prefer-exact-identities
  (let [storage (p/alloc-stack (array routes/Route 3))
        data (p/cast (ptr routes/Route) storage) table (slice/slice-new data 3)]
    (store! (p/index data 0) (route 3 -1 1))
    (store! (p/index data 1) (route 3 7 2))
    (store! (p/index data 2) (route 6 -1 3))
    (assert (not (routes/valid? (slice/slice-new data -1))))
    (assert (not (routes/valid? (slice/slice-new data 65))))
    (assert (not (routes/valid? (slice/slice-new (p/cast (ptr routes/Route) 0) 1))))
    (assert (routes/valid? table))
    (assert (= (routes/select table 3 7) 1))
    (assert (= (routes/select table 3 8) 0))
    (assert (= (routes/select table 6 0) 2))
    (assert (= (routes/select table 9 0) -1))
    (store! (p/index data 2) (route 3 7 3))
    (assert (not (routes/valid? table)))
    (store! (p/index data 2) (route 6 -1 0))
    (assert (not (routes/valid? table)))
    (store! (p/index data 2) (route 6 -1 3))
    (let [handler (field (p/index data 2) handler)]
      (set! (.gate handler) (p/cast (fnptr c [i64 i64 f64 f64] i64) (p/cast (ptr i8) 0))))
    (assert (not (routes/valid? table)))))
