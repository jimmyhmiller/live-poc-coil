(module live-poc-coil.control-test)
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "coil.thread" :as thread)
(import "live-poc-coil.control" :as control)
(defn unrelated [(flag (ptr i8))] (-> (ptr i8))
  (assert (= (control/cancelled-native) 0))
  (assert (= (control/bind! (p/cast (ptr i64) flag)) 0))
  (assert (= (control/cancelled-native) 1))
  (assert (= (control/unbind!) 0))
  (assert (= (control/cancelled-native) 0))
  (p/cast (ptr i8) 0))
(deftest cancellation-is-local-to-the-bound-evaluation-thread
  (let [flag (p/alloc-stack i64) worker (p/alloc-stack thread/Thread)]
    (atomic/atomic-store flag 1)
    (assert (= (control/init!) 0))
    (assert (= (control/bind! flag) 0))
    (assert (= (control/cancelled-native) 1))
    (assert (= (thread/thread-spawn-configured worker (p/fnptr-of unrelated) (p/cast (ptr i8) flag)
      (thread/thread-config 1048576 16384)) 0))
    (assert (= (thread/thread-join worker) 0))
    (assert (= (control/cancelled-native) 1))
    (assert (= (control/unbind!) 0))
    (assert (= (control/cancelled-native) 0))
    (assert (= (control/destroy!) 0))))
