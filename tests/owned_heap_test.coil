(module live-poc-coil.owned-heap-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "live-poc-coil.owned-heap" :as heap)
(defstruct Parent [(remaining i64) (blocks i64) (bytes i64)])
(impl a/Allocator Parent
  (allocate [(self (ptr Parent)) (request (ref a/AllocRequest))] (-> (Option (ptr i8)))
    (if (= (.remaining self) 0) (None)
      (match (a/malloc-allocate request)
        (None [] (None))
        (Some [memory]
          (when (> (.remaining self) 0) (set! (.remaining self) (- (.remaining self) 1)))
          (set! (.blocks self) (+ (.blocks self) 1))
          (set! (.bytes self) (+ (.bytes self) (.bytes request)))
          (Some memory)))))
  (resize [(self (ptr Parent)) (memory (ptr i8)) (old (ref a/AllocRequest)) (next (ref a/AllocRequest))] (-> bool) false)
  (remap [(self (ptr Parent)) (memory (ptr i8)) (old (ref a/AllocRequest)) (next (ref a/AllocRequest))] (-> (Option (ptr i8))) (None))
  (deallocate [(self (ptr Parent)) (memory (ptr i8)) (request (ref a/AllocRequest))] (-> i64)
    (set! (.blocks self) (- (.blocks self) 1))
    (set! (.bytes self) (- (.bytes self) (.bytes request)))
    (p/free memory)))
(defn request [(size i64) (align i64)] (-> a/AllocRequest)
  (a/AllocRequest :type-id 0 :count size :bytes size :align align))
(defn need [(allocator (dyn a/Allocator)) (size i64) (align i64)] (-> (ptr i8))
  (match (a/raw-alloc allocator (request size align))
    (Some [memory] memory) (None [] (assert false) (p/cast (ptr i8) 0))))
(deftest owned-heap-reclaims-out-of-order-and-closes-survivors
  (let [parent (p/alloc-stack Parent) state (p/alloc-stack heap/Heap)]
    (store! parent (Parent :remaining -1 :blocks 0 :bytes 0))
    (heap/init! state (p/make-dyn a/Allocator parent))
    (let [allocator (heap/allocator state) first (need allocator 17 1)
          middle (need allocator 33 4096) last (need allocator 65 8)]
      (assert (= (% (p/cast i64 middle) 4096) 0))
      (store! first (p/cast i8 42)) (store! (p/index last 64) (p/cast i8 19))
      (assert (= (.blocks parent) 3))
      (a/raw-free allocator middle (request 33 4096))
      (assert (= (.blocks parent) 2))
      (a/raw-free allocator first (request 17 1))
      (assert (= (.blocks parent) 1))
      (assert (= (load (p/index last 64)) (p/cast i8 19)))
      (heap/close! state) (heap/close! state)
      (assert (= (.blocks parent) 0)) (assert (= (.bytes parent) 0))
      (assert (match (a/raw-alloc allocator (request 8 8)) (None [] true) (_ false))))))
(deftest owned-heap-failed-allocation-and-overflow-preserve-live-storage
  (let [parent (p/alloc-stack Parent) state (p/alloc-stack heap/Heap)]
    (store! parent (Parent :remaining 1 :blocks 0 :bytes 0))
    (heap/init! state (p/make-dyn a/Allocator parent))
    (let [allocator (heap/allocator state) memory (need allocator 8 8) bytes (.live-bytes state)]
      (store! (p/cast (ptr i64) memory) 42)
      (assert (match (a/raw-alloc allocator (request 8 8)) (None [] true) (_ false)))
      (assert (match (a/raw-alloc allocator (request 9223372036854775807 8)) (None [] true) (_ false)))
      (assert (= (.live-bytes state) bytes))
      (assert (= (.blocks parent) 1))
      (assert (= (load (p/cast (ptr i64) memory)) 42))
      (heap/close! state) (assert (= (.blocks parent) 0)))))
(deftest owned-heap-supports-container-growth-with-immediate-reclamation
  (let [parent (p/alloc-stack Parent) state (p/alloc-stack heap/Heap)]
    (store! parent (Parent :remaining -1 :blocks 0 :bytes 0))
    (heap/init! state (p/make-dyn a/Allocator parent))
    (let [(mut values) (al/al-new [i64] (heap/allocator state))]
      (for [i 0 1000] (al/al-push! (mut values) i) (assert (= (.blocks parent) 1)))
      (for [i 0 1000] (assert (= (al/al-get (load values) i) i)))
      (al/al-free! (mut values))
      (assert (= (.blocks parent) 0)) (assert (= (.bytes parent) 0)))
    (heap/close! state)))
