(module live-poc-coil.pending-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "live-poc-coil.runtime" :as rt)
(import "live-poc-coil.pending" :as pending)
(defstruct Counts [(ran i64) (dropped i64) (order i64)])
(defstruct Payload [(value i64) (counts (ptr Counts))])
(defn run [(raw (ptr i8))] (-> i64)
  (let [payload (p/cast (ptr Payload) raw) counts (.counts payload)]
    (set! (.ran counts) (+ (.ran counts) 1))
    (set! (.order counts) (+ (* (.order counts) 10) (.value payload))))
  0)
(defn drop [(raw (ptr i8))] (-> i64)
  (let [payload (p/cast (ptr Payload) raw)]
    (set! (.dropped (.counts payload)) (+ (.dropped (.counts payload)) 1))
    (rt/free-one! payload)))
(defn payload [(counts (ptr Counts)) (value i64)] (-> (ptr i8))
  (p/cast (ptr i8) (a/box! (a/malloc-allocator) Payload (Payload :counts counts :value value))))
(defn target [] (-> i64) 42)
(deftest pending-owns-ordered-input-through-repair-and-cancel
  (let [runtime (p/alloc-stack rt/Runtime) queue (p/alloc-stack pending/Queue)
        counts (p/alloc-stack Counts)]
    (store! counts (p/zeroed Counts))
    (rt/init! runtime) (pending/init! queue 2)
    (let [view (rt/clone-current! runtime)]
      (rt/block! view 0 1)
      (rt/stage! view 1 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime view))
    (assert (= (pending/enqueue! queue 0 (payload counts 1) (p/fnptr-of run) (p/fnptr-of drop)) 1))
    (assert (= (pending/enqueue! queue 1 (payload counts 2) (p/fnptr-of run) (p/fnptr-of drop)) 2))
    (assert (= (pending/pump-one! queue runtime) 0))
    (assert (= (.ran counts) 0))
    (let [rejected (payload counts 3)]
      (assert (= (pending/enqueue! queue 1 rejected (p/fnptr-of run) (p/fnptr-of drop)) -2))
      (assert (= (.dropped counts) 0))
      (drop rejected))
    (let [view (rt/clone-current! runtime)]
      (rt/stage! view 0 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime view))
    (assert (= (pending/pump-one! queue runtime) 1))
    (assert (= (pending/pump-one! queue runtime) 2))
    (assert (= (.order counts) 12))
    (assert (= (.dropped counts) 3))
    (assert (= (pending/enqueue! queue 0 (payload counts 4) (p/fnptr-of run) (p/fnptr-of drop)) 3))
    (assert (= (pending/cancel! queue 3) 0))
    (assert (= (pending/cancel! queue 3) -1))
    (assert (= (.dropped counts) 4))
    (assert (= (pending/enqueue! queue 0 (payload counts 5) (p/fnptr-of run) (p/fnptr-of drop)) 4))
    (assert (= (pending/close! queue) 0))
    (assert (= (.dropped counts) 5))
    (assert (= (.ran counts) 2))
    (assert (= (.cancelled queue) 2))
    (pending/destroy! queue)
    (assert (rt/close! runtime))
    (rt/collect-views! runtime) (rt/destroy! runtime)))

(deftest coalescing-does-not-cross-intervening-input
  (let [runtime (p/alloc-stack rt/Runtime) queue (p/alloc-stack pending/Queue)
        counts (p/alloc-stack Counts)]
    (store! counts (p/zeroed Counts))
    (rt/init! runtime) (pending/init! queue 3)
    (let [view (rt/clone-current! runtime)]
      (rt/stage! view 0 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime view))
    (assert (= (pending/enqueue-coalescing! queue 6 0 (payload counts 1) (p/fnptr-of run) (p/fnptr-of drop)) 1))
    (assert (= (pending/enqueue-coalescing! queue 6 0 (payload counts 2) (p/fnptr-of run) (p/fnptr-of drop)) 1))
    (assert (= (.dropped counts) 1))
    (assert (= (pending/enqueue! queue 0 (payload counts 3) (p/fnptr-of run) (p/fnptr-of drop)) 2))
    (assert (= (pending/enqueue-coalescing! queue 6 0 (payload counts 4) (p/fnptr-of run) (p/fnptr-of drop)) 3))
    (assert (= (pending/enqueue-coalescing! queue 6 0 (payload counts 5) (p/fnptr-of run) (p/fnptr-of drop)) 3))
    (assert (= (.dropped counts) 2))
    (assert (= (.coalesced queue) 2))
    (assert (= (pending/pump-one! queue runtime) 1))
    (assert (= (pending/pump-one! queue runtime) 2))
    (assert (= (pending/pump-one! queue runtime) 3))
    (assert (= (.order counts) 235))
    (assert (= (.dropped counts) 5))
    (assert (= (pending/cancel! queue 0) -1))
    (pending/close! queue) (pending/destroy! queue)
    (assert (rt/close! runtime)) (rt/collect-views! runtime) (rt/destroy! runtime)))

(deftest explicit-input-domains-bypass-blocked-work-without-reordering-peers
  (let [runtime (p/alloc-stack rt/Runtime) queue (p/alloc-stack pending/Queue)
        counts (p/alloc-stack Counts)]
    (store! counts (p/zeroed Counts))
    (rt/init! runtime) (pending/init! queue 4)
    (let [view (rt/clone-current! runtime)]
      (rt/block! view 0 1)
      (rt/stage! view 1 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime view))
    (assert (= (pending/enqueue-domain! queue 1 0 0 (payload counts 1) (p/fnptr-of run) (p/fnptr-of drop)) 1))
    ; A ready root still waits behind its blocked ordering-domain peer.
    (assert (= (pending/enqueue-domain! queue 1 0 1 (payload counts 2) (p/fnptr-of run) (p/fnptr-of drop)) 2))
    (assert (= (pending/enqueue-domain! queue 2 0 1 (payload counts 3) (p/fnptr-of run) (p/fnptr-of drop)) 3))
    (assert (= (pending/pump-one! queue runtime) 3))
    (assert (= (.order counts) 3)) (assert (= (.dropped counts) 1))
    (assert (= (pending/pump-one! queue runtime) 0))
    (let [view (rt/clone-current! runtime)]
      (rt/stage! view 0 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime view))
    (assert (= (pending/pump-one! queue runtime) 1))
    (assert (= (pending/pump-one! queue runtime) 2))
    (assert (= (.order counts) 312)) (assert (= (.dropped counts) 3))
    ; Identical coalescing keys in separate domains own separate payloads.
    (assert (= (pending/enqueue-domain! queue 1 6 1 (payload counts 4) (p/fnptr-of run) (p/fnptr-of drop)) 4))
    (assert (= (pending/enqueue-domain! queue 2 6 1 (payload counts 5) (p/fnptr-of run) (p/fnptr-of drop)) 5))
    (assert (= (.coalesced queue) 0))
    (assert (= (pending/cancel! queue 4) 0))
    (assert (= (pending/close! queue) 0))
    (assert (= (.dropped counts) 5))
    (pending/destroy! queue)
    (assert (rt/close! runtime)) (rt/collect-views! runtime) (rt/destroy! runtime)))
