(module live-poc-coil.graph-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.slice" :as slice)
(import "live-poc-coil.graph" :as graph)
(import "live-poc-coil.relocation" :as relocation)
(defstruct Node1 [(value i64) (next (ptr i8)) (owned (slice i64)) (view (slice i64))])
(defstruct Node2 [(next (ptr i8)) (added i64) (value i64) (owned (slice i64)) (view (slice i64))])
(defstruct Anchor [(node (ptr i8))])
(defstruct Audit [(aborted i64) (retired i64) (fail-copy bool) (fail-validation bool)])
(defn audit [] (-> (ptr Audit)) (p/alloc-static Audit))
(defn allocate-values [(count i64)] (-> (slice i64))
  (match (a/alloc [i64] (a/malloc-allocator) count)
    (Some [values] values) (None [] (a/oom-at c"test values" 0) (slice/slice-new (p/cast (ptr i64) 0) 0))))
(defn initialize [(target (ptr i8)) (prefix (ptr i64))] (-> i64)
  (let [node (p/cast (ptr Node1) target)]
    (set! (.owned node) (allocate-values 3))
    (store! (slice/slice-data (.owned node)) 17)
    (store! (p/index (slice/slice-data (.owned node)) 1) 18)
    (store! (p/index (slice/slice-data (.owned node)) 2) 19)
    (set! (.view node) (.owned node))
    (store! prefix 1)) 0)
(defn no-initialize [(target (ptr i8)) (prefix (ptr i64))] (-> i64) (store! prefix 1) 0)
(defn copy-owned [(old (slice i64)) (target (ptr (slice i64)))
                 (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! target (allocate-values (slice/slice-len old)))
  (store! prefix 1)
  (for [i 0 (slice/slice-len old)]
    (store! (p/index (slice/slice-data (load target)) i) (slice/slice-get old i)))
  (relocation/range! journal (p/cast (ptr i8) (slice/slice-data old)) (* (slice/slice-len old) 8)
    (p/cast (ptr i8) (slice/slice-data (load target))) (* (slice/slice-len old) 8)))
(defn clone1 [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (let [from (p/cast (ptr Node1) old) to (p/cast (ptr Node1) target)]
    (set! (.value to) (.value from)) (set! (.next to) (.next from)) (set! (.view to) (.view from))
    (copy-owned (.owned from) (field to owned) journal prefix)))
(defn clone2 [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (let [from (p/cast (ptr Node2) old) to (p/cast (ptr Node2) target)]
    (set! (.value to) (.value from)) (set! (.next to) (.next from)) (set! (.view to) (.view from))
    (set! (.added to) (.added from))
    (copy-owned (.owned from) (field to owned) journal prefix)))
(defn migrate [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (let [from (p/cast (ptr Node1) old) to (p/cast (ptr Node2) target)]
    (set! (.value to) (.value from)) (set! (.next to) (.next from)) (set! (.view to) (.view from))
    (set! (.added to) 5)
    (let [result (copy-owned (.owned from) (field to owned) journal prefix)]
      (if (and (.fail-copy (audit)) (= (.value from) 2)) -77 result))))
(defn rewrite1 [(value (ptr i8)) (journal (ptr relocation/Journal))] (-> i64)
  (let [node (p/cast (ptr Node1) value) result (relocation/reference! journal (field node next) 7)]
    (if (!= result 0) result
      (relocation/slice! journal (p/cast (ptr (ptr i8)) (field node view)) (slice/slice-len (.view node)) 8))))
(defn rewrite2 [(value (ptr i8)) (journal (ptr relocation/Journal))] (-> i64)
  (let [node (p/cast (ptr Node2) value) result (relocation/reference! journal (field node next) 7)]
    (if (!= result 0) result
      (relocation/slice! journal (p/cast (ptr (ptr i8)) (field node view)) (slice/slice-len (.view node)) 8))))
(defn valid1 [(value (ptr i8))] (-> i64) 0)
(defn valid2 [(value (ptr i8))] (-> i64) (if (.fail-validation (audit)) -99 0))
(defn abort1 [(value (ptr i8)) (prefix i64)] (-> void)
  (when (> prefix 0)
    (let [node (p/cast (ptr Node1) value)] (a/free (a/malloc-allocator) (.owned node)))
    (set! (.aborted (audit)) (+ (.aborted (audit)) 1)))
  (do))
(defn abort2 [(value (ptr i8)) (prefix i64)] (-> void)
  (when (> prefix 0)
    (let [node (p/cast (ptr Node2) value)] (a/free (a/malloc-allocator) (.owned node)))
    (set! (.aborted (audit)) (+ (.aborted (audit)) 1)))
  (do))
(defn retire1 [(value (ptr i8))] (-> void)
  (let [node (p/cast (ptr Node1) value)] (a/free (a/malloc-allocator) (.owned node)))
  (set! (.retired (audit)) (+ (.retired (audit)) 1)) (do))
(defn retire2 [(value (ptr i8))] (-> void)
  (let [node (p/cast (ptr Node2) value)] (a/free (a/malloc-allocator) (.owned node)))
  (set! (.retired (audit)) (+ (.retired (audit)) 1)) (do))
(defn anchor-clone [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr Anchor) target) (load (p/cast (ptr Anchor) old))) (store! prefix 1) 0)
(defn anchor-rewrite [(value (ptr i8)) (journal (ptr relocation/Journal))] (-> i64)
  (relocation/reference! journal (p/cast (ptr (ptr i8)) value) 7))
(defn no-abort [(value (ptr i8)) (prefix i64)] (-> void) (do))
(defn no-retire [(value (ptr i8))] (-> void) (do))
(defn schema1 [] (-> graph/Schema)
  (graph/Schema :logical 7 :version 1 :size (p/sizeof Node1) :alignment (p/alignof Node1) :fields 1
    :initialize (p/fnptr-of initialize) :clone (p/fnptr-of clone1) :rewrite (p/fnptr-of rewrite1)
    :validate (p/fnptr-of valid1) :abort (p/fnptr-of abort1) :retire (p/fnptr-of retire1)))
(defn schema2 [] (-> graph/Schema)
  (graph/Schema :logical 7 :version 2 :size (p/sizeof Node2) :alignment (p/alignof Node2) :fields 1
    :initialize (p/fnptr-of no-initialize) :clone (p/fnptr-of clone2) :rewrite (p/fnptr-of rewrite2)
    :validate (p/fnptr-of valid2) :abort (p/fnptr-of abort2) :retire (p/fnptr-of retire2)))
(defn anchor-schema [] (-> graph/Schema)
  (graph/Schema :logical 8 :version 1 :size (p/sizeof Anchor) :alignment (p/alignof Anchor) :fields 1
    :initialize (p/fnptr-of no-initialize) :clone (p/fnptr-of anchor-clone) :rewrite (p/fnptr-of anchor-rewrite)
    :validate (p/fnptr-of valid1) :abort (p/fnptr-of no-abort) :retire (p/fnptr-of no-retire)))
(deftest graph-migration-preserves-cycles-incoming-aliases-and-owned-interior-ranges
  (store! (audit) (p/zeroed Audit))
  (let [heap (p/alloc-stack graph/Heap) targets (p/alloc-stack (array (ptr graph/Schema) 1))]
    (graph/init! heap (a/malloc-allocator))
    (let [v1 (graph/register! heap (schema1)) v2 (graph/register! heap (schema2))
          anchor-type (graph/register! heap (anchor-schema))
          first (graph/root! heap 1 v1) second (graph/root! heap 2 v1) anchor (graph/root! heap 3 anchor-type)
          one (p/cast (ptr Node1) (graph/payload (.memory first)))
          two (p/cast (ptr Node1) (graph/payload (.memory second)))
          original-anchor (p/cast (ptr Anchor) (graph/payload (.memory anchor)))]
      (set! (.value one) 1) (set! (.value two) 2)
      (assert (= (graph/root! heap 1 v2) first))
      (assert (= (.value one) 1))
      (assert (= (graph/attach-root! heap 9 first) 0))
      (assert (= (graph/attach-root! heap 9 second) -1))
      (assert (= (p/cast i64 (graph/root! heap 1 anchor-type)) 0))
      (set! (.next one) (p/cast (ptr i8) two)) (set! (.next two) (p/cast (ptr i8) one))
      (set! (.view one) (slice/subslice (.owned two) 1 3))
      (set! (.node original-anchor) (p/cast (ptr i8) one))
      (store! (p/index targets 0) v2)
      (let [destination (slice/slice-new (p/cast (ptr (ptr graph/Schema)) targets) 1)
            cancel (p/cast (ptr i64) 0)]
        (assert (= (graph/prepare! heap destination cancel) -3))
        (assert (= (.missing-from heap) 1)) (assert (= (.missing-to heap) 2))
        (assert (= (.schema first) v1))
        (assert (= (graph/edge! heap (graph/Edge :from v1 :to v2 :prepare (p/fnptr-of migrate))) 0))
        (set! (.fail-copy (audit)) true)
        (assert (= (graph/prepare! heap destination cancel) -77))
        (assert (= (.aborted (audit)) 2)) (assert (= (.retired (audit)) 0))
        (assert (= (graph/payload (.memory first)) (p/cast (ptr i8) one)))
        (assert (= (slice/slice-get (.view one) 0) 18))
        (set! (.fail-copy (audit)) false) (set! (.fail-validation (audit)) true)
        (assert (= (graph/prepare! heap destination cancel) -99))
        (assert (= (.aborted (audit)) 4)) (assert (= (.retired (audit)) 0))
        (assert (= (.node original-anchor) (p/cast (ptr i8) one)))
        (set! (.fail-validation (audit)) false)
        (assert (= (graph/prepare! heap destination cancel) 0))
        (assert (= (.schema first) v1)) (assert (= (.epoch heap) 0))
        (graph/publish! heap)
        (assert (= (.retired (audit)) 0))
        (assert (= (graph/root heap 1) first))
        (assert (= (graph/root heap 9) first))
        (assert (= (.schema (graph/root heap 1)) v2))
        (let [next-one (p/cast (ptr Node2) (graph/payload (.memory first)))
              next-two (p/cast (ptr Node2) (graph/payload (.memory second)))
              next-anchor (p/cast (ptr Anchor) (graph/payload (.memory anchor)))]
          (assert (= (.value next-one) 1)) (assert (= (.value next-two) 2))
          (assert (= (.added next-one) 5))
          (assert (= (.next next-one) (p/cast (ptr i8) next-two)))
          (assert (= (.next next-two) (p/cast (ptr i8) next-one)))
          (assert (= (.node next-anchor) (p/cast (ptr i8) next-one)))
          (assert (= (slice/slice-data (.view next-one)) (p/index (slice/slice-data (.owned next-two)) 1)))
          (assert (= (slice/slice-get (.view next-one) 0) 18))
          (assert (!= (slice/slice-data (.owned next-one)) (slice/slice-data (.owned one)))))
        (graph/retire! heap)
        (assert (= (.retired (audit)) 2)) (assert (= (.epoch heap) 1))))
    (graph/destroy! heap)
    (assert (= (.retired (audit)) 4))))

(defstruct FaultAllocator [(remaining i64) (live i64)])
(impl a/Allocator FaultAllocator
  (allocate [(self (ptr FaultAllocator)) (request (ref a/AllocRequest))] (-> (Option (ptr i8)))
    (if (= (.remaining self) 0) (None)
      (do
        (when (> (.remaining self) 0) (set! (.remaining self) (- (.remaining self) 1)))
        (match (a/malloc-allocate request)
          (None [] (None))
          (Some [memory] (set! (.live self) (+ (.live self) 1)) (Some memory))))))
  (resize [(self (ptr FaultAllocator)) (memory (ptr i8)) (old (ref a/AllocRequest)) (next (ref a/AllocRequest))] (-> bool) false)
  (remap [(self (ptr FaultAllocator)) (memory (ptr i8)) (old (ref a/AllocRequest)) (next (ref a/AllocRequest))] (-> (Option (ptr i8))) (None))
  (deallocate [(self (ptr FaultAllocator)) (memory (ptr i8)) (request (ref a/AllocRequest))] (-> i64)
    (when (!= (p/cast i64 memory) 0) (set! (.live self) (- (.live self) 1)))
    (p/free memory)))
(deftest graph-allocation-failure-and-cancellation-preserve-accepted-ownership
  (for [budget 0 10]
    (store! (audit) (p/zeroed Audit))
    (let [allocator (p/alloc-stack FaultAllocator) heap (p/alloc-stack graph/Heap)
          target (p/alloc-stack (ptr graph/Schema)) cancel (p/alloc-stack i64)]
      (store! allocator (FaultAllocator :remaining -1 :live 0))
      (graph/init! heap (p/make-dyn a/Allocator allocator))
      (let [v1 (graph/register! heap (schema1)) v2 (graph/register! heap (schema2))
            handle (graph/new! heap v1) old (graph/payload (.memory handle))]
        (assert (= (graph/edge! heap (graph/Edge :from v1 :to v2 :prepare (p/fnptr-of migrate))) 0))
        (store! target v2) (store! cancel 0)
        (set! (.remaining allocator) budget)
        (let [status (graph/prepare! heap (slice/slice-new target 1) cancel)]
          (assert (or (= status -4) (= status 0)))
          (when (= status 0) (graph/abort! heap)))
        (assert (= (graph/payload (.memory handle)) old))
        (assert (= (.schema handle) v1)) (assert (= (.epoch heap) 0))
        (assert (= (.retired (audit)) 0))
        (set! (.remaining allocator) -1)
        (store! cancel 1)
        (assert (= (graph/prepare! heap (slice/slice-new target 1) cancel) 3))
        (assert (= (graph/payload (.memory handle)) old))
        (graph/destroy! heap)
        (assert (= (.retired (audit)) 1))
        (assert (= (.live allocator) 0))))))

(deftest rejected-schema-registration-drops-private-roots-before-unloading-adapters
  (store! (audit) (p/zeroed Audit))
  (let [heap (p/alloc-stack graph/Heap)]
    (graph/init! heap (a/malloc-allocator))
    (let [v1 (graph/register! heap (schema1)) accepted (graph/root! heap 1 v1)
          point (graph/savepoint heap)]
      (let [v2 (graph/register! heap (schema2))]
        (assert (= (graph/edge! heap (graph/Edge :from v1 :to v2 :prepare (p/fnptr-of migrate))) 0))
        (assert (!= (p/cast i64 (graph/root! heap 2 v1)) 0))
        (graph/rollback! heap point))
      (assert (= (.aborted (audit)) 1)) (assert (= (.retired (audit)) 0))
      (assert (= (graph/root heap 1) accepted))
      (assert (= (p/cast i64 (graph/root heap 2)) 0))
      (assert (= (.len (field heap schemas)) 1))
      (assert (= (.len (field heap edges)) 0))
      (assert (!= (p/cast i64 (graph/register! heap (schema2))) 0)))
    (graph/destroy! heap)
    (assert (= (.retired (audit)) 1))))
