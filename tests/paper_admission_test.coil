(module live-poc-coil.paper-admission-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "paper.platform" :as paper)
(import "paper.scene" :as scene)
(defn calls [] (-> (ptr i64)) (p/alloc-static i64))
(defn denied [] (-> bool) (set! (calls) (+ (load (calls)) 1)) false)
(defn unexpected-leave [] (-> i64) (assert false) 0)
(deftest denied-draw-preserves-controls-and-scene
  (let [host (paper/host) input (p/alloc-stack paper/Input)]
    (store! input (p/zeroed paper/Input))
    (set! (.live input) true)
    (set! (.inputs host) (al/al-new [paper/Input] (a/malloc-allocator)))
    (al/al-push! (field host inputs) (load input))
    (set! (.focus host) 17)
    (set! (.dirty (scene/scene)) true)
    (store! (calls) 0)
    (paper/paper_draw_admission (p/fnptr-of denied) (p/fnptr-of unexpected-leave))
    (assert (= (paper/refresh) 0))
    (assert (= (load (calls)) 1))
    (assert (= (.focus host) 17))
    (assert (.dirty (scene/scene)))
    (let [current (al/al-get (.inputs host) 0)] (assert (.live current)))
    (paper/paper_clear_draw_admission)
    (al/al-free! (field host inputs))))
