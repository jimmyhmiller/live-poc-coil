(module live-poc-coil.repair-test)
(import "coil.primitive" :as p)
(import "coil.arraylist" :as al)
(import "live-poc-coil.session" :as s)
(import "live-poc-coil.runtime" :as rt)
(import "live-poc-coil.source" :as source)
(defn root [(id i64)] (-> (ptr rt/View)) (rt/enter-root! (field (s/instance) runtime) id))
(defn value [(id i64)] (-> i64)
  (p/call-ptr (p/cast (fnptr c [] i64) (s/address id))))
(deftest rejected-body-blocks-and-one-form-repair-revives
  (assert (= (s/init!) 0))
  (assert (= (s/submit! "(module demo) (import \"live-poc-coil.meta\") (defn f [] (-> i64) 1) (defn g [] (-> i64) (+ (f) 1)) (defn unrelated [] (-> i64) 9)") 0))
  (let [old (root 1)]
    (assert (!= (p/cast i64 old) 0))
    (assert (= (s/submit-deferred! "(module demo) (defn f [] (-> i64) true)") 2))
    (assert (= (value 1) 2))
    (s/leave!))
  (assert (= (s/current-revision) 2))
  (assert (= (p/cast i64 (root 1)) 0))
  (assert (!= (s/diagnostic) ""))
  (assert (!= (p/cast i64 (root 2)) 0))
  (assert (= (value 2) 9)) (s/leave!)
  (let [ledger (field (s/instance) sources)
        form (al/al-get (.forms ledger) (source/find ledger "demo" "defn" "f"))]
    (assert (= (.accepted form) "(defn f [] (-> i64) 1)"))
    (assert (= (.desired form) "(defn f [] (-> i64) true)"))
    (assert (> (.condition form) 0)))
  (assert (= (s/submit! "(module demo) (defn f [] (-> i64) 41)") 0))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 42)) (s/leave!)
  (assert (= (s/close!) 0)))
(deftest new-blocked-function-has-checked-header
  (assert (= (s/init!) 0))
  (assert (= (s/submit-deferred! "(module demo) (import \"live-poc-coil.meta\") (defn f [] (-> i64) true) (defn g [] (-> i64) (+ (f) 1))") 2))
  (assert (= (p/cast i64 (root 0)) 0))
  (assert (= (p/cast i64 (root 1)) 0))
  (assert (= (s/submit! "(module demo) (defn f [] (-> i64) 5)") 0))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 6)) (s/leave!)
  (assert (!= (s/submit-deferred! "(module demo) (defn f [] (-> bool) 123)") 0))
  (assert (= (s/current-revision) 2))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 6)) (s/leave!)
  (assert (= (s/close!) 0)))

(deftest blocked-aggregate-abi-and-batch-source-outcomes
  (assert (= (s/init!) 0))
  (assert (= (s/submit-deferred! "(module demo) (import \"live-poc-coil.meta\") (defstruct Point [(x i64) (y i64)]) (defn point [] (-> Point) true) (defn read-point [] (-> i64) (let [value (point)] (.x value))) (defn ready [] (-> i64) 17)") 2))
  (assert (= (p/cast i64 (root 1)) 0))
  (assert (!= (p/cast i64 (root 2)) 0))
  (assert (= (value 2) 17)) (s/leave!)
  (let [ledger (field (s/instance) sources)
        ready (al/al-get (.forms ledger) (source/find ledger "demo" "defn" "ready"))
        blocked (al/al-get (.forms ledger) (source/find ledger "demo" "defn" "point"))]
    (assert (= (.accepted ready) "(defn ready [] (-> i64) 17)"))
    (assert (= (.accepted blocked) "")))
  (assert (= (s/submit! "(module demo) (defn point [] (-> Point) (Point :x 42 :y 7))") 0))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 42)) (s/leave!)
  (assert (= (s/close!) 0)))

(deftest blocked-void-pointer-abi
  (assert (= (s/init!) 0))
  (assert (= (s/submit-deferred! "(module demo) (import \"live-poc-coil.meta\") (import \"coil.primitive\" :as p) (defn write-value [(target (ptr i64))] (-> void) (p/store! target true)) (defn read-value [] (-> i64) (let [target (p/alloc-stack i64)] (write-value target) (load target)))") 2))
  (assert (= (p/cast i64 (root 1)) 0))
  (assert (= (s/submit! "(module demo) (defn write-value [(target (ptr i64))] (-> void) (p/store! target 42))") 0))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 42)) (s/leave!)
  (assert (= (s/close!) 0)))

(deftest deferred-batch-with-expression-has-no-effects
  (assert (= (s/init!) 0))
  (assert (= (s/submit! "(module demo) (import \"live-poc-coil.meta\") (import \"coil.primitive\" :as p) (defn* state [] (-> (ptr i64)) (p/alloc-static i64)) (defn f [] (-> i64) 1)") 0))
  (assert (!= (s/submit-deferred! "(module demo) (defn f [] (-> i64) true) (set! (state) 99)") 0))
  (assert (= (s/current-revision) 1))
  (assert (= (s/submit! "(module demo) (load (state))") 0))
  (assert (= (.result (s/instance)) "0"))
  (assert (= (s/close!) 0)))

(deftest static-helper-cannot-hide-a-blocked-call
  (assert (= (s/init!) 0))
  (assert (= (s/submit! "(module demo) (import \"live-poc-coil.meta\") (defn f [] (-> i64) 1) (defn* helper [] (-> i64) (f)) (defn g [] (-> i64) (helper)) (defn unrelated [] (-> i64) 9)") 0))
  (assert (= (s/submit-deferred! "(module demo) (defn f [] (-> i64) true)") 2))
  (assert (= (p/cast i64 (root 1)) 0))
  (assert (!= (p/cast i64 (root 2)) 0))
  (assert (= (value 2) 9)) (s/leave!)
  (assert (!= (s/submit! "(module demo) (g)") 0))
  (assert (= (s/current-revision) 2))
  (assert (= (s/submit! "(module demo) (defn f [] (-> i64) 42)") 0))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 42)) (s/leave!)
  (assert (= (s/close!) 0)))

(deftest blocked-prototypes-do-not-enter-retained-forms
  (assert (= (s/init!) 0))
  (assert (= (s/submit! "(module demo) (import \"live-poc-coil.meta\") (import \"live-poc-coil.prototype-policy\") (defn f [] (-> i64) 1)") 0))
  (for [i 0 20]
    (assert (= (s/submit-deferred! "(module demo) (defn f [] (-> i64) true)") 2))
    (assert (= (s/submit! "(module demo) (defn f [] (-> i64) 42)") 0)))
  (assert (= (s/close!) 0)))

(deftest host-leaf-contract-preserves-argument-dependencies-and-unknown-externs
  (assert (= (s/init!) 0))
  (assert (= (s/submit! "(module leaf-contract) (import \"live-poc-coil.meta\") (import \"live-poc-coil.paper-api\" :as paper)
    (extern unknown :as \"lpc_paper_redraw\" :cc c [] (-> i64))
    (defstruct Controls :live/state true [(clicks i64 0)]) (letonce controls (Controls))
    (defn broken [] (-> i64) 1)
    (defn control [] (-> i64) (set! (.clicks controls) (+ (.clicks controls) 1)) (paper/redraw) 42)
    (defn argument [] (-> i64) (paper/number 0.0 0.0 12.0 0 (broken)))
    (defn opaque [] (-> i64) (unknown))") 0))
  (assert (= (s/submit-deferred! "(module leaf-contract) (defn broken [] (-> i64) true)") 2))
  (assert (!= (p/cast i64 (root 1)) 0))
  (assert (= (value 1) 42)) (s/leave!)
  (assert (= (p/cast i64 (root 2)) 0))
  (assert (= (p/cast i64 (root 3)) 0))
  (assert (= (s/close!) 0)))
