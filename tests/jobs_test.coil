(module live-poc-coil.jobs-test)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-len])
(import "coil.sync" :as sync)
(import "coil.atomic" :as atomic)
(import "coil.scratch" :as scratch)
(import "coil.thread" :as thread)
(import "coil.time" :as time)
(import "coil.result" :use *)
(import "live-poc-coil.jobs" :as jobs)
(import "live-poc-coil.bencode" :as b)
(defstruct Gate [(started sync/Event) (resume sync/Event) (finished sync/Event)])
(defn gate [] (-> (ptr Gate)) (p/alloc-static Gate))
(defn execute [(job (ptr jobs/Job))] (-> i64)
  (sync/event-notify-all! (field (gate) started))
  (sync/event-wait! (field (gate) resume) 0)
  (let [(mut response) (b/response-new (scratch/scratch-allocator (field job arena)))]
    (b/response-string! (mut response) "id" (.id (.request job)))
    (b/response-status! (mut response) "done")
    (set! (.response job) (b/response-finish! (mut response))))
  (sync/event-notify-all! (field (gate) finished))
  0)
(deftest network-reference-survives-executor-completion-and-interrupt
  (sync/event-init (field (gate) started))
  (sync/event-init (field (gate) resume))
  (sync/event-init (field (gate) finished))
  (jobs/init! (p/fnptr-of execute))
  (let [job (jobs/enqueue! "d2:id1:a2:op4:eval4:code1:1e" 1.0)]
    (assert (!= (p/cast i64 job) 0))
    (sync/event-wait! (field (gate) started) 0)
    (assert (not (jobs/ready? job)))
    (assert (= (jobs/interrupt! "a") 1))
    (assert (= (atomic/atomic-load (field job cancel)) 1))
    (sync/event-notify-all! (field (gate) resume))
    (sync/event-wait! (field (gate) finished) 0)
    (jobs/close!) (jobs/destroy!)
    (assert (jobs/ready? job))
    (assert (= (atomic/atomic-load (field job refs)) 1))
    (assert (= (.id (.request job)) "a"))
    (assert (> (slice-len (.response job)) 0))
    (jobs/release! job))
  (sync/event-destroy! (field (gate) started))
  (sync/event-destroy! (field (gate) resume))
  (sync/event-destroy! (field (gate) finished)))
