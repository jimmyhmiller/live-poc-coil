(module live-poc-coil.managed-session-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.fs" :as fs)
(import "coil.result" :use *)
(import "coil.atomic" :as atomic)
(import "coil.arraylist" :as al)
(import "live-poc-coil.session" :as session)
(import "live-poc-coil.graph" :as graph)
(import "live-poc-coil.managed" :as managed)
(defstruct Counts [(aborted i64) (retired i64)])
(defn counts [] (-> (ptr Counts)) (p/alloc-static Counts))
(defn aborted [] (-> i64) (set! (.aborted (counts)) (+ (.aborted (counts)) 1)) 0)
(defn retired [] (-> i64) (set! (.retired (counts)) (+ (.retired (counts)) 1)) 0)
(export-c [aborted :as "test_state_abort"] [retired :as "test_state_retire"])
(defn submit-file [(path (slice u8)) (deferred bool)] (-> i64)
  (match (fs/read-file (a/malloc-allocator) path)
    (Err [_] -900)
    (Ok [source]
      (let [status (session/submit-mode! source deferred)]
        (a/free (a/malloc-allocator) source) status))))
(deftest native-schema-candidate-rejects-and-repairs-with-owned-adapter-lifetimes
  (store! (counts) (p/zeroed Counts))
  (assert (= (session/init!) 0))
  (assert (= (submit-file "fixtures/managed-v1.coil" false) 0))
  (assert (= (atomic/atomic-load (field (managed/state) epoch)) 1))
  (assert (= (session/submit! "(module managed-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "7"))
  (let [identity (graph/root (field (managed/state) heap) 1) revision (session/current-revision)]
    (assert (= (submit-file "fixtures/managed-v2-bad.coil" true) -77))
    (assert (= (session/current-revision) revision))
    (assert (= (.aborted (counts)) 1))
    (assert (= (atomic/atomic-load (field (managed/state) condition)) -77))
    (assert (= (graph/root (field (managed/state) heap) 1) identity))
    (assert (= (.version (.schema identity)) 1))
    (assert (= (submit-file "fixtures/managed-v2.coil" false) 0))
    (assert (= (graph/root (field (managed/state) heap) 1) identity))
    (assert (= (.version (.schema identity)) 2))
    (assert (= (atomic/atomic-load (field (managed/state) condition)) 0))
    (assert (= (atomic/atomic-load (field (managed/state) epoch)) 2))
    ; The handwritten bridge fixture's two physical structs are ordinary
    ; program structs too, so the session versions them alongside logical 77.
    (assert (= (al/al-len (.schemas (field (managed/state) heap))) 3))
    (assert (= (al/al-len (.edges (field (managed/state) heap))) 0))
    (assert (= (al/al-len (.owners (managed/state))) 3)))
  (assert (= (session/submit! "(module managed-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "9"))
  (assert (= (session/submit! "(module managed-demo) (added-value)") 0))
  (assert (= (.result (session/instance)) "99"))
  (assert (= (session/close!) 0))
  (assert (= (.retired (counts)) 3)))
