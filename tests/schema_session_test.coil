(module live-poc-coil.schema-session-test)
(import "coil.primitive" :as p)
(import "live-poc-coil.session" :as session)
(import "live-poc-coil.managed" :as managed)
(import "live-poc-coil.graph" :as graph)
(import "live-poc-coil.source" :as source)
(import "coil.arraylist" :as al)
(import "coil.alloc" :as a)
(deftest authored-schema-edit-rechecks-root-users-and-preserves-state
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module schema-demo) (import \"live-poc-coil.meta\") (defstruct State [(value i64 7)]) (letonce world (State :value 42)) (defn read-value [] (-> i64) (.value world))") 0))
  (assert (= (session/submit! "(module schema-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (let [root (graph/root (field (managed/state) heap) 1)]
    (assert (!= (session/submit! "(module schema-demo) (defstruct State :jit/retain true [(value i64 99)])") 0))
    (assert (= (.version (.schema root)) 1))
    (assert (= (session/submit! "(module schema-demo) (letonce world (State :value 99))") 0))
    (assert (= (session/submit! "(module schema-demo) (read-value)") 0))
    (assert (= (.result (session/instance)) "42"))
    (assert (= (session/submit! "(module schema-demo) (defstruct State [(added i64 77) (value i64 7)])") 0))
    (assert (= (graph/root (field (managed/state) heap) 1) root))
    (assert (= (.version (.schema root)) 2))
    (assert (= (session/submit! "(module schema-demo) (read-value)") 0))
    (assert (= (.result (session/instance)) "42"))
    (assert (= (session/submit! "(module schema-demo) (.added world)") 0))
    (assert (= (.result (session/instance)) "77"))
    (assert (= (session/submit! "(module schema-demo) (letonce second (State :value 12))") 0))
    (assert (= (session/submit! "(module schema-demo) (.added second)") 0))
    (assert (= (.result (session/instance)) "77")))
  (assert (= (session/close!) 0)))

(deftest generated-defaults-keep-distinct-identities-and-explicit-constructor-values
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module defaults-demo) (import \"live-poc-coil.meta\") (defstruct State [(first i64 11) (second i64 22)]) (letonce initial (State))") 0))
  (assert (= (session/submit! "(module defaults-demo) (+ (.first initial) (.second initial))") 0))
  (assert (= (.result (session/instance)) "33"))
  (assert (= (session/submit! "(module defaults-demo) (letonce explicit (State :first 100))") 0))
  (assert (= (session/submit! "(module defaults-demo) (+ (.first explicit) (.second explicit))") 0))
  (assert (= (.result (session/instance)) "122"))
  (assert (!= (session/submit! "(module defaults-demo) (letonce positional (State 100 200))") 0))
  (assert (= (session/submit! "(module defaults-demo) (+ (.first explicit) (.second explicit))") 0))
  (assert (= (.result (session/instance)) "122"))
  (assert (= (session/close!) 0)))

(deftest typed-field-transition-preserves-old-values-and-rejects-missing-edges
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module transition-demo) (import \"live-poc-coil.meta\") (defstruct State [(visible bool true) (value i64 7)]) (letonce world (State :visible false :value 42)) (defn value [] (-> i64) (.value world))") 0))
  (assert (= (session/submit! "(module transition-demo) (defsum Visibility (Hidden) (Visible))") 0))
  (let [root (graph/root (field (managed/state) heap) 1) version (.version (.schema root))]
    ; A new-construction default is not a migration of the existing false value.
    (assert (!= (session/submit! "(module transition-demo) (defstruct State [(visible Visibility (Visible)) (value i64 7)])") 0))
    (assert (= (.version (.schema root)) version))
    (assert (= (session/submit! "(module transition-demo) (value)") 0))
    (assert (= (.result (session/instance)) "42"))
    (assert (= (session/submit! "(module transition-demo) (defstruct State [(visible Visibility (Visible)) (value i64 7)]) (migrate State visible old (if old (Visible) (Hidden))) (defn is-hidden [] (-> bool) (match (.visible world) (Hidden [] true) (Visible [] false)))") 0))
    (assert (= (graph/root (field (managed/state) heap) 1) root))
    (assert (= (.version (.schema root)) (+ version 1)))
    (assert (= (session/submit! "(module transition-demo) (is-hidden)") 0))
    (assert (= (.result (session/instance)) "true"))
    (assert (= (session/submit! "(module transition-demo) (value)") 0))
    (assert (= (.result (session/instance)) "42")))
  (assert (= (session/close!) 0)))

(deftest missing-transition-repair-composes-with-desired-schema
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module deferred-schema) (import \"live-poc-coil.meta\") (defsum Visibility (Hidden) (Visible)) (defstruct State [(visible bool true) (value i64 7)]) (letonce world (State :visible false :value 42)) (defn value [] (-> i64) (.value world))") 0))
  (let [root (graph/root (field (managed/state) heap) 1)
        version (.version (.schema root))]
    (assert (!= (session/submit-deferred! "(module deferred-schema) (defstruct State [(visible Visibility (Visible)) (value i64 7)])") 0))
    (assert (= (.version (.schema root)) version))
    (assert (!= (.desired-schema (session/instance)) ""))
    (assert (= (session/submit! "(module unrelated-schema) (import \"live-poc-coil.meta\") (defn ready [] (-> i64) 19)") 0))
    (assert (!= (.desired-schema (session/instance)) ""))
    ; A rejected strict repair must not replace the pending desired snapshot.
    (let [desired (source/copy (.desired-schema (session/instance)))]
      (assert (!= (session/submit! "(module deferred-schema) (migrate State visible old 17)") 0))
      (assert (= desired (.desired-schema (session/instance))))
      (a/free (a/malloc-allocator) desired))
    (assert (= (.version (.schema root)) version))
    (assert (= (session/submit! "(module deferred-schema) (migrate State visible old (if old (Visible) (Hidden)))") 0))
    (assert (= (.desired-schema (session/instance)) ""))
    (assert (= (graph/root (field (managed/state) heap) 1) root))
    (assert (= (.version (.schema root)) (+ version 1)))
    (assert (= (session/submit! "(module deferred-schema) (match (.visible world) (Hidden [] true) (Visible [] false))") 0))
    (assert (= (.result (session/instance)) "true"))
    (assert (= (session/submit! "(module deferred-schema) (value)") 0))
    (assert (= (.result (session/instance)) "42"))
    (assert (= (session/submit! "(module unrelated-schema) (ready)") 0))
    (assert (= (.result (session/instance)) "19"))
    (let [ledger (field (session/instance) sources)
          index (source/find ledger "deferred-schema" "defstruct" "State")
          form (al/al-get (.forms ledger) index)]
      (assert (= (.accepted form) (.desired form)))
      (assert (= (.diagnostic form) ""))))
  (assert (= (session/close!) 0)))

(deftest explicit-reset-is-atomic-and-not-replayed-by-declaration-rechecks
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module reset-demo) (import \"live-poc-coil.meta\")
    (defstruct State [(value i64 7)]) (letonce world (State :value 42))
    (defn value [] (-> i64) (.value world))") 0))
  (let [heap (field (managed/state) heap) root (graph/root (field (managed/state) heap) 1)]
    (assert (= (session/submit! "(module reset-demo) (reset-state! world (State :value 99))") 0))
    (assert (= (graph/root heap 1) root))
    (assert (= (.version (.schema root)) 1))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "99"))
    (assert (!= (session/submit! "(module reset-demo) (reset-state! world (State :value 1)) (reset-state! world (State :value 2))") 0))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "99"))
    (assert (!= (session/submit! "(module reset-demo) (reset-state! missing (State))") 0))
    (assert (!= (session/submit! "(module reset-demo) (reset-state! world (State :value true))") 0))
    (assert (= (session/submit! "(module reset-demo) (letonce world (State :value 13))") 0))
    (assert (= (session/submit! "(module reset-demo) (defstruct State [(value i64 7) (added i64 8)])") 0))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "99"))
    (assert (= (session/submit! "(module reset-demo) (reset-state! world (State))") 0))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "7"))
    (assert (= (graph/root heap 1) root))
    (assert (= (session/submit! "(module reset-demo) (letonce other (State :value 42))") 0))
    ; Explicit reset can replace a retyped value, but cannot authorize dropping
    ; other objects that lack a transition for the same logical schema.
    (assert (!= (session/submit! "(module reset-demo)
      (defstruct State [(value bool true)])
      (reset-state! world (State :value false))
      (defn value [] (-> i64) (if (.value world) 1 0))") 0))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "7"))
    (assert (= (session/submit! "(module reset-demo)
      (defstruct State [(value bool true)])
      (reset-state! world (State :value false)) (reset-state! other (State))
      (defn value [] (-> i64) (if (.value world) 1 0))") 0))
    (assert (= (session/submit! "(module reset-demo) (value)") 0))
    (assert (= (.result (session/instance)) "0"))
    (assert (= (session/submit! "(module reset-demo) (.value other)") 0))
    (assert (= (.result (session/instance)) "true"))
    (assert (= (graph/root heap 1) root)))
  (assert (= (session/close!) 0)))

(deftest explicit-field-rename-preserves-the-source-value
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module rename-demo) (import \"live-poc-coil.meta\") (defstruct State [(value i64 7)]) (letonce world (State :value 42)) (defn read-value [] (-> i64) (.value world))") 0))
  (assert (= (session/submit! "(module rename-demo) (defstruct State [(total i64 0)]) (migrate State total :from value old old) (defn read-value [] (-> i64) (.total world))") 0))
  (assert (= (session/submit! "(module rename-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/close!) 0)))


(deftest nested-record-schema-evolution-preserves-contained-values
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module nested-demo) (import \"live-poc-coil.meta\") (defstruct Inner [(value i64 7)]) (defstruct Outer [(inner Inner (Inner :value 7))]) (defstruct Envelope [(outer Outer (Outer))]) (letonce world (Envelope :outer (Outer :inner (Inner :value 42)))) (defn read-value [] (-> i64) (.value (.inner (.outer world))))") 0))
  (assert (= (session/submit! "(module nested-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/submit! "(module nested-demo) (defstruct Inner [(value i64 7) (extra i64 9)])") 0))
  (assert (= (session/submit! "(module nested-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/submit! "(module nested-demo) (.extra (.inner (.outer world)))") 0))
  (assert (= (.result (session/instance)) "9"))
  (assert (!= (session/submit! "(module nested-demo) (defstruct Inner [(value bool true) (extra i64 9)])") 0))
  (assert (= (session/submit! "(module nested-demo) (read-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/submit! "(module nested-demo) (.extra (.inner (.outer world)))") 0))
  (assert (= (.result (session/instance)) "9"))
  (assert (= (session/close!) 0)))

(deftest owned-arraylist-and-borrowed-slice-migrate-with-preserved-aliasing
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module container-demo)
    (import \"live-poc-coil.meta\") (import \"coil.primitive\" :as p)
    (import \"coil.arraylist\" :as al) (import \"coil.alloc\" :as a)
    (import \"coil.slice\" :as slice)
    (defstruct State [(values (al/ArrayList i64) (p/zeroed (al/ArrayList i64)))
                      (view (slice i64) (slice/slice-new (p/cast (ptr i64) 0) 0))])
    (letonce world (State))
    (defn initialize [] (-> i64)
      (set! (.values world) (al/al-new [i64] (a/malloc-allocator)))
      (al/al-push! (field world values) 40) (al/al-push! (field world values) 2)
      (set! (.view world) (slice/slice-new (.data (field world values)) 2)) 0)
    (defn total [] (-> i64) (+ (slice/slice-get (.view world) 0) (slice/slice-get (.view world) 1)))") 0))
  (assert (= (session/submit! "(module container-demo) (initialize)") 0))
  (assert (= (session/submit! "(module container-demo) (total)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/submit! "(module container-demo)
    (defstruct State [(added i64 9)
                      (values (al/ArrayList i64) (p/zeroed (al/ArrayList i64)))
                      (view (slice i64) (slice/slice-new (p/cast (ptr i64) 0) 0))])
    (defn change [] (-> i64)
      (store! (.data (field world values)) 50)
      (slice/slice-get (.view world) 0))") 0))
  (assert (= (session/submit! "(module container-demo) (change)") 0))
  (assert (= (.result (session/instance)) "50"))
  (assert (= (session/submit! "(module container-demo) (+ (total) (.added world))") 0))
  (assert (= (.result (session/instance)) "61"))
  (assert (= (session/close!) 0)))

(deftest container-elements-migrate-recursively-and-interior-slices-follow-new-strides
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module recursive-container-demo)
    (import \"live-poc-coil.meta\") (import \"coil.primitive\" :as p)
    (import \"coil.arraylist\" :as al) (import \"coil.alloc\" :as a)
    (import \"coil.slice\" :as slice)
    (defstruct Item [(value i64 7)])
    (defstruct State [(values (al/ArrayList Item) (p/zeroed (al/ArrayList Item)))
                      (view (slice Item) (slice/slice-new (p/cast (ptr Item) 0) 0))])
    (letonce world (State))
    (defn initialize [] (-> i64)
      (set! (.values world) (al/al-new [Item] (a/malloc-allocator)))
      (al/al-push! (field world values) (Item :value 42))
      (al/al-push! (field world values) (Item :value 8))
      (set! (.view world) (slice/slice-new (p/index (.data (field world values)) 1) 1)) 0)
    (defn viewed [] (-> i64) (load (field (slice/slice-data (.view world)) value)))") 0))
  (assert (= (session/submit! "(module recursive-container-demo) (initialize)") 0))
  (assert (= (session/submit! "(module recursive-container-demo) (viewed)") 0))
  (assert (= (.result (session/instance)) "8"))
  (assert (= (session/submit! "(module recursive-container-demo)
    (defstruct Item [(value i64 7) (extra i64 9)])
    (defn change [] (-> i64)
      (set! (.value (p/index (.data (field world values)) 1)) 50)
      (+ (viewed) (load (field (slice/slice-data (.view world)) extra))))") 0))
  (assert (= (session/submit! "(module recursive-container-demo) (change)") 0))
  (assert (= (.result (session/instance)) "59"))
  (assert (= (session/submit! "(module recursive-container-demo) (load (field (al/al-elem [Item] (field world values) 0) value))") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/close!) 0)))
