(module live-poc-coil.schema-repair-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "live-poc-coil.session" :as session)
(import "live-poc-coil.runtime" :as rt)
(import "live-poc-coil.pending" :as pending)
(import "live-poc-coil.managed" :as managed)
(import "live-poc-coil.graph" :as graph)
(defstruct Counts [(ran i64) (dropped i64)])
(defstruct Input [(counts (ptr Counts))])
(defn run-input [(raw (ptr i8))] (-> i64)
  (let [input (p/cast (ptr Input) raw)]
    (assert (= (p/call-ptr (p/cast (fnptr c [] i64) (session/address 0))) 1))
    (set! (.ran (.counts input)) (+ (.ran (.counts input)) 1))) 0)
(defn drop-input [(raw (ptr i8))] (-> i64)
  (let [input (p/cast (ptr Input) raw)]
    (set! (.dropped (.counts input)) (+ (.dropped (.counts input)) 1))
    (rt/free-one! input)))
(deftest schema-publication-blocks-broken-dependent-and-repaired-input-runs-once
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module schema-repair) (import \"live-poc-coil.meta\") (defsum Visibility (Hidden) (Visible)) (defstruct State :live/state true [(visible bool true) (value i64 42)]) (letonce world (State)) (defn step [] (-> i64) (if (.visible world) (do (set! (.value world) (+ (.value world) 1)) 1) 0)) (defn read-value [] (-> i64) (.value world))") 0))
  (let [root (graph/root (field (managed/state) heap) 1)
        runtime (field (session/instance) runtime) queue (field (session/instance) pending)
        counts (p/alloc-stack Counts)]
    (store! counts (p/zeroed Counts))
    (assert (= (session/submit-deferred! "(module schema-repair) (defstruct State :live/state true [(visible Visibility (Visible)) (value i64 42)]) (migrate State visible old (if old (Visible) (Hidden)))") 2))
    (assert (= (graph/root (field (managed/state) heap) 1) root))
    (assert (= (.version (.schema root)) 2))
    (assert (= (p/cast i64 (rt/enter-root! runtime 0)) 0))
    (assert (!= (p/cast i64 (rt/enter-root! runtime 1)) 0))
    (assert (= (p/call-ptr (p/cast (fnptr c [] i64) (session/address 1))) 42))
    (rt/leave! runtime)
    (let [input (a/box! (a/malloc-allocator) Input (Input :counts counts))]
      (assert (= (pending/enqueue! queue 0 (p/cast (ptr i8) input) (p/fnptr-of run-input) (p/fnptr-of drop-input)) 1)))
    (assert (= (pending/pump-one! queue runtime) 0))
    (assert (= (.ran counts) 0)) (assert (= (.dropped counts) 0))
    (assert (= (session/submit! "(module schema-repair) (defn step [] (-> i64) (match (.visible world) (Hidden [] 0) (Visible [] (set! (.value world) (+ (.value world) 1)) 1)))") 0))
    (assert (= (.version (.schema root)) 2))
    (assert (= (pending/pump-one! queue runtime) 1))
    (assert (= (pending/pump-one! queue runtime) 0))
    (assert (= (.ran counts) 1)) (assert (= (.dropped counts) 1))
    (assert (= (session/submit! "(module schema-repair) (read-value)") 0))
    (assert (= (.result (session/instance)) "43")))
  (assert (= (session/close!) 0)))
