(module live-poc-coil.policy-state-test)
(import "live-poc-coil.session" :as session)
(deftest authored-syntax-commits-with-code-and-replaces-without-accumulating-history
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module policy-demo) (import \"live-poc-coil.meta\") (import \"live-poc-coil.policy-state-probe\" :as probe) (defn f [] (-> i64) 17)") 0))
  (assert (= (session/submit! "(module policy-demo) (probe/body f)") 0))
  (assert (= (.result (session/instance)) "17"))
  (assert (!= (session/submit! "(module policy-demo) (defn f [] (-> i64) true) (defn discarded [] (-> i64) 0)") 0))
  (assert (= (session/submit! "(module policy-demo) (probe/body f)") 0))
  (assert (= (.result (session/instance)) "17"))
  (assert (= (session/submit! "(module policy-demo) (probe/count)") 0))
  (assert (= (.result (session/instance)) "1"))
  (assert (= (session/submit! "(module policy-demo) (defn f [] (-> i64) 23)") 0))
  (assert (= (session/submit! "(module policy-demo) (probe/body f)") 0))
  (assert (= (.result (session/instance)) "23"))
  (assert (= (session/submit! "(module policy-demo) (probe/count)") 0))
  (assert (= (.result (session/instance)) "1"))
  (assert (= (session/close!) 0)))
