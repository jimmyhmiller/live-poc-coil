(module live-poc-coil.source-test)
(import "coil.primitive" :as p)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice)
(import "live-poc-coil.source" :as source)

(deftest desired-and-accepted-source-have-independent-lifetimes
  (let [ledger (p/alloc-stack source/Ledger)]
    (source/init! ledger)
    (source/begin! ledger "(module left) ; ignored declaration text: (defn other)\n(defn f [] (-> i64) 1) (module right) (defn f [] (-> i64) 2)")
    (assert (= (al/al-len (.forms ledger)) 2))
    (source/finish! ledger 0 1 "")
    (source/begin! ledger "(module left) (defn f [] (-> i64) true)")
    (source/replace! (field ledger diagnostic) "return type mismatch")
    (source/finish! ledger 1 1 (.diagnostic ledger))
    (let [left (al/al-get (.forms ledger) (source/find ledger "left" "defn" "f"))
          right (al/al-get (.forms ledger) (source/find ledger "right" "defn" "f"))]
      (assert (= (.desired left) "(defn f [] (-> i64) true)"))
      (assert (= (.accepted left) "(defn f [] (-> i64) 1)"))
      (assert (= (.diagnostic left) "return type mismatch"))
      (assert (= (.accepted right) "(defn f [] (-> i64) 2)"))
      (assert (= (.revision right) 1)))
    (source/begin! ledger "(module left) (defn f [] (-> i64) 3)")
    (source/finish! ledger 0 2 "")
    (let [left (al/al-get (.forms ledger) 0)]
      (assert (= (.accepted left) (.desired left)))
      (assert (= (.revision left) 2)) (assert (= (.diagnostic left) "")))
    (source/begin! ledger "(module left) (defn f")
    (assert (> (slice/slice-len (.diagnostic ledger)) 0))
    (assert (= (.latest ledger) "(module left) (defn f"))
    (let [left (al/al-get (.forms ledger) 0)] (assert (= (.revision left) 2)))
    (source/destroy! ledger)))
