(module live-poc-coil.purity-test)
(import "live-poc-coil.session" :as session)
(deftest pure-preparation-checks-helper-closure-and-rejects-effects-before-publication
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module pure-demo) (import \"live-poc-coil.meta\") (import \"live-poc-coil.purity-policy\") (import \"coil.primitive\" :as p) (defstruct Point [(x i64)]) (defsum Visibility (Hidden) (Visible)) (defn* increment :live/pure true [(x i64)] (-> i64) (+ x 1)) (defn* initial :live/pure true [] (-> Point) (Point :x (increment 6))) (defn* field-value :live/pure true [(value Point)] (-> i64) (.x value)) (defn* transition :live/pure true [(old bool)] (-> Visibility) (if old (Visible) (Hidden))) (defn* result :live/pure true [] (-> i64) (let [value (initial)] (field-value value)))") 0))
  (assert (= (session/submit! "(module pure-demo) (result)") 0))
  (assert (= (.result (session/instance)) "7"))
  (let [revision (session/current-revision)]
    (assert (!= (session/submit! "(module pure-demo) (defn* effect :live/pure true [] (-> i64) (let [(mut value) 0] (set! value 9) (load value)))") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* clock [] (-> i64) 7) (defn* unchecked :live/pure true [] (-> i64) (clock))") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (def global 99) (defn* read-global :live/pure true [] (-> i64) global)") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* raw :live/pure true [(value (ptr i64))] (-> i64) (load value))") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* false-helper :live/pure false [] (-> i64) 8) (defn* caller :live/pure true [] (-> i64) (false-helper))") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* recursive :live/pure true [] (-> i64) (recursive))") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* first :live/pure true [] (-> i64) (second)) (defn* second :live/pure true [] (-> i64) (first))") 0))
    (assert (= (session/current-revision) revision)))
  (assert (= (session/submit! "(module pure-demo) (result)") 0))
  (assert (= (.result (session/instance)) "7"))
  (assert (= (session/close!) 0)))
