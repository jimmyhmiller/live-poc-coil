(module live-poc-coil.purity-test)
(import "live-poc-coil.session" :as session)
(deftest preparation-purity-is-inferred-from-default-helper-closure
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module pure-demo) (import \"live-poc-coil.meta\") (import \"coil.primitive\" :as p) (defstruct Point [(x i64)]) (defn* increment [(x i64)] (-> i64) (+ x 1)) (defn* initial [] (-> Point) (Point :x (increment 6))) (defstruct Holder [(point Point (initial))]) (defn result [] (-> i64) (let [value (initial)] (.x value)))") 0))
  (assert (= (session/submit! "(module pure-demo) (result)") 0))
  (assert (= (.result (session/instance)) "7"))
  (let [revision (session/current-revision)]
    (assert (!= (session/submit! "(module pure-demo) (defn* effect [] (-> i64) (let [(mut value) 0] (set! value 9) (load value))) (defstruct BadEffect [(value i64 (effect))])") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (def global 99) (defn* read-global [] (-> i64) global) (defstruct BadGlobal [(value i64 (read-global))])") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* raw [(value (ptr i64))] (-> i64) (load value)) (defstruct BadRaw [(value i64 (raw (p/alloc-static i64)))])") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* recursive [] (-> i64) (recursive)) (defstruct BadRecursive [(value i64 (recursive))])") 0))
    (assert (= (session/current-revision) revision))
    (assert (!= (session/submit! "(module pure-demo) (defn* first [] (-> i64) (second)) (defn* second [] (-> i64) (first)) (defstruct BadCycle [(value i64 (first))])") 0))
    (assert (= (session/current-revision) revision)))
  (assert (= (session/submit! "(module pure-demo) (result)") 0))
  (assert (= (.result (session/instance)) "7"))
  (assert (= (session/close!) 0)))
