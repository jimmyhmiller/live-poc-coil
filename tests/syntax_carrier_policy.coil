(module live-poc-coil.syntax-carrier-policy)
(import "coil.primitive" :as p)
(import "live-poc-coil.syntax-state" :as syntax)
(import "live-poc-coil.policy-state" :as policy)
(defn check-envelope [(form Code)] (-> i64)
  (let [data (syntax/payload form)]
    (unless (= (p/code-count data) 3) (p/error "envelope lost payload") 0)
    (unless (p/bound-identifier=? (p/code-nth data 0) (p/code-nth data 1))
      (p/error "envelope lost identifier identity") 0)
    (when (p/bound-identifier=? (p/code-nth data 0) (p/code-nth data 2))
      (p/error "envelope merged distinct fresh identifiers") 0)) 0)
(defn consume [(modules Code) (remove bool)] (-> Code)
  (let [out (p/code-list-new)]
    (for [mi 0 (p/code-count modules)]
      (let [m (p/code-nth modules mi) next (p/code-list-new)]
        (p/code-list-push! next (p/code-nth m 0))
        (for [fi 1 (p/code-count m)]
          (let [form (p/code-nth m fi)]
            (if (and (syntax/envelope? form) (not (policy/envelope? form)))
              (do (check-envelope form)
                (unless remove (p/code-list-push! next form) 0) 0)
              (do (p/code-list-push! next form) 0))))
        (p/code-list-push! out (p/code-list-done next))))
    `(do ~@(p/code-list-done out))))
(defn expanded [(modules Code)] (-> Code) (consume modules false))
(defn checked [(modules Code)] (-> Code) (consume modules true))
(transform expanded :phase after-expand)
(transform-once checked)
(defn generate [] (-> Code)
  (let [first (p/fresh-identifier "schema") second (p/fresh-identifier "schema")]
    (syntax/envelope `candidate-envelope `(~first ~first ~second))))
