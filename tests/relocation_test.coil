(module live-poc-coil.relocation-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "live-poc-coil.relocation" :as relocation)
(deftest interior-ranges-check-full-extent-overflow-and-ambiguous-owners
  (let [journal (p/alloc-stack relocation/Journal)
        old (p/cast (ptr i8) (p/alloc-stack (array i8 32)))
        next (p/cast (ptr i8) (p/alloc-stack (array i8 32)))
        slot (p/alloc-stack (ptr i8))]
    (relocation/init! journal (a/malloc-allocator))
    (assert (= (relocation/range! journal old 32 next 24) 0))
    (assert (= (relocation/range! journal (p/index old 8) 8 next 8) -1))
    (assert (= (relocation/range! journal old -1 next 24) -1))
    (assert (= (relocation/range! journal (p/cast (ptr i8) -8) 16 next 16) -1))
    (store! slot (p/index old 8))
    (assert (= (relocation/slice! journal slot 2 8) 0))
    (assert (= (load slot) (p/index next 8)))
    (store! slot (p/index old 16))
    (assert (= (relocation/slice! journal slot 2 8) -1))
    (assert (= (load slot) (p/index old 16)))
    (assert (= (relocation/slice! journal slot -1 8) -1))
    (assert (= (relocation/slice! journal slot 9223372036854775807 8) -1))
    (store! slot (p/cast (ptr i8) 0))
    (assert (= (relocation/slice! journal slot 0 8) 0))
    (assert (= (relocation/slice! journal slot 1 8) -1))
    (store! slot old)
    (assert (= (relocation/reference! journal slot 7) -1))
    (assert (= (relocation/object! journal old next 7) 0))
    (assert (= (relocation/reference! journal slot 8) -1))
    (assert (= (relocation/reference! journal slot 7) 0))
    (assert (= (load slot) next))
    (relocation/destroy! journal)))
