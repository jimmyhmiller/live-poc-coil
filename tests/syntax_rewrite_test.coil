(module live-poc-coil.syntax-rewrite-test)
(import "coil.primitive" :as p)
(import "live-poc-coil.syntax-rewrite-policy" :use *)
(defstruct Physical [(value i64) (root i64)])
(defsum Choice (Empty) (Present [(value i64)]))
(defn* storage [] (-> (ptr Physical)) (p/alloc-static Physical))
(defn* read-root :test/rewrite true [] (-> i64) (.value root))
(defn* field-label :test/rewrite true [] (-> i64) (load (field root root)))
(defn* parameter-shadow :test/rewrite true [(root i64)] (-> i64) root)
(defn* local-shadow :test/rewrite true [] (-> i64)
  (let [root (+ (.value root) 1)] root))
(defn* nominal-shadow :test/rewrite true [(State i64)] (-> i64) (+ State 1))
(defn* constructor :test/rewrite true [] (-> i64)
  (let [value (State :value 8 :root 9)] (+ (.value value) (.root value))))
(defn* match-shadow :test/rewrite true [] (-> i64)
  (match (Present 33) (Empty [] 0) (Present [root] root)))
(defn* mutable-shadow :test/rewrite true [] (-> i64)
  (let [(mut root) 5] (set! root (+ (load root) 2)) (load root)))
(defn* pointer-type :test/rewrite true [(value (ptr State))] (-> i64) (.value value))
(defn* closure-shadow :test/rewrite true [] (-> i64)
  (let [f (: (fn [root] (+ root 1)) (fnptr c [i64] i64))] (f 31)))
(defn* iteration-shadow :test/rewrite true [] (-> i64)
  (let [(mut result) 0]
    (for [root 0 4] (set! result (+ (load result) root)))
    (load result)))
(deftest expanded-managed-name-rewrite-preserves-lexical-bindings-and-field-labels
  (set! (.value (storage)) 47) (set! (.root (storage)) 19)
  (assert (= (read-root) 47))
  (assert (= (field-label) 19))
  (assert (= (parameter-shadow 42) 42))
  (assert (= (local-shadow) 48))
  (assert (= (nominal-shadow 10) 11))
  (assert (= (constructor) 17))
  (assert (= (match-shadow) 33))
  (assert (= (mutable-shadow) 7))
  (assert (= (pointer-type (storage)) 47))
  (assert (= (closure-shadow) 32))
  (assert (= (iteration-shadow) 6)))
