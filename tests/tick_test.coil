(module live-poc-coil.tick-test)
(import "coil.primitive" :as p)
(import "live-poc-coil.paper" :as paper)
(defn observed [] (-> (ptr f64)) (p/alloc-static f64))
(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64) (store! (observed) x) 0)
(defn close? [(x f64) (expected f64)] (-> bool)
  (and (> x (- expected 0.000001)) (< x (+ expected 0.000001))))
(deftest resumed-tick-is-bounded-and-keeps-monotonic-application-time
  (let [state (paper/app-state) input (p/alloc-stack paper/Input)]
    (store! state (p/zeroed paper/AppState))
    (set! (.event state) (p/fnptr-of event))
    (store! input (paper/Input :kind 6 :id 0 :x 100.0 :y 0.0))
    (paper/execute-input (p/cast (ptr i8) input))
    (assert (close? (load (observed)) 100.0))
    (set! (.x input) 110.0)
    (paper/execute-input (p/cast (ptr i8) input))
    (assert (close? (load (observed)) 100.05))
    (set! (.x input) 110.01)
    (paper/execute-input (p/cast (ptr i8) input))
    (assert (close? (load (observed)) 100.06))
    (set! (.kind input) 3) (set! (.x input) 500.0)
    (paper/execute-input (p/cast (ptr i8) input))
    (assert (close? (load (observed)) 500.0))
    (assert (close? (.tick-clock state) 100.06))))
