(module live-poc-coil.schema-records-test)
(import "live-poc-coil.session" :as session)
(deftest schema-records-preserve-nominal-identity-and-generate-distinct-physical-types
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module schema-probe) (import \"live-poc-coil.meta\") (import \"live-poc-coil.schema-records-probe\" :as probe)") 0))
  (assert (= (session/submit! "(module schema-probe) (probe/generated-record-value)") 0))
  (assert (= (.result (session/instance)) "42"))
  (assert (= (session/close!) 0)))
