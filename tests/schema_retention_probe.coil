;;; Long-running integration probe; invoked separately with compiler memory tracing.
(module live-poc-coil.schema-retention-probe)
(import "coil.primitive" :as p)
(import "coil.str" :as str)
(import "coil.jit" :as jit)
(extern printf :cc c [(ptr i8) ...] (-> i32))
(import "live-poc-coil.session" :as session)
(import "live-poc-coil.managed" :as managed)
(import "live-poc-coil.graph" :as graph)
(import "coil.arraylist" :as al)
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [count (if (> argc 1)
    (match (str/str-parse-int (str/cstr->str (load (p/index argv 1)))) (Some [n] n) (None [] 0)) 1000)]
  (assert (and (> count 0) (<= count 100000)))
  (assert (= (session/init!) 0))
  (assert (= (session/submit! "(module schema-soak) (import \"live-poc-coil.meta\") (defstruct State :live/state true [(value i64 7) (added i64 77)]) (letonce world (State :value 42)) (defn value [] (-> i64) (.value world))") 0))
  (let [heap (field (managed/state) heap) root (graph/root heap 1)]
    (for [i 0 count]
      (let [even (= (% i 2) 0)]
        (assert (= (session/submit! (if even
          "(module schema-soak) (defstruct State :live/state true [(added i64 88) (value i64 7)])"
          "(module schema-soak) (defstruct State :live/state true [(value i64 7) (added i64 77)])")) 0))
        (assert (= (graph/root heap 1) root))
        (assert (= (.version (.schema root)) (+ i 2)))
        (assert (= (al/al-len (.schemas heap)) 1))
        (assert (= (al/al-len (.edges heap)) 0))
        (assert (= (al/al-len (.handles heap)) 1))
        (assert (= (al/al-len (.owners (managed/state))) 1))
        (assert (<= (jit/jit-generation-count (field (session/instance) compiler)) 4))
        (assert (<= (al/al-len (.images (field (session/instance) runtime))) 2))
        (assert (= (load (p/index (p/cast (ptr i64) (graph/payload (.memory root))) (if even 1 0))) 42))
        (assert (= (load (p/index (p/cast (ptr i64) (graph/payload (.memory root))) (if even 0 1))) 77))
        (when (= (% i 25) 0)
          (printf c"schema-retention: version=%lld generations=%lld runtime-images=%lld owned-bytes=%lld owned-peak=%lld\n"
            (.version (.schema root)) (jit/jit-generation-count (field (session/instance) compiler))
            (al/al-len (.images (field (session/instance) runtime)))
            (.live-bytes (field (session/instance) heap)) (.peak-bytes (field (session/instance) heap)))
          (assert (= (session/submit! "(module schema-soak) (let [fresh (State)] (.added fresh))") 0))
          (assert (= (.result (session/instance)) (if even "88" "77")))
          ; A rejected proposal must retain the current root, defaults and graph.
          (assert (!= (session/submit! "(module schema-soak) (defstruct State :live/state true [(value bool false)])") 0))
          (assert (= (.version (.schema root)) (+ i 2))) 0)))
    (assert (= (session/submit! "(module schema-soak) (value)") 0))
    (assert (= (.result (session/instance)) "42")))
  (assert (= (session/close!) 0))
  0))
