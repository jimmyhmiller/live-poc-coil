(module live-poc-coil.pending-concurrency-test)
(import "coil.primitive" :as p)
(import "coil.sync" :as sync)
(import "coil.thread" :as thread)
(import "live-poc-coil.pending" :as pending)
(import "live-poc-coil.runtime" :as rt)
(defstruct Context [(started sync/Event) (resume sync/Event)
  (runtime (ptr rt/Runtime)) (queue (ptr pending/Queue)) (drops i64) (result i64)])
(defn hold [(raw (ptr i8))] (-> i64)
  (let [context (p/cast (ptr Context) raw)]
    (sync/event-notify-all! (field context started))
    (sync/event-wait! (field context resume) 0))
  0)
(defn drop [(raw (ptr i8))] (-> i64)
  (let [context (p/cast (ptr Context) raw)]
    (set! (.drops context) (+ (.drops context) 1)))
  0)
(defn pump [(raw (ptr i8))] (-> (ptr i8))
  (let [context (p/cast (ptr Context) raw)]
    (set! (.result context) (pending/pump-one! (.queue context) (.runtime context))))
  (p/cast (ptr i8) 0))
(defn target [] (-> i64) 42)
(deftest cancellation-and-close-do-not-drop-executing-input
  (let [runtime (p/alloc-stack rt/Runtime) queue (p/alloc-stack pending/Queue)
        context (p/alloc-stack Context) worker (p/alloc-stack thread/Thread)]
    (rt/init! runtime) (pending/init! queue 2)
    (store! context (p/zeroed Context))
    (set! (.runtime context) runtime) (set! (.queue context) queue)
    (sync/event-init (field context started)) (sync/event-init (field context resume))
    (let [view (rt/clone-current! runtime)]
      (rt/stage! view 0 (p/cast (ptr i8) (p/fnptr-of target))) (rt/publish! runtime view))
    (assert (= (pending/enqueue! queue 0 (p/cast (ptr i8) context) (p/fnptr-of hold) (p/fnptr-of drop)) 1))
    (assert (= (thread/thread-spawn worker (p/fnptr-of pump) (p/cast (ptr i8) context)) 0))
    (sync/event-wait! (field context started) 0)
    (assert (= (pending/cancel! queue 1) -2))
    (assert (= (pending/close! queue) -1))
    (assert (= (.drops context) 0))
    (assert (= (pending/enqueue! queue 0 (p/cast (ptr i8) context) (p/fnptr-of hold) (p/fnptr-of drop)) -1))
    (sync/event-notify-all! (field context resume))
    (assert (= (thread/thread-join worker) 0))
    (assert (= (.result context) 1)) (assert (= (.drops context) 1))
    (assert (= (pending/close! queue) 0))
    (pending/destroy! queue)
    (sync/event-destroy! (field context started)) (sync/event-destroy! (field context resume))
    (assert (rt/close! runtime)) (rt/collect-views! runtime) (rt/destroy! runtime)))
