(module live-poc-coil.schema-records-probe)
(import "coil.primitive" :as p)
(import "live-poc-coil.schema-records" :as schema)
(import "live-poc-coil.policy-state" :as policy)
(import "live-poc-coil.semantic")
(defn generate [(name Code)] (-> Code)
  (let [(mut state) '(live-policy-v1 () () () ())
        first '(defstruct State :live/state true [(value i64 7)])
        second `(defstruct ~(p/code-nth first 1) :live/state true [(added i64 77) (value i64 7)])
        root `(letonce world (~(p/code-nth first 1) :value 42))]
    (unless (schema/managed? first) (p/error "schema opt-in was not recognized") 0)
    (unless (= (schema/propose! (mut state) `test first) 0) (p/error "initial schema missing") 0)
    (let [old (p/code-nth (policy/schemas (load state)) 0)]
      (unless (= (schema/propose! (mut state) `test first) -1) (p/error "identical schema changed version") 0)
      (unless (= (schema/propose! (mut state) `test second) 0) (p/error "replacement schema missing") 0)
      (let [next (p/code-nth (policy/schemas (load state)) 0)]
        (unless (p/code-eq (p/code-nth old 2) (p/code-nth next 2)) (p/error "nominal identity changed") 0)
        (unless (p/code-eq (p/code-nth next 3) `2) (p/error "version did not advance") 0)
        (when (p/bound-identifier=? (p/code-nth old 4) (p/code-nth next 4))
          (p/error "physical type identity was reused") 0)
        (unless (= (schema/propose-root! (mut state) `test root) 0)
          (p/error "root missing") 0)
        (unless (= (schema/propose-root! (mut state) `test `(letonce ~(p/code-nth root 1) (~(p/code-nth first 1) :value 99))) 0)
          (p/error "root identity changed") 0)
        (unless (= (p/code-count (policy/roots (load state))) 1) (p/error "root history accumulated") 0)
        `(do
          ~(schema/physical-definition next)
          (defn* ~name [] (-> i64)
            (let [value (~(p/code-nth next 4) :added 77 :value 42)] (.value value))))))))
(generate generated-record-value)
