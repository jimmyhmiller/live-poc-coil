(module live-poc-coil.meta-pipeline-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(deftest retains-policy-after-meta-output
  (let [(mut compiler) (jit/jit-session-new (a/malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut compiler)
      "(module demo) (import \"coil.repl\") (defn make-meta [] (-> Code) `(defn* generated [] (-> i64) 9)) (meta (make-meta)) (defn color [] (-> i64) 1)"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut compiler)
      "(module demo) (defn color [] (-> i64) 2)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-reset! (mut compiler)) 0))))
