(module live-poc-coil.managed-test)
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "live-poc-coil.graph" :as graph)
(import "live-poc-coil.runtime" :as rt)
(import "live-poc-coil.relocation" :as relocation)
(import "live-poc-coil.managed" :as managed)
(defstruct Audit [(candidate-alive bool) (aborted i64)])
(defn audit [] (-> (ptr Audit)) (p/alloc-static Audit))
(defn initialize [(target (ptr i8)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr i64) target) 7) (store! prefix 1) 0)
(defn copy [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr i64) target) (load (p/cast (ptr i64) old))) (store! prefix 1) 0)
(defn rewrite [(target (ptr i8)) (journal (ptr relocation/Journal))] (-> i64) 0)
(defn valid [(target (ptr i8))] (-> i64) 0)
(defn abort [(target (ptr i8)) (prefix i64)] (-> void) (do))
(defn abort-candidate [(target (ptr i8)) (prefix i64)] (-> void)
  (assert (.candidate-alive (audit)))
  (when (> prefix 0) (set! (.aborted (audit)) (+ (.aborted (audit)) 1))) (do))
(defn retire [(target (ptr i8))] (-> void) (do))
(defn bad [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr i64) target) 999) (store! prefix 1) -88)
(defn good [(old (ptr i8)) (target (ptr i8)) (journal (ptr relocation/Journal)) (prefix (ptr i64))] (-> i64)
  (store! (p/cast (ptr i64) target) (+ (load (p/cast (ptr i64) old)) 2)) (store! prefix 1) 0)
(defn schema [(version i64)] (-> graph/Schema)
  (graph/Schema :logical 7 :version version :size 8 :alignment 8 :fields 1
    :initialize (p/fnptr-of initialize) :clone (p/fnptr-of copy) :rewrite (p/fnptr-of rewrite)
    :validate (p/fnptr-of valid) :abort (if (= version 1) (p/fnptr-of abort) (p/fnptr-of abort-candidate))
    :retire (p/fnptr-of retire)))
(deftest managed-registration-owns-code-and-aborts-before-candidate-unload
  (let [runtime (p/alloc-stack rt/Runtime) first-image (p/alloc-stack rt/Image)
        next-image (p/alloc-stack rt/Image) definition (p/alloc-stack graph/Schema)
        cancel (p/cast (ptr i64) 0)]
    (store! first-image (p/zeroed rt/Image)) (store! next-image (p/zeroed rt/Image))
    (store! (audit) (Audit :candidate-alive true :aborted 0))
    (rt/init! runtime) (managed/init! runtime)
    (managed/begin! cancel false)
    (store! definition (schema 1))
    (assert (= (managed/stage-schema! definition) 0))
    (assert (= (managed/stage-root! 1 7 1) 0))
    (assert (= (managed/prepare!) 0))
    (managed/publish! first-image) (managed/finish! true)
    (assert (= (.references first-image) 1))
    (rt/enter! runtime)
    (assert (= (load (p/cast (ptr i64) (managed/root-payload 1 7 1))) 7))
    (rt/leave! runtime)
    (let [identity (graph/root (field (managed/state) heap) 1)]
      (managed/begin! cancel true)
      (store! definition (schema 2))
      (assert (= (managed/stage-schema! definition) 0))
      (assert (= (managed/stage-edge! 7 1 2 (p/fnptr-of bad)) 0))
      (assert (= (managed/prepare!) -88))
      (assert (= (.aborted (audit)) 1))
      (set! (.candidate-alive (audit)) false)
      (managed/finish! false)
      (assert (= (.references first-image) 1)) (assert (= (.references next-image) 0))
      (assert (= (atomic/atomic-load (field (managed/state) condition)) -88))
      (assert (= (p/cast i64 (rt/enter! runtime)) 0))
      (assert (= (graph/root (field (managed/state) heap) 1) identity))
      (assert (= (load (p/cast (ptr i64) (graph/payload (.memory identity)))) 7))
      (set! (.candidate-alive (audit)) true)
      (managed/begin! cancel false)
      (assert (= (managed/stage-schema! definition) 0))
      (assert (= (managed/stage-edge! 7 1 2 (p/fnptr-of good)) 0))
      (assert (= (managed/prepare!) 0))
      (managed/publish! next-image) (managed/finish! true)
      (assert (= (.references next-image) 1))
      (assert (= (.references first-image) 0))
      (assert (= (atomic/atomic-load (field (managed/state) condition)) 0))
      (assert (= (graph/root (field (managed/state) heap) 1) identity))
      (rt/enter! runtime)
      (assert (= (load (p/cast (ptr i64) (managed/root-payload 1 7 2))) 9))
      (rt/leave! runtime))
    (assert (rt/close! runtime))
    (managed/destroy!)
    (assert (= (.references first-image) 0)) (assert (= (.references next-image) 0))
    (rt/collect-views! runtime) (rt/destroy! runtime)))
