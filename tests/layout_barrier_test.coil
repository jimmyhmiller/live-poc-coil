(module live-poc-coil.layout-barrier-test)
(import "coil.primitive" :as p)
(import "coil.atomic" :as atomic)
(import "coil.sync" :as sync)
(import "coil.thread" :as thread)
(import "live-poc-coil.runtime" :as rt)
(defstruct Running [(runtime (ptr rt/Runtime)) (entered sync/Event) (finish sync/Event)])
(defn target [] (-> i64) 42)
(defn reader [(context (ptr i8))] (-> (ptr i8))
  (let [running (p/cast (ptr Running) context) runtime (.runtime running)]
    (assert (!= (p/cast i64 (rt/enter-root! runtime 0)) 0))
    (sync/event-notify-all! (field running entered))
    (sync/event-wait! (field running finish) 0)
    (assert (= (p/call-ptr (p/cast (fnptr c [] i64) (rt/resolve runtime 0))) 42))
    (rt/leave! runtime))
  (p/cast (ptr i8) 0))
(deftest layout-barrier-denies-new-work-and-drains-without-holding-completion-lock
  (let [runtime (p/alloc-stack rt/Runtime) running (p/alloc-stack Running)
        worker (p/alloc-stack thread/Thread) cancel (p/alloc-stack i64)]
    (rt/init! runtime)
    (let [v (rt/clone-current! runtime)]
      (rt/stage! v 0 (p/cast (ptr i8) (p/fnptr-of target)))
      (rt/publish! runtime v))
    (set! (.runtime running) runtime)
    (sync/event-init (field running entered)) (sync/event-init (field running finish))
    (assert (= (thread/thread-spawn-configured worker (p/fnptr-of reader) (p/cast (ptr i8) running)
      (thread/thread-config 1048576 16384)) 0))
    (sync/event-wait! (field running entered) 0)
    (rt/close-layout! runtime)
    (assert (= (p/cast i64 (rt/enter-root! runtime 0)) 0))
    (assert (= (p/cast i64 (rt/enter! runtime)) 0))
    (atomic/atomic-store cancel 1)
    (assert (= (rt/drain-layout! runtime cancel) 3))
    (assert (rt/blocked? runtime))
    (atomic/atomic-store cancel 0)
    (sync/event-notify-all! (field running finish))
    (assert (= (rt/drain-layout! runtime cancel) 0))
    (assert (= (thread/thread-join worker) 0))
    (assert (= (p/cast i64 (rt/enter-root! runtime 0)) 0))
    (rt/reopen-layout! runtime)
    (assert (!= (p/cast i64 (rt/enter-root! runtime 0)) 0))
    (rt/leave! runtime)
    (assert (rt/close! runtime))
    (rt/collect-views! runtime) (rt/destroy! runtime)
    (sync/event-destroy! (field running entered)) (sync/event-destroy! (field running finish))))
