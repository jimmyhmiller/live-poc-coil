(module live-poc-coil.conditions-test)
(import "coil.primitive" :as p)
(import "live-poc-coil.conditions" :as c)

(deftest exact-coverage-transitive-blocking-and-revival
  (let [graph (p/alloc-stack c/Graph)]
    (c/init! graph)
    (for [id 0 5] (assert (= (c/declare! graph id (+ id 100)) 0)))
    (assert (= (c/edge! graph 0 1) 0))
    (assert (= (c/edge! graph 1 2) 0))
    (assert (= (c/edge! graph 2 0) 0))
    (assert (= (c/edge! graph 3 1) 0))
    (assert (!= (c/edge! graph 3 99) 0))
    (assert (!= (c/cover! graph 0 999 1 0) 0))
    (for [id 0 4] (assert (= (c/cover! graph id (+ id 100) 1 (if (= id 2) 42 0)) 0)))
    (assert (not (c/complete? graph 1)))
    (assert (= (c/cover! graph 4 104 1 0) 0))
    (assert (c/complete? graph 1))
    (c/propagate! graph)
    (for [id 0 4] (assert (= (c/condition graph id) 42)))
    (assert (= (c/condition graph 4) 0))
    (assert (not (c/complete? graph 2)))
    (for [id 0 5] (assert (= (c/cover! graph id (+ id 100) 2 0) 0)))
    (assert (c/complete? graph 2))
    (c/propagate! graph)
    (for [id 0 5] (assert (= (c/condition graph id) 0)))
    (c/destroy! graph)))
