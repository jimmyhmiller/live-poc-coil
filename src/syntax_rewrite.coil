(module live-poc-coil.syntax-rewrite)
(import "coil.primitive" :as p)

;;; Rewrite an explicitly owned name map in expanded core syntax. Mapping rows
;;; are (identifier replacement). Binders and field labels are not references.
;;; Rebuild through code-list-like so declaration scopes and source survive.
(defn rebuild [(prototype Code) (items Code)] (-> Code)
  (p/code-list-like prototype (if (p/code-vector? prototype) `[~@items] items)))
(defn named? [(names Code) (name Code)] (-> bool)
  (block :found
    (for [i 0 (p/code-count names)]
      (when (p/bound-identifier=? (p/code-nth names i) name) (break :found true)))
    false))
(defn reference [(form Code) (mapping Code) (bound Code)] (-> Code)
  (block :found
    (when (named? bound form) (break :found form))
    (for [i 0 (p/code-count mapping)]
      (let [item (p/code-nth mapping i)]
        (when (p/bound-identifier=? (p/code-nth item 0) form)
          (break :found (p/code-nth item 1)))))
    form))
(defn head? [(form Code) (head Code)] (-> bool)
  (and (p/code-list? form) (and (> (p/code-count form) 0)
    (p/code-eq (p/code-nth form 0) head))))
(defn binder-name [(binder Code)] (-> Code)
  (cond (p/code-sym? binder) binder
        (and (head? binder `mut) (= (p/code-count binder) 2)) (p/code-nth binder 1)
        :else (do (p/error "managed syntax requires an expanded core binding") binder)))
(defn sequence [(forms Code) (start i64) (mapping Code) (bound Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count forms)]
      (p/code-list-push! out (if (< i start) (p/code-nth forms i)
        (rewrite (p/code-nth forms i) mapping bound))))
    (rebuild forms (p/code-list-done out))))
(defn local [(form Code) (mapping Code) (bound Code)] (-> Code)
  (let [bindings (p/code-nth form 1) out (p/code-list-new)
        next (p/code-list-new) (mut scope) bound]
    (unless (= (% (p/code-count bindings) 2) 0)
      (p/error "expanded let binding list has odd length") 0)
    (for [i 0 (/ (p/code-count bindings) 2)]
      (let [binder (p/code-nth bindings (* i 2))]
        (p/code-list-push! next binder)
        (p/code-list-push! next (rewrite (p/code-nth bindings (+ (* i 2) 1)) mapping (load scope)))
        (set! scope `(~@(load scope) ~(binder-name binder)))))
    (p/code-list-push! out (p/code-nth form 0))
    (p/code-list-push! out (rebuild bindings (p/code-list-done next)))
    (for [i 2 (p/code-count form)]
      (p/code-list-push! out (rewrite (p/code-nth form i) mapping (load scope))))
    (rebuild form (p/code-list-done out))))
(defn matching [(form Code) (mapping Code) (bound Code)] (-> Code)
  (let [out (p/code-list-new)]
    (p/code-list-push! out (p/code-nth form 0))
    (p/code-list-push! out (rewrite (p/code-nth form 1) mapping bound))
    (for [i 2 (p/code-count form)]
      (let [arm (p/code-nth form i) next (p/code-list-new) (mut scope) bound]
        (unless (and (p/code-list? arm) (and (>= (p/code-count arm) 3)
          (p/code-vector? (p/code-nth arm 1))))
          (p/error "managed syntax requires expanded match arms") 0)
        (p/code-list-push! next (rewrite (p/code-nth arm 0) mapping bound))
        (p/code-list-push! next (p/code-nth arm 1))
        (for [bi 0 (p/code-count (p/code-nth arm 1))]
          (set! scope `(~@(load scope) ~(binder-name (p/code-nth (p/code-nth arm 1) bi)))))
        (for [bi 2 (p/code-count arm)]
          (p/code-list-push! next (rewrite (p/code-nth arm bi) mapping (load scope))))
        (p/code-list-push! out (rebuild arm (p/code-list-done next)))))
    (rebuild form (p/code-list-done out))))
(defn function [(form Code) (mapping Code) (bound Code)] (-> Code)
  (let [out (p/code-list-new) (mut at) -1 (mut scope) bound]
    (for [i (if (head? form `fn*) 1 2) (p/code-count form)]
      (when (p/code-vector? (p/code-nth form i)) (set! at i) (break)))
    (when (< (load at) 0) (p/error "managed function has no parameter vector") 0)
    ; A generic parameter vector precedes the value parameter vector.
    (when (and (< (+ (load at) 1) (p/code-count form))
               (p/code-vector? (p/code-nth form (+ (load at) 1))))
      (let [generic (p/code-nth form (load at))]
        (for [i 0 (p/code-count generic)]
          (set! scope `(~@(load scope) ~(binder-name (p/code-nth generic i))))))
      (set! at (+ (load at) 1)))
    (for [i 0 (load at)] (p/code-list-push! out (p/code-nth form i)))
    (let [params (p/code-nth form (load at)) next (p/code-list-new)]
      (for [i 0 (p/code-count params)]
        (let [param (p/code-nth params i)]
          (if (p/code-sym? param)
            (do (p/code-list-push! next param)
                (set! scope `(~@(load scope) ~param)) 0)
            (let [positional (and (p/code-list? param) (and (= (p/code-count param) 3)
                                    (p/code-eq (p/code-nth param 0) `:positional)))
                  at (if positional 1 0)]
              (unless (and (p/code-list? param) (= (p/code-count param) (+ at 2)))
                (p/error "managed syntax requires expanded function parameters") 0)
              (p/code-list-push! next (rebuild param
                (if positional
                  `(:positional ~(p/code-nth param at) ~(rewrite (p/code-nth param (+ at 1)) mapping (load scope)))
                  `(~(p/code-nth param at) ~(rewrite (p/code-nth param (+ at 1)) mapping (load scope))))))
              (set! scope `(~@(load scope) ~(binder-name (p/code-nth param at))))))))
      (p/code-list-push! out (rebuild params (p/code-list-done next))))
    (for [i (+ (load at) 1) (p/code-count form)]
      (p/code-list-push! out (rewrite (p/code-nth form i) mapping (load scope))))
    (rebuild form (p/code-list-done out))))
(defn rewrite [(form Code) (mapping Code) (bound Code)] (-> Code)
  (cond (p/code-sym? form) (reference form mapping bound)
        (not (p/code-list? form)) form
        (= (p/code-count form) 0) form
        (or (head? form `quote) (head? form `quasiquote)) form
        (or (head? form `let*) (head? form `let)) (local form mapping bound)
        (head? form `match) (matching form mapping bound)
        (or (head? form `fn*) (or (head? form `defn*) (head? form `defn))) (function form mapping bound)
        (head? form `field)
          (rebuild form `(field ~(rewrite (p/code-nth form 1) mapping bound) ~(p/code-nth form 2)))
        :else (sequence form 0 mapping bound)))
