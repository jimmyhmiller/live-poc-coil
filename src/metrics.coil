(module live-poc-coil.metrics)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.sync" :as sync)
(import "coil.result" :use *)
(extern CACurrentMediaTime :cc c [] (-> f64))
(defstruct FrameContext [(active bool) (visible bool) (width i64) (height i64)
  (scale f64) (duration f64)])
(defstruct Sample [(revision i64) (received f64) (compile-start f64)
  (compile-end f64) (maintenance-end f64) (published f64) (draw-start f64) (presented f64) (frame FrameContext)])
(defstruct Metrics [(mutex sync/Mutex) (samples (al/ArrayList Sample))])
(defn state [] (-> (ptr Metrics)) (p/alloc-static Metrics))
(defn now [] (-> f64) (CACurrentMediaTime))
(defn lock! [] (-> i64)
  (match (sync/mutex-lock! (field (state) mutex)) (Ok [n] n) (Err [_] (a/oom-at c"metrics lock" 0))))
(defn unlock! [] (-> i64)
  (match (sync/mutex-unlock! (field (state) mutex)) (Ok [n] n) (Err [_] (a/oom-at c"metrics unlock" 0))))
(defn init! [] (-> i64)
  (match (sync/mutex-init (field (state) mutex)) (Ok [_] 0) (Err [_] (a/oom-at c"metrics mutex" 0)))
  (set! (.samples (state)) (al/al-new [Sample] (a/malloc-allocator)))
  (al/al-push! (field (state) samples) (p/zeroed Sample))
  0)
(defn reserve! [] (-> i64)
  (lock!)
  (let [samples (field (state) samples)]
    (when (= (.len samples) (.cap samples))
      (al/al-reserve! samples (if (= (.cap samples) 0) 4 (* (.cap samples) 2)))))
  (unlock!))
(defn record! [(revision i64) (received f64) (start f64) (end f64) (published f64)] (-> i64)
  (lock!)
  (assert (= revision (al/al-len (.samples (state)))))
  (al/al-push! (field (state) samples)
    (Sample :revision revision :received received :compile-start start :compile-end end :maintenance-end 0.0
      :published published :draw-start 0.0 :presented 0.0 :frame (p/zeroed FrameContext)))
  (unlock!))
(defn draw! [(revision i64)] (-> i64)
  (lock!)
  (when (< revision (al/al-len (.samples (state))))
    (let [s (al/al-elem (field (state) samples) revision)]
      (when (<= (.draw-start s) 0.0) (set! (.draw-start s) (now)))))
  (unlock!))
(defn presented-context! [(revision i64) (timestamp f64) (context FrameContext)] (-> i64)
  (lock!)
  (when (and (> timestamp 0.0) (< revision (al/al-len (.samples (state)))))
    (let [s (al/al-elem (field (state) samples) revision)]
      (when (or (<= (.presented s) 0.0) (< timestamp (.presented s)))
        (set! (.presented s) timestamp)
        (set! (.frame s) context))))
  (unlock!))
(defn presented! [(revision i64) (timestamp f64)] (-> i64)
  (presented-context! revision timestamp (p/zeroed FrameContext)))
(defn get-sample [(revision i64)] (-> Sample)
  (lock!)
  (let [s (if (and (>= revision 0) (< revision (al/al-len (.samples (state)))))
            (al/al-get (.samples (state)) revision) (p/zeroed Sample))]
    (unlock!)
    (load s)))
(defn destroy! [] (-> i64)
  (al/al-free! (field (state) samples))
  (match (sync/mutex-destroy! (field (state) mutex)) (Ok [n] n) (Err [_] -1)))

(defn pending? [(revision i64)] (-> bool)
  (let [sample (get-sample revision)] (<= (.presented sample) 0.0)))
(export-c [pending? :as "lpc_frame_pending"])

(defn maintained! [(revision i64)] (-> i64)
  (lock!)
  (let [sample (al/al-elem [Sample] (field (state) samples) revision)]
    (set! (.maintenance-end sample) (now)))
  (unlock!))
