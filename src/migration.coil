(module live-poc-coil.migration)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice)
(import "live-poc-coil.relocation" :as relocation)

;;; Runtime lifecycle for one concrete value shape. Implementations compose:
;;; aggregate policies invoke the policy of each live child. Clone and migration
;;; always construct independent ownership so a failed transaction can discard
;;; its shadow without touching the accepted value.
(deftrait ValuePolicy [Self]
  (clone-value [(old (ref Self)) (next (mut Self))
                (journal (ptr relocation/Journal))] (-> i64))
  (rewrite-value [(value (mut Self))
                  (journal (ptr relocation/Journal))] (-> i64))
  (abort-value [(value (mut Self))] (-> void))
  (retire-value [(value (mut Self))] (-> void)))

;;; One directed schema edge. Old is an associated type selected by the concrete
;;; destination policy. Generated physical record and sum versions implement this
;;; automatically; generic owners such as ArrayList implement it once and recurse.
(deftrait Migration [Self Old]
  (migrate-value [(next (mut Self)) (old (ref Old))
                  (journal (ptr relocation/Journal))] (-> i64)))

;;; These generic entry points make the policy's Self type explicit before trait
;;; dispatch. That matters for pointer-shaped values: the pointer passed as the
;;; mutable place is storage for T, not itself the policy receiver `(ptr T)`.
(defn clone! [(T ValuePolicy)] [(old (ref T)) (next (mut T))
  (journal (ptr relocation/Journal))] (-> i64)
  (clone-value old (mut next) journal))
(defn rewrite! [(T ValuePolicy)] [(value (mut T))
  (journal (ptr relocation/Journal))] (-> i64)
  (rewrite-value (mut value) journal))
(defn abort! [(T ValuePolicy)] [(value (mut T))] (-> void)
  (abort-value (mut value)))
(defn retire! [(T ValuePolicy)] [(value (mut T))] (-> void)
  (retire-value (mut value)))

(defn leaf-policy [(T Code)] (-> Code)
  `(do
     (impl ValuePolicy ~T
       (clone-value [(old (ref ~T)) (next (mut ~T))
                     (journal (ptr relocation/Journal))] (-> i64)
         (store! next (load old)) 0)
       (rewrite-value [(value (mut ~T))
                       (journal (ptr relocation/Journal))] (-> i64) 0)
       (abort-value [(value (mut ~T))] (-> void))
       (retire-value [(value (mut ~T))] (-> void)))
     (impl Migration ~T
       (migrate-value [(next (mut ~T)) (old (ref ~T))
                       (journal (ptr relocation/Journal))] (-> i64)
         (store! next (load old)) 0))))

(leaf-policy bool)
(leaf-policy i8)
(leaf-policy i16)
(leaf-policy i32)
(leaf-policy i64)
(leaf-policy u8)
(leaf-policy u16)
(leaf-policy u32)
(leaf-policy u64)
(leaf-policy f32)
(leaf-policy f64)

;;; Raw pointers and slices are borrowed values. Their pointees are migrated by
;;; the owning allocation; rewrite only changes an address when the journal knows
;;; the corresponding object or allocation range.
(impl [T] ValuePolicy (ptr T)
  (clone-value [(old (ref (ptr T))) (next (mut (ptr T)))
                (journal (ptr relocation/Journal))] (-> i64)
    (store! next (load old)) 0)
  (rewrite-value [(value (mut (ptr T)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (relocation/pointer-if-known! journal (p/llvm-ir (ptr (ptr i8)) [value] "ret $ret $0")))
  (abort-value [(value (mut (ptr T)))] (-> void))
  (retire-value [(value (mut (ptr T)))] (-> void)))

(impl [From New] Migration (ptr New)
  (migrate-value [(next (mut (ptr New))) (old (ref (ptr From)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (store! next (p/cast (ptr New) (load old))) 0))

(impl [T] ValuePolicy (slice T)
  (clone-value [(old (ref (slice T))) (next (mut (slice T)))
                (journal (ptr relocation/Journal))] (-> i64)
    (store! next (load old)) 0)
  (rewrite-value [(value (mut (slice T)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (relocation/slice-if-known! journal
      (p/llvm-ir (ptr (ptr i8)) [value] "ret $ret $0")
      (slice/slice-len (load value))
      (p/sizeof T)))
  (abort-value [(value (mut (slice T)))] (-> void))
  (retire-value [(value (mut (slice T)))] (-> void)))

(impl [From New] Migration (slice New)
  (migrate-value [(next (mut (slice New))) (old (ref (slice From)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (store! next
      (slice/slice-new (p/cast (ptr New) (slice/slice-data (load old)))
        (slice/slice-len (load old)))) 0))

(defn list-header-valid? [T] [(value (ref (al/ArrayList T)))] (-> bool)
  (let [length (.len value) capacity (.cap value) data (.data value)]
    (and (>= length 0)
      (and (>= capacity length)
        (if (= capacity 0)
          (= (p/cast i64 data) 0)
          (!= (p/cast i64 data) 0))))))

(defn list-release-storage! [T] [(value (ptr (al/ArrayList T)))] (-> void)
  (let [capacity (.cap value) allocator (.alc value)]
    (when (> capacity 0)
      (match (a/request [T] capacity)
        (Some [request]
          (a/raw-free allocator (p/cast (ptr i8) (.data value)) request))
        (None [] (assert false))))
    (store! value
      (al/ArrayList :data (p/cast (ptr T) 0) :len 0 :cap 0 :alc allocator))))

(defn list-abort-prefix! [(T ValuePolicy)]
  [(value (ptr (al/ArrayList T)))] (-> void)
  (let [length (.len value)]
    (for [i 0 length]
      (abort! [T] (p/index (.data value) i)))
    (list-release-storage! [T] value)))

(impl [(T ValuePolicy)] ValuePolicy (al/ArrayList T)
  (clone-value [(old (ref (al/ArrayList T)))
                (next (mut (al/ArrayList T)))
                (journal (ptr relocation/Journal))] (-> i64)
    (block :done
      (unless (list-header-valid? old) (break :done -1))
      (let [length (.len old) capacity (.cap old) allocator (.alc old)]
        (store! next
          (al/ArrayList :data (p/cast (ptr T) 0) :len 0 :cap 0 :alc allocator))
        (when (= capacity 0) (break :done 0))
        (match (a/request [T] capacity)
          (None [] (break :done -1))
          (Some [request]
            (match (a/raw-alloc allocator request)
              (None [] (break :done -4))
              (Some [raw]
                (do
                  (store! next
                    (al/ArrayList :data (p/cast (ptr T) raw)
                      :len 0 :cap capacity :alc allocator))
                  (when (!= (relocation/elements! journal
                              (p/cast (ptr i8) (.data old)) capacity (p/sizeof T)
                              raw capacity (p/sizeof T)) 0)
                    (list-release-storage! [T] next)
                    (break :done -1))
                  (for [i 0 length]
                    (let [status (clone! [T]
                                   (p/index (.data old) i)
                                   (p/index (.data next) i)
                                   journal)]
                      (when (!= status 0)
                        (list-abort-prefix! [T] next)
                        (break :done status))
                      (set! (.len next) (+ i 1))))
                  0))))))))
  (rewrite-value [(value (mut (al/ArrayList T)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (block :done
      (for [i 0 (.len value)]
        (let [status (rewrite! [T] (p/index (.data value) i) journal)]
          (when (!= status 0) (break :done status))))
      0))
  (abort-value [(value (mut (al/ArrayList T)))] (-> void)
    (list-abort-prefix! [T] value))
  (retire-value [(value (mut (al/ArrayList T)))] (-> void)
    (for [i 0 (.len value)]
      (retire! [T] (p/index (.data value) i)))
    (list-release-storage! [T] value)))

(impl [From (New (Migration From) ValuePolicy)] Migration (al/ArrayList New)
  (migrate-value [(next (mut (al/ArrayList New)))
                  (old (ref (al/ArrayList From)))
                  (journal (ptr relocation/Journal))] (-> i64)
    (block :done
      (unless (list-header-valid? old) (break :done -1))
      (let [length (.len old) capacity (.cap old) allocator (.alc old)]
        (store! next
          (al/ArrayList :data (p/cast (ptr New) 0) :len 0 :cap 0 :alc allocator))
        (when (= capacity 0) (break :done 0))
        (match (a/request [New] capacity)
          (None [] (break :done -1))
          (Some [request]
            (match (a/raw-alloc allocator request)
              (None [] (break :done -4))
              (Some [raw]
                (do
                  (store! next
                    (al/ArrayList :data (p/cast (ptr New) raw)
                      :len 0 :cap capacity :alc allocator))
                  (when (!= (relocation/elements! journal
                              (p/cast (ptr i8) (.data old)) capacity (p/sizeof From)
                              raw capacity (p/sizeof New)) 0)
                    (list-release-storage! [New] next)
                    (break :done -1))
                  (for [i 0 length]
                    (let [status (migrate-value
                                   (mut (p/index (.data next) i))
                                   (p/index (.data old) i)
                                   journal)]
                      (when (!= status 0)
                        (list-abort-prefix! [New] next)
                        (break :done status))
                      (set! (.len next) (+ i 1))))
                  0)))))))))

;;; Aggregate lifecycle is derived from the compiler's type registry.  The
;;; generated implementation contains no knowledge of particular field types:
;;; every child is handled through ValuePolicy, so user records, generic
;;; containers, and records nested inside either compose by ordinary trait
;;; selection.
(defn policy-bounds [(T Code)] (-> Code)
  (let [out (p/code-list-new)]
    (when (p/code-list? T)
      (for [i 1 (p/code-count T)]
        (p/code-list-push! out `(~(p/code-nth T i) ValuePolicy))))
    (p/code-list-done out)))

(defn struct-policy [(T Code)] (-> Code)
  (let [old (p/fresh-identifier "policy-old") next (p/fresh-identifier "policy-next")
        value (p/fresh-identifier "policy-value") journal (p/fresh-identifier "policy-journal")
        prefix (p/fresh-identifier "policy-prefix") clones (p/code-list-new)
        cleanup (p/code-list-new) rewrites (p/code-list-new)
        aborts (p/code-list-new) retires (p/code-list-new)
        count (p/code-field-count T)]
    (for [i 0 count]
      (let [name (p/code-field-name T i) type (p/code-field-type T i)
            status (p/fresh-identifier "policy-status")]
        (p/code-list-push! clones
          `(let [~status (clone! [~type] (field ~old ~name) (mut (field ~next ~name)) ~journal)]
             (if (!= ~status 0) (break :failed ~status) 0)
             (store! ~prefix ~(+ i 1))))
        (p/code-list-push! cleanup
          `(if (> (load ~prefix) ~i)
             (do (abort! [~type] (mut (field ~next ~name))) 0)
             0))
        (p/code-list-push! rewrites
          `(let [~status (rewrite! [~type] (mut (field ~value ~name)) ~journal)]
             (if (!= ~status 0) (break :done ~status) 0)))
        (p/code-list-push! aborts `(abort! [~type] (mut (field ~value ~name))))
        (p/code-list-push! retires `(retire! [~type] (mut (field ~value ~name))))))
    (let [body
      `(impl ~@(if (p/code-list? T) `([~@(policy-bounds T)]) '()) ValuePolicy ~T
         (clone-value [(~old (ref ~T)) (~next (mut ~T))
                       (~journal (ptr relocation/Journal))] (-> i64)
           (store! ~next (p/zeroed ~T))
           (let [(mut ~prefix) 0
                 result (block :failed ~@(p/code-list-done clones) 0)]
             (when (!= result 0) ~@(p/code-list-done cleanup))
             result))
         (rewrite-value [(~value (mut ~T))
                         (~journal (ptr relocation/Journal))] (-> i64)
           (block :done ~@(p/code-list-done rewrites) 0))
         (abort-value [(~value (mut ~T))] (-> void)
           (do ~@(p/code-list-done aborts)))
         (retire-value [(~value (mut ~T))] (-> void)
           (do ~@(p/code-list-done retires))))]
      body)))

(defn sum-policy-binds [(T Code) (vi i64) (count i64)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 count]
      (p/code-list-push! out
        (p/fresh-identifier (p/code-variant-field-name T vi i))))
    (p/code-list-done out)))

(defn policy-type-param? [(T Code) (type Code)] (-> bool)
  (block :found
    (when (p/code-list? T)
      (for [i 1 (p/code-count T)]
        (when (p/code-eq (p/code-nth T i) type) (break :found true))))
    false))

(defn sum-policy-value [(T Code) (type Code) (binder Code)] (-> Code)
  (let [shape (p/code-type-shape type)]
    (if (or (policy-type-param? T type)
            (or (p/code-eq shape `struct) (p/code-eq shape `sum)))
      `(load ~binder)
      binder)))

(defn sum-policy-constructor [(T Code) (vi i64) (values Code)] (-> Code)
  (if (p/code-list? T)
    `(~(p/code-variant-qname T vi)
      [~@(let [out (p/code-list-new)]
            (for [i 1 (p/code-count T)] (p/code-list-push! out (p/code-nth T i)))
            (p/code-list-done out))]
      ~@values)
    `(~(p/code-variant-qname T vi) ~@values)))

(defn sum-policy-arm [(T Code) (vi i64) (operation i64)
  (place Code) (journal Code)] (-> Code)
  (let [count (p/code-variant-fields T vi) binds (sum-policy-binds T vi count)
        locals (p/code-list-new) values (p/code-list-new) steps (p/code-list-new)
        cleanup (p/code-list-new) prefix (p/fresh-identifier "sum-prefix")]
    (for [i 0 count]
      (let [type (p/code-variant-field-type T vi i)
            local (p/fresh-identifier "sum-field") status (p/fresh-identifier "sum-status")]
        (p/code-list-push! locals `(mut ~local))
        (p/code-list-push! locals
          (if (= operation 0) `(p/zeroed ~type)
            (sum-policy-value T type (p/code-nth binds i))))
        (p/code-list-push! values `(load (mut ~local)))
        (cond (= operation 0)
          (do
            (p/code-list-push! steps
              `(let [~status (clone! [~type] ~(p/code-nth binds i) (mut ~local) ~journal)]
                 (if (!= ~status 0) (break :sum-done ~status) 0)
                 (store! ~prefix ~(+ i 1))))
            (p/code-list-push! cleanup
              `(if (> (load ~prefix) ~i) (do (abort! [~type] (mut ~local)) 0) 0)) 0)
          (= operation 1)
          (do (p/code-list-push! steps
                `(let [~status (rewrite! [~type] (mut ~local) ~journal)]
                   (if (!= ~status 0) (break :sum-done ~status) 0))) 0)
          (= operation 2) (do (p/code-list-push! steps `(abort! [~type] (mut ~local))) 0)
          :else (do (p/code-list-push! steps `(retire! [~type] (mut ~local))) 0))))
    `(~(p/code-variant-qname T vi) [~@binds]
      (let [~@(p/code-list-done locals) (mut ~prefix) 0]
        ~(cond (= operation 0)
          `(let [result (block :sum-done ~@(p/code-list-done steps) 0)]
             (if (!= result 0)
               (do ~@(p/code-list-done cleanup) result)
               (do (store! ~place ~(sum-policy-constructor T vi (p/code-list-done values))) 0)))
          (= operation 1)
          `(let [result (block :sum-done ~@(p/code-list-done steps) 0)]
             (if (!= result 0) result
               (do (store! ~place ~(sum-policy-constructor T vi (p/code-list-done values))) 0)))
          :else `(do ~@(p/code-list-done steps)))))))

(defn sum-policy-arms [(T Code) (operation i64) (place Code) (journal Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [vi 0 (p/code-variant-count T)]
      (p/code-list-push! out (sum-policy-arm T vi operation place journal)))
    (p/code-list-done out)))

(defn sum-policy [(T Code)] (-> Code)
  (let [old (p/fresh-identifier "sum-old") next (p/fresh-identifier "sum-next")
        value (p/fresh-identifier "sum-value") journal (p/fresh-identifier "sum-journal")]
    `(impl ~@(if (p/code-list? T) `([~@(policy-bounds T)]) '()) ValuePolicy ~T
        (clone-value [(~old (ref ~T)) (~next (mut ~T))
                      (~journal (ptr relocation/Journal))] (-> i64)
          (match (load ~old) ~@(sum-policy-arms T 0 next journal)))
        (rewrite-value [(~value (mut ~T))
                        (~journal (ptr relocation/Journal))] (-> i64)
          (match (load ~value) ~@(sum-policy-arms T 1 value journal)))
        (abort-value [(~value (mut ~T))] (-> void)
          (match (load ~value) ~@(sum-policy-arms T 2 value journal)))
      (retire-value [(~value (mut ~T))] (-> void)
        (match (load ~value) ~@(sum-policy-arms T 3 value journal))))))

(defderive ValuePolicy
  (struct [T] (struct-policy T))
  (sum [T] (sum-policy T)))

(export ValuePolicy Migration clone! rewrite! abort! retire! migrate-value)
