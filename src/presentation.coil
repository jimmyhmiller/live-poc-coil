;;; Native callback ownership. Metal may deliver or discard a drawable after the
;;; live session closes. Its copied Block owns this context, never JIT code or
;;; application state. Retiring an observer closes access to session metrics.
(module live-poc-coil.presentation)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.slice" :as slice)
(import "coil.atomic" :as atomic)
(import "coil.sync" :as sync)
(import "coil.result" :use *)
(import "live-poc-coil.metrics" :as metrics)
(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern sel_registerName :cc c [(ptr i8)] (-> (ptr i8)))
(import "paper.objc" :as objc)
(defstruct Observer [(references i64) (mutex sync/Mutex) (active bool)])
(defstruct Sample [(references i64) (observer (ptr Observer)) (revision i64) (frame metrics/FrameContext)])
(defstruct Descriptor [(reserved u64) (size u64)
  (copy (fnptr c [(ptr i8) (ptr i8)] void))
  (dispose (fnptr c [(ptr i8)] void)) (signature (ptr i8))])
(defstruct Block [(isa (ptr i8)) (flags i32) (reserved i32)
  (invoke (fnptr c [(ptr Block) (ptr i8)] void))
  (descriptor (ptr Descriptor)) (sample (ptr Sample))])
(defn observer-count [] (-> (ptr i64)) (p/alloc-static i64))
(defn sample-count [] (-> (ptr i64)) (p/alloc-static i64))
(defn free-one! [T] [(value (ptr T))] (-> i64)
  (a/free (a/malloc-allocator) (slice/slice-new value 1)))
(defn lock! [(o (ptr Observer))] (-> i64)
  (match (sync/mutex-lock! (field o mutex)) (Ok [n] n) (Err [_] (a/oom-at c"observer lock" 0))))
(defn unlock! [(o (ptr Observer))] (-> i64)
  (match (sync/mutex-unlock! (field o mutex)) (Ok [n] n) (Err [_] (a/oom-at c"observer unlock" 0))))
(defn observer-new [] (-> (ptr Observer))
  (let [o (a/box! (a/malloc-allocator) Observer (p/zeroed Observer))]
    (set! (.references o) 1)
    (set! (.active o) true)
    (match (sync/mutex-init (field o mutex)) (Ok [_] 0) (Err [_] (a/oom-at c"observer mutex" 0)))
    (atomic/atomic-add (observer-count) 1)
    o))
(defn observer-release! [(o (ptr Observer))] (-> i64)
  (when (= (atomic/atomic-sub (field o references) 1) 1)
    (match (sync/mutex-destroy! (field o mutex)) (Ok [_] 0) (Err [_] (assert false)))
    (free-one! o)
    (atomic/atomic-sub (observer-count) 1)
    0)
  0)
(defn observer-retire! [(o (ptr Observer))] (-> i64)
  (lock! o)
  (set! (.active o) false)
  (unlock! o)
  (observer-release! o))
(defn sample-new [(o (ptr Observer)) (revision i64)] (-> (ptr Sample))
  (atomic/atomic-add (field o references) 1)
  (atomic/atomic-add (sample-count) 1)
  (a/box! (a/malloc-allocator) Sample (Sample :references 1 :observer o :revision revision :frame (p/zeroed metrics/FrameContext))))
(defn sample-release! [(s (ptr Sample))] (-> i64)
  (when (= (atomic/atomic-sub (field s references) 1) 1)
    (observer-release! (.observer s))
    (free-one! s)
    (atomic/atomic-sub (sample-count) 1)
    0)
  0)
(defn deliver! [(s (ptr Sample)) (timestamp f64)] (-> i64)
  (let [o (.observer s)]
    (lock! o)
    (when (.active o) (metrics/presented-context! (.revision s) timestamp (.frame s)))
    (unlock! o)))
(defn copied [(destination (ptr i8)) (source (ptr i8))] (-> void)
  (let [s (.sample (p/cast (ptr Block) destination))]
    (atomic/atomic-add (field s references) 1)))
(defn disposed [(closure (ptr i8))] (-> void)
  (sample-release! (.sample (p/cast (ptr Block) closure))))
(defn invoked [(closure (ptr Block)) (drawable (ptr i8))] (-> void)
  (deliver! (.sample closure) (objc/msg f64 drawable (objc/sel c"presentedTime") [])))
(defn init-block! [(closure (ptr Block)) (sample (ptr Sample))] (-> i64)
  (let [descriptor (p/alloc-static Descriptor)]
    ; Initialized by the single presentation producer before any copy.
    (when (= (.size descriptor) (p/cast u64 0))
    (set! descriptor (Descriptor :reserved 0 :size (p/cast u64 (p/sizeof Block))
      :copy (p/fnptr-of copied) :dispose (p/fnptr-of disposed) :signature c"v16@?0@8"))
      0)
    (set! closure (Block :isa (dlsym (p/cast (ptr i8) -2) c"_NSConcreteStackBlock")
      :flags 0x42000000 :reserved 0 :invoke (p/fnptr-of invoked) :descriptor descriptor :sample sample))
    (assert (!= (p/cast i64 (.isa closure)) 0))
    0))
