(module live-poc-coil.transitions)
(import "coil.primitive" :as p)
(import "live-poc-coil.policy-state" :as policy)
(import "live-poc-coil.schema-records" :as records)
(import "live-poc-coil.syntax-rewrite" :as syntax)

;;; A transition certificate binds authored syntax to an exact accepted source
;;; version and proposed destination version. Re-reading the declaration does
;;; not silently authorize it for another edge.
;;; (field source-version destination-version old-type new-type binder body source)
(defn declaration? [(form Code)] (-> bool) (syntax/head? form `migrate))
(defn certificates [(record Code)] (-> Code)
  (if (> (p/code-count record) 7) (p/code-nth record 7) '()))
(defn field-index [(fields Code) (name Code)] (-> i64)
  (block :found
    (for [i 0 (p/code-count fields)]
      (when (p/code-eq (p/code-nth (p/code-nth fields i) 0) name) (break :found i)))
    -1))
(defn certificate-index [(items Code) (field Code)] (-> i64)
  (block :found
    (for [i 0 (p/code-count items)]
      (when (p/code-eq (p/code-nth (p/code-nth items i) 0) field) (break :found i)))
    -1))
(defn for-edge [(record Code) (prior Code) (field Code)] (-> Code)
  (let [items (certificates record) index (certificate-index items field)]
    (if (< index 0) '()
      (let [item (p/code-nth items index)]
        (if (and (p/code-eq (p/code-nth item 1) (p/code-nth prior 3))
                 (p/code-eq (p/code-nth item 2) (p/code-nth record 3))) item '())))))
(defn propose! [(state (ptr Code)) (prior Code) (module Code) (form Code)] (-> i64)
  (unless (and (>= (p/code-count form) 5)
    (and (p/code-sym? (p/code-nth form 1))
      (and (p/code-sym? (p/code-nth form 2)) (p/code-sym? (p/code-nth form 3)))))
    (p/error "field transition requires (migrate Type field old expression ...)") 0)
  (let [schemas (policy/schemas (load state)) name (p/code-nth form 1) field (p/code-nth form 2)
        index (records/lookup schemas module name)
        old-index (records/lookup (policy/schemas prior) module name)]
    (when (or (< index 0) (< old-index 0))
      (p/error "field transition requires an accepted managed schema") 0)
    (let [record (p/code-nth schemas index) old (p/code-nth (policy/schemas prior) old-index)
          items (certificates old) known (certificate-index items field)]
      (block :done
        (when (>= known 0)
          (when (p/code-eq (p/code-nth (p/code-nth items known) 7) form) (break :done 0)))
        (when (p/code-eq (p/code-nth record 3) (p/code-nth old 3))
          (p/error "a new field transition requires a proposed schema change") 0)
        (let [from (field-index (p/code-nth old 5) field)
              to (field-index (p/code-nth record 5) field) body (p/code-list-new)]
          (when (or (< from 0) (< to 0))
            (p/error "field transition requires the field in both source and destination schemas") 0)
          (for [i 4 (p/code-count form)] (p/code-list-push! body (p/code-nth form i)))
          (let [certificate `(~field ~(p/code-nth old 3) ~(p/code-nth record 3)
                  ~(p/code-nth (p/code-nth (p/code-nth old 5) from) 1)
                  ~(p/code-nth (p/code-nth (p/code-nth record 5) to) 1)
                  ~(p/code-nth form 3) (do ~@(p/code-list-done body)) ~form)
                current (certificates record) at (certificate-index current field)
                next (records/replace current (if (< at 0) (p/code-count current) at) certificate)]
            (store! state (policy/with-state (load state)
              (records/replace schemas index (records/replace record 7 next))
              (policy/roots (load state)))))) 0))))
