(module live-poc-coil.runtime)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice)
(import "coil.sync" :as sync)
(import "coil.atomic" :as atomic)
(import "coil.time" :as time)
(import "coil.result" :use *)

(cimport "pthread.h"
         :use
         [pthread_key_create
          pthread_key_delete
          pthread_getspecific
          pthread_setspecific])

;;; An Image owns exactly one JIT generation lease. The compiler lane releases
;;; it only after every entry in every live view stops referring to this image.
(defstruct Image [(token i64) (references i64)])

(defstruct Entry [(address (ptr i8)) (image (ptr Image)) (condition i64) (direct i64) (opaque bool)])

(defstruct Dependency [(from i64) (to i64)])

(defstruct View [(revision i64) (readers i64) (entries (al/ArrayList Entry)) (dependencies (al/ArrayList Dependency))])

(defstruct Runtime
  [(mutex sync/Mutex)
   (current (ptr View))
   (views (al/ArrayList (ptr View)))
   (images (al/ArrayList (ptr Image)))
   (key u64)
   (quiescence sync/Event)
   (layout-closed bool)
   (closed bool)])

(defn lock! [(r (ptr Runtime))] (-> i64)
  (match (sync/mutex-lock! (field r mutex))
    (Ok [n] n)
    (Err [_] (a/oom-at c"live mutex lock" 0))))

(defn unlock! [(r (ptr Runtime))] (-> i64)
  (match (sync/mutex-unlock! (field r mutex))
    (Ok [n] n)
    (Err [_] (a/oom-at c"live mutex unlock" 0))))

(defn free-one! [T] [(value (ptr T))] (-> i64)
  (a/free [T] (a/malloc-allocator) (slice/slice-new value 1)))

(defn view-new [(revision i64)] (-> (ptr View))
  (a/box! (a/malloc-allocator)
          View
          (View
            :revision revision
            :readers 0
            :entries (al/al-new [Entry] (a/malloc-allocator))
            :dependencies (al/al-new [Dependency] (a/malloc-allocator)))))

(defn init! [(r (ptr Runtime))] (-> i64)
  (store! r (p/zeroed Runtime))
  (match (sync/mutex-init (field r mutex))
    (Err [_] -1)
    (Ok [_]
        (if (!= (pthread_key_create (field r key)
                                    (p/cast (fnptr c [(ptr i8)] void)
                                            (p/cast (ptr i8) 0)))
                0)
            (do (sync/mutex-destroy! (field r mutex)) -2)
            (do
              (match (sync/event-init (field r quiescence))
                (Ok [_] 0) (Err [_] (a/oom-at c"layout quiescence event" 0)))
              (set! (.views r) (al/al-new [(ptr View)] (a/malloc-allocator)))
              (set! (.images r) (al/al-new [(ptr Image)] (a/malloc-allocator)))
              (set! (.current r) (view-new 0))
              (al/al-push! (field r views) (.current r))
              0)))))

;;; Caller holds the compiler lane; view entries never mutate after publication.
(defn clone-current! [(r (ptr Runtime))] (-> (ptr View))
  (lock! r)
  (let [v (view-new (+ (.revision (.current r)) 1))
        old (.current r)]
    (for [i 0 (al/al-len (.entries old))]
      (let [e (al/al-get (.entries old) i)]
        (when (!= (p/cast i64 (.image e)) 0)
          (set! (.references (.image e)) (+ (.references (.image e)) 1)))
        (al/al-push! (field v entries) e)))
    (for [i 0 (al/al-len (.dependencies old))]
      (al/al-push! (field v dependencies) (al/al-get (.dependencies old) i)))
    (unlock! r)
    v))

(defn stage! [(v (ptr View)) (id i64) (address (ptr i8))] (-> i64)
  (if (or (< id 0) (> id 65535))
      -1
      (do
        (let [(mut kept) 0]
          (for [i 0 (al/al-len (.dependencies v))]
            (let [edge (al/al-get (.dependencies v) i)]
              (when (!= (.from edge) id)
                (al/al-set! (field v dependencies) (load kept) edge)
                (set! kept (+ (load kept) 1)) 0)))
          (set! (.len (field v dependencies)) (load kept)))
        (loop (if (> (al/al-len (.entries v)) id)
                  (break)
                  (al/al-push! (field v entries) (p/zeroed Entry))))
        (let [e (al/al-elem (field v entries) id)]
          (when (!= (p/cast i64 (.image e)) 0)
            (set! (.references (.image e)) (- (.references (.image e)) 1)))
          (store! e
                  (Entry
                    :address address
                    :image (p/cast (ptr Image) 0)
                    :condition 0 :direct 0 :opaque false)))
        0)))

(defn dependency! [(v (ptr View)) (from i64) (to i64)] (-> i64)
  (assert (and (>= from 0) (< from (al/al-len (.entries v)))))
  (assert (and (>= to 0) (< to 65536)))
  (block :added
    (for [i 0 (al/al-len (.dependencies v))]
      (let [edge (al/al-get (.dependencies v) i)]
        (when (and (= (.from edge) from) (= (.to edge) to)) (break :added 0))))
    (al/al-push! (field v dependencies) (Dependency :from from :to to))
    0))

;;; A failed body has no callable address in the new view. Readers of an old
;;; view retain their own entry and image lease until their invocation ends.
(defn block! [(v (ptr View)) (id i64) (condition i64)] (-> i64)
  (assert (> condition 0))
  (let [status (stage! v id (p/cast (ptr i8) 0))]
    (when (= status 0)
      (let [entry (al/al-elem [Entry] (field v entries) id)]
        (set! (.direct entry) condition)
        (set! (.condition entry) condition)))
    status))
(defn opaque! [(v (ptr View)) (id i64)] (-> i64)
  (let [entry (al/al-elem [Entry] (field v entries) id)] (set! (.opaque entry) true))
  0)
(defn propagate! [(v (ptr View))] (-> i64)
  (let [(mut first-blocked) 0]
    (for [i 0 (al/al-len (.entries v))]
      (let [entry (al/al-get (.entries v) i)]
        (when (> (.direct entry) 0) (set! first-blocked (.direct entry)) (break))))
    (for [i 0 (al/al-len (.entries v))]
      (let [entry (al/al-elem [Entry] (field v entries) i)]
        (set! (.condition entry)
          (if (and (.opaque entry) (= (.direct entry) 0)) (load first-blocked) (.direct entry))))))
  (let [(mut changed) true]
    (loop
      (unless (load changed) (break))
      (set! changed false)
      (for [i 0 (al/al-len (.dependencies v))]
        (let [edge (al/al-get (.dependencies v) i)]
          (assert (< (.to edge) (al/al-len (.entries v))))
          (let [from (al/al-elem [Entry] (field v entries) (.from edge))
                to (al/al-elem [Entry] (field v entries) (.to edge))]
            (when (and (= (.condition from) 0) (!= (.condition to) 0))
              (set! (.condition from) (.condition to)) (set! changed true) 0))))))
  0)

;;; The staged code is still private. Reserve its exact generation ownership
;;; before making a pointer visible to any application invocation.
(defn reserve-publication! [(r (ptr Runtime))] (-> i64)
  (let [images (field r images) views (field r views)]
    (when (= (.len images) (.cap images))
      (al/al-reserve! images (if (= (.cap images) 0) 4 (* (.cap images) 2))))
    (when (= (.len views) (.cap views))
      (al/al-reserve! views (if (= (.cap views) 0) 4 (* (.cap views) 2))))) 0)
(defn own-reserved! [(r (ptr Runtime)) (v (ptr View)) (image (ptr Image)) (token i64)] (-> i64)
  (assert (> token 0))
  (assert (< (al/al-len (.images r)) (.cap (field r images))))
  (set! (.token image) token)
  (for [i 0 (al/al-len (.entries v))]
    (let [e (al/al-elem (field v entries) i)]
      (when (and (= (p/cast i64 (.image e)) 0) (!= (p/cast i64 (.address e)) 0))
        (set! (.image e) image)
        (set! (.references image) (+ (.references image) 1)))))
  (al/al-push! (field r images) image) 0)
(defn own-staged! [(r (ptr Runtime)) (v (ptr View)) (token i64)] (-> i64)
  (let [image (a/box! (a/malloc-allocator) Image (p/zeroed Image))]
    (reserve-publication! r)
    (own-reserved! r v image token)))

(defn publish! [(r (ptr Runtime)) (v (ptr View))] (-> i64)
  (propagate! v)
  ; Reserve registry storage before acquiring the publication lock.
  (al/al-reserve! (field r views) (+ (al/al-len (.views r)) 1))
  (lock! r)
  (assert (not (.closed r)))
  (assert (= (.revision v) (+ (.revision (.current r)) 1)))
  (al/al-push! (field r views) v)
  (set! (.current r) v)
  (unlock! r)
  0)

;;; An invocation owns a view until leave!, including all nested live calls.
(defn enter! [(r (ptr Runtime))] (-> (ptr View))
  (assert (= (p/cast i64 (pthread_getspecific (.key r))) 0))
  (lock! r)
  (let [v (if (or (.closed r) (.layout-closed r)) (p/cast (ptr View) 0) (.current r))]
    (when (!= (p/cast i64 v) 0) (set! (.readers v) (+ (.readers v) 1)))
    (unlock! r)
    (assert (= (pthread_setspecific (.key r) (p/cast (ptr i8) v)) 0))
    v))

;;; Preflight and pin are one locked operation. Publication cannot slip between
;;; checking a root's dependency closure and choosing its execution view.
;;; A null result owns no view and must not be paired with leave!.
(defn enter-root! [(r (ptr Runtime)) (id i64)] (-> (ptr View))
  (assert (= (p/cast i64 (pthread_getspecific (.key r))) 0))
  (lock! r)
  (let [(mut admitted) (p/cast (ptr View) 0)]
    (unless (or (.closed r) (.layout-closed r))
      (let [v (.current r)]
        (when (and (>= id 0) (< id (al/al-len (.entries v))))
          (let [entry (al/al-get (.entries v) id)]
            (when (and (= (.condition entry) 0) (!= (p/cast i64 (.address entry)) 0))
              (set! (.readers v) (+ (.readers v) 1))
              (set! admitted v))))))
    (unlock! r)
    (assert (= (pthread_setspecific (.key r) (p/cast (ptr i8) (load admitted))) 0))
    (load admitted)))

(defn pinned? [(r (ptr Runtime))] (-> bool)
  (!= (p/cast i64 (pthread_getspecific (.key r))) 0))
(defn blocked? [(r (ptr Runtime))] (-> bool)
  (lock! r)
  (let [(mut blocked) (.layout-closed r)]
    (unless (.closed r)
      (for [i 0 (al/al-len (.entries (.current r)))]
        (let [entry (al/al-get (.entries (.current r)) i)]
          (when (!= (.condition entry) 0) (set! blocked true) (break)))))
    (unlock! r)
    (load blocked)))

(defn leave! [(r (ptr Runtime))] (-> i64)
  (let [v (p/cast (ptr View) (pthread_getspecific (.key r)))]
    (assert (!= (p/cast i64 v) 0))
    (assert (= (pthread_setspecific (.key r) (p/cast (ptr i8) 0)) 0))
    (lock! r)
    (assert (> (.readers v) 0))
    (set! (.readers v) (- (.readers v) 1))
    (let [notify (.layout-closed r)]
      (unlock! r)
      (when notify
        (match (sync/event-notify-all! (field r quiescence))
          (Ok [_] 0) (Err [_] (a/oom-at c"layout completion notification" 0)))))
    0))

;;; A conservative global admission barrier for incompatible layouts. Closing
;;; admission never waits. Only the compiler lane drains, with the mutex released
;;; so native callbacks can finish and the main event loop can return promptly.
(defn close-layout! [(r (ptr Runtime))] (-> i64)
  (assert (not (pinned? r)))
  (lock! r)
  (assert (not (.closed r)))
  (set! (.layout-closed r) true)
  (unlock! r))
(defn reopen-layout! [(r (ptr Runtime))] (-> i64)
  (lock! r)
  (set! (.layout-closed r) false)
  (unlock! r))
(defn drain-layout! [(r (ptr Runtime)) (cancel (ptr i64))] (-> i64)
  (assert (not (pinned? r)))
  (let [duration (match (time/duration-millis 10)
                   (Ok [value] value) (Err [_] (p/zeroed time/Duration)))]
    (block :done
      (loop
        (lock! r)
        (assert (.layout-closed r))
        (let [(mut readers) 0
              generation (match (sync/event-generation (field r quiescence))
                           (Ok [value] value) (Err [_] -1))]
          (assert (>= generation 0))
          (for [i 0 (al/al-len (.views r))]
            (set! readers (+ (load readers) (.readers (al/al-get (.views r) i)))))
          (unlock! r)
          (when (and (!= (p/cast i64 cancel) 0) (!= (atomic/atomic-load cancel) 0))
            (break :done 3))
          (when (= (load readers) 0) (break :done 0))
          (match (sync/event-wait-for! (field r quiescence) generation duration)
            (Ok [_] 0) (Err [_] (break :done -1)))))
      -1)))

(defn resolve [(r (ptr Runtime)) (id i64)] (-> (ptr i8))
  (let [v (p/cast (ptr View) (pthread_getspecific (.key r)))]
    (assert (!= (p/cast i64 v) 0))
    (assert (and (>= id 0) (< id (al/al-len (.entries v)))))
    (let [e (al/al-get (.entries v) id)]
      (assert (= (.condition e) 0))
      (assert (!= (p/cast i64 (.address e)) 0))
      (.address e))))

(defn drop-view! [(v (ptr View))] (-> i64)
  (assert (= (.readers v) 0))
  (for [i 0 (al/al-len (.entries v))]
    (let [e (al/al-get (.entries v) i)]
      (when (!= (p/cast i64 (.image e)) 0)
        (assert (> (.references (.image e)) 0))
        (set! (.references (.image e)) (- (.references (.image e)) 1)))))
  (al/al-free! (field v dependencies))
  (al/al-free! (field v entries))
  (free-one! v))

;;; Detach unpinned views under the lock. JIT release happens afterwards on the
;;; compiler lane; completion and main-thread drawing never acquire that lane.
(defn collect-views! [(r (ptr Runtime))] (-> i64)
  (lock! r)
  (let [(mut kept) 0]
    (for [i 0 (al/al-len (.views r))]
      (let [v (al/al-get (.views r) i)]
        (if (and (!= v (.current r)) (= (.readers v) 0))
            (drop-view! v)
            (do
              (al/al-set! (field r views) (load kept) v)
              (set! kept (+ (load kept) 1))
              0))))
    (set! (.len (field r views)) (load kept)))
  (unlock! r))

(defn close! [(r (ptr Runtime))] (-> bool)
  (lock! r)
  (set! (.closed r) true)
  (let [(mut drained) true]
    (for [i 0 (al/al-len (.views r))]
      (when (> (.readers (al/al-get (.views r) i)) 0) (set! drained false) 0))
    (when (load drained) (set! (.current r) (p/cast (ptr View) 0)))
    (unlock! r)
    (load drained)))

(defn destroy! [(r (ptr Runtime))] (-> i64)
  (assert (.closed r))
  (assert (= (al/al-len (.views r)) 0))
  (assert (= (al/al-len (.images r)) 0))
  (al/al-free! (field r views))
  (al/al-free! (field r images))
  (assert (= (pthread_key_delete (.key r)) 0))
  (sync/event-destroy! (field r quiescence))
  (match (sync/mutex-destroy! (field r mutex)) (Ok [n] n) (Err [_] -1)))
