(module live-poc-coil.graph)
(import "coil.primitive" :as p)
(import "live-poc-coil.fallible-list" :as list)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice)
(import "coil.atomic" :as atomic)
(import "live-poc-coil.relocation" :as relocation)
;;; Internal native policy ABI. Public source adapters must be checked before
;;; reaching it. Preparation constructs independent ownership and advances its
;;; initialized prefix only after each field is safe to abort. No policy may
;;; mutate accepted payloads or perform external effects during preparation.
(defstruct Schema [(logical i64) (version i64) (size i64) (alignment i64) (fields i64)
  (initialize (fnptr c [(ptr i8) (ptr i64)] i64))
  (clone (fnptr c [(ptr i8) (ptr i8) (ptr relocation/Journal) (ptr i64)] i64))
  (rewrite (fnptr c [(ptr i8) (ptr relocation/Journal)] i64))
  (validate (fnptr c [(ptr i8)] i64))
  (abort (fnptr c [(ptr i8) i64] void))
  (retire (fnptr c [(ptr i8)] void))])
(defstruct Edge [(from (ptr Schema)) (to (ptr Schema))
  (prepare (fnptr c [(ptr i8) (ptr i8) (ptr relocation/Journal) (ptr i64)] i64))])
(defstruct Handle [(id i64) (schema (ptr Schema)) (memory (slice u8))])
(defstruct Root [(id i64) (handle (ptr Handle))])
(defstruct Reset [(root i64) (schema (ptr Schema))
  (prepare (fnptr c [(ptr i8) (ptr i8) (ptr relocation/Journal) (ptr i64)] i64))])
(defstruct Staged [(handle (ptr Handle)) (old-schema (ptr Schema)) (next-schema (ptr Schema))
  (old-memory (slice u8)) (next-memory (slice u8)) (initialized i64)
  (prepare (fnptr c [(ptr i8) (ptr i8) (ptr relocation/Journal) (ptr i64)] i64))])
(defstruct Savepoint [(epoch i64) (schemas i64) (edges i64) (handles i64) (roots i64)])
;;; Additional validation for a prepared transaction. The caller owns context
;;; through preparation; a nonzero result aborts the complete shadow graph.
(defstruct Validation [(context (ptr i8))
  (check (fnptr c [(ptr i8) (ptr Schema) (ptr i8)] i64))])
(defn validate-schema [(context (ptr i8)) (schema (ptr Schema)) (payload (ptr i8))] (-> i64)
  (p/call-ptr (.validate schema) payload))
(defstruct Heap [(prepared-validation Validation) (allocator (dyn a/Allocator)) (schemas (al/ArrayList (ptr Schema)))
  (edges (al/ArrayList Edge)) (handles (al/ArrayList (ptr Handle)))
  (roots (al/ArrayList Root))
  (staged (al/ArrayList Staged)) (journal relocation/Journal)
  (epoch i64) (phase i64) (missing-from i64) (missing-to i64) (missing-logical i64)])
;;; phase 0 idle; 1 preparing; 2 validated; 3 published, old ownership to retire.
;;; The session owns serialization and closes/drains layout admission first.
(defn init! [(heap (ptr Heap)) (allocator (dyn a/Allocator))] (-> i64)
  (store! heap (p/zeroed Heap))
  (set! (.prepared-validation heap) (Validation :context (p/cast (ptr i8) 0) :check (p/fnptr-of validate-schema)))
  (set! (.allocator heap) allocator)
  (set! (.schemas heap) (al/al-new [(ptr Schema)] allocator))
  (set! (.edges heap) (al/al-new [Edge] allocator))
  (set! (.handles heap) (al/al-new [(ptr Handle)] allocator))
  (set! (.roots heap) (al/al-new [Root] allocator))
  (set! (.staged heap) (al/al-new [Staged] allocator))
  (relocation/init! (field heap journal) allocator))
(defn payload [(memory (slice u8))] (-> (ptr i8)) (p/cast (ptr i8) (slice/slice-data memory)))
(defn known? [(heap (ptr Heap)) (schema (ptr Schema))] (-> bool)
  (block :done
    (for [i 0 (al/al-len (.schemas heap))]
      (when (= (al/al-get (.schemas heap) i) schema) (break :done true)))
    false))
(defn register! [(heap (ptr Heap)) (schema Schema)] (-> (ptr Schema))
  (assert (= (.phase heap) 0))
  (block :done
    (when (or (<= (.logical schema) 0) (or (<= (.version schema) 0)
              (or (<= (.size schema) 0) (or (<= (.fields schema) 0)
                (or (<= (.alignment schema) 0) (!= (& (.alignment schema) (- (.alignment schema) 1)) 0))))))
      (break :done (p/cast (ptr Schema) 0)))
    (for [i 0 (al/al-len (.schemas heap))]
      (let [old (al/al-get (.schemas heap) i)]
        (when (and (= (.logical old) (.logical schema)) (= (.version old) (.version schema)))
          (break :done (p/cast (ptr Schema) 0)))))
    (unless (= (list/reserve! (field heap schemas) (+ (al/al-len (.schemas heap)) 1)) 0)
      (break :done (p/cast (ptr Schema) 0)))
    (match (a/box (.allocator heap) Schema schema)
      (None [] (p/cast (ptr Schema) 0))
      (Some [owned] (al/al-push! (field heap schemas) owned) owned))))
(defn edge! [(heap (ptr Heap)) (edge Edge)] (-> i64)
  (assert (= (.phase heap) 0))
  (block :done
    (unless (and (known? heap (.from edge)) (known? heap (.to edge))) (break :done -1))
    (unless (and (= (.logical (.from edge)) (.logical (.to edge)))
                 (< (.version (.from edge)) (.version (.to edge)))) (break :done -1))
    (for [i 0 (al/al-len (.edges heap))]
      (let [old (al/al-get (.edges heap) i)]
        (when (and (= (.from old) (.from edge)) (= (.to old) (.to edge))) (break :done -1))))
    (list/push! (field heap edges) edge)))
(defn allocate [(heap (ptr Heap)) (schema (ptr Schema))] (-> (slice u8))
  (match (a/alloc-bytes (.allocator heap) (.size schema) (.alignment schema))
    (None [] (slice/slice-new (p/cast (ptr u8) 0) 0))
    (Some [bytes]
      (for [i 0 (.size schema)] (store! (p/index (slice/slice-data bytes) i) (p/cast u8 0))) bytes)))
(defn new-with! [(heap (ptr Heap)) (schema (ptr Schema))
  (initialize (fnptr c [(ptr i8) (ptr i64)] i64))] (-> (ptr Handle))
  (assert (= (.phase heap) 0))
  (block :done
    (unless (known? heap schema) (break :done (p/cast (ptr Handle) 0)))
    (unless (= (list/reserve! (field heap handles) (+ (al/al-len (.handles heap)) 1)) 0)
      (break :done (p/cast (ptr Handle) 0)))
    (let [memory (allocate heap schema) initialized (p/alloc-stack i64)]
      (store! initialized 0)
      (when (= (p/cast i64 (payload memory)) 0) (break :done (p/cast (ptr Handle) 0)))
      (let [status (p/call-ptr initialize (payload memory) initialized)]
        (if (or (!= status 0) (or (!= (load initialized) (.fields schema))
                                (!= (p/call-ptr (.validate schema) (payload memory)) 0)))
          (do (p/call-ptr (.abort schema) (payload memory) (load initialized))
              (a/free-bytes (.allocator heap) memory (.alignment schema))
              (p/cast (ptr Handle) 0))
          (match (a/box (.allocator heap) Handle
                   (Handle :id (+ (al/al-len (.handles heap)) 1) :schema schema :memory memory))
            (None []
              (p/call-ptr (.abort schema) (payload memory) (load initialized))
              (a/free-bytes (.allocator heap) memory (.alignment schema))
              (p/cast (ptr Handle) 0))
            (Some [handle] (al/al-push! (field heap handles) handle) handle)))))))
(defn new! [(heap (ptr Heap)) (schema (ptr Schema))] (-> (ptr Handle))
  (if (known? heap schema) (new-with! heap schema (.initialize schema)) (p/cast (ptr Handle) 0)))
(defn root [(heap (ptr Heap)) (id i64)] (-> (ptr Handle))
  (block :done
    (for [i 0 (al/al-len (.roots heap))]
      (let [entry (al/al-get (.roots heap) i)]
        (when (= (.id entry) id) (break :done (.handle entry)))))
    (p/cast (ptr Handle) 0)))
(defn attach-root! [(heap (ptr Heap)) (id i64) (handle (ptr Handle))] (-> i64)
  (assert (= (.phase heap) 0))
  (block :done
    (when (or (<= id 0) (!= (p/cast i64 (root heap id)) 0)) (break :done -1))
    (let [(mut found) false]
      (for [i 0 (al/al-len (.handles heap))]
        (when (= (al/al-get (.handles heap) i) handle) (set! found true) (break)))
      (unless (load found) (break :done -1)))
    (list/push! (field heap roots) (Root :id id :handle handle))))
;;; A proposed new initializer or physical version never resets an existing
;;; root. Migration changes its payload through the graph transaction instead.
(defn root-with! [(heap (ptr Heap)) (id i64) (schema (ptr Schema))
  (initialize (fnptr c [(ptr i8) (ptr i64)] i64))] (-> (ptr Handle))
  (assert (= (.phase heap) 0))
  (block :done
    (unless (and (> id 0) (known? heap schema)) (break :done (p/cast (ptr Handle) 0)))
    (let [existing (root heap id)]
      (when (!= (p/cast i64 existing) 0)
        (break :done (if (= (.logical (.schema existing)) (.logical schema))
                      existing (p/cast (ptr Handle) 0)))))
    (unless (= (list/reserve! (field heap roots) (+ (al/al-len (.roots heap)) 1)) 0)
      (break :done (p/cast (ptr Handle) 0)))
    (let [handle (new-with! heap schema initialize)]
      (when (!= (p/cast i64 handle) 0)
        (al/al-push! (field heap roots) (Root :id id :handle handle)))
      handle)))

(defn root! [(heap (ptr Heap)) (id i64) (schema (ptr Schema))] (-> (ptr Handle))
  (if (known? heap schema) (root-with! heap id schema (.initialize schema)) (p/cast (ptr Handle) 0)))

(defn cancelled? [(flag (ptr i64))] (-> bool)
  (and (!= (p/cast i64 flag) 0) (!= (atomic/atomic-load flag) 0)))
(defn abort! [(heap (ptr Heap))] (-> i64)
  (assert (or (= (.phase heap) 1) (= (.phase heap) 2)))
  (for [n 0 (al/al-len (.staged heap))]
    (let [item (al/al-get (.staged heap) (- (- (al/al-len (.staged heap)) 1) n))]
      (p/call-ptr (.abort (.next-schema item)) (payload (.next-memory item)) (.initialized item))
      (a/free-bytes (.allocator heap) (.next-memory item) (.alignment (.next-schema item)))))
  (set! (.len (field heap staged)) 0)
  (relocation/reset! (field heap journal))
  (set! (.phase heap) 0) 0)
(defn prepare! [(heap (ptr Heap)) (targets (slice (ptr Schema))) (cancel (ptr i64))] (-> i64)
  (prepare-with-resets! heap targets (slice/slice-new (p/cast (ptr Reset) 0) 0) cancel))
(defn prepare-with-resets! [(heap (ptr Heap)) (targets (slice (ptr Schema)))
  (resets (slice Reset)) (cancel (ptr i64))] (-> i64)
  (assert (= (.phase heap) 0))
  (set! (.phase heap) 1)
  (set! (.missing-from heap) 0) (set! (.missing-to heap) 0) (set! (.missing-logical heap) 0)
  (let [status
    (block :done
      (for [i 0 (slice/slice-len targets)]
        (let [target (slice/slice-get targets i)]
          (unless (known? heap target) (break :done -1))
          (for [j 0 i]
            (let [other (slice/slice-get targets j)]
              (when (= (.logical target) (.logical other)) (break :done -1))))))
      (for [i 0 (slice/slice-len resets)]
        (let [request (slice/slice-get resets i) handle (root heap (.root request))]
          (when (= (p/cast i64 handle) 0) (break :done -1))
          (unless (known? heap (.schema request)) (break :done -1))
          (unless (= (.logical (.schema handle)) (.logical (.schema request))) (break :done -1))
          (when (= (p/cast i64 (p/cast (ptr i8) (.prepare request))) 0) (break :done -1))
          (for [j 0 i]
            (let [prior (slice/slice-get resets j)]
              (when (= (root heap (.root prior)) handle) (break :done -1))))))
      (unless (= (list/reserve! (field heap staged) (al/al-len (.handles heap))) 0) (break :done -4))
      ; Allocate every destination before invoking any policy. Clone unchanged
      ; objects too, so their references into changed objects are rewritten in
      ; private storage rather than mutating accepted incoming edges.
      (for [i 0 (al/al-len (.handles heap))]
        (when (cancelled? cancel) (break :done 3))
        (let [handle (al/al-get (.handles heap) i) old (.schema handle) (mut target) old
              (mut adapter) (.clone old) (mut reset) false]
          (for [j 0 (slice/slice-len targets)]
            (let [candidate (slice/slice-get targets j)]
              (when (= (.logical candidate) (.logical old)) (set! target candidate))))
          (for [j 0 (slice/slice-len resets)]
            (let [request (slice/slice-get resets j)]
              (when (= (root heap (.root request)) handle)
                (unless (= (.schema request) (load target)) (break :done -1))
                (set! adapter (.prepare request)) (set! reset true))))
          (when (and (!= (load target) old) (not (load reset)))
            (let [(mut found) false]
              (for [j 0 (al/al-len (.edges heap))]
                (let [edge (al/al-get (.edges heap) j)]
                  (when (and (= (.from edge) old) (= (.to edge) (load target)))
                    (set! adapter (.prepare edge)) (set! found true) (break))))
              (unless (load found)
                (set! (.missing-from heap) (.version old))
                (set! (.missing-to heap) (.version (load target)))
                (set! (.missing-logical heap) (.logical old))
                (break :done -3))))
          (let [memory (allocate heap (load target))]
            (when (= (p/cast i64 (payload memory)) 0) (break :done -4))
            (al/al-push! (field heap staged)
              (Staged :handle handle :old-schema old :next-schema (load target)
                :old-memory (.memory handle) :next-memory memory :initialized 0 :prepare (load adapter)))
            (let [result (relocation/object! (field heap journal) (payload (.memory handle))
                           (payload memory) (.logical old))]
              (when (!= result 0) (break :done result))))))
      (for [i 0 (al/al-len (.staged heap))]
        (when (cancelled? cancel) (break :done 3))
        (let [item (al/al-elem [Staged] (field heap staged) i)
              result (p/call-ptr (.prepare item) (payload (.old-memory item))
                (payload (.next-memory item)) (field heap journal) (field item initialized))]
          (when (!= result 0) (break :done result))
          (unless (= (.initialized item) (.fields (.next-schema item))) (break :done -5))))
      (for [i 0 (al/al-len (.staged heap))]
        (when (cancelled? cancel) (break :done 3))
        (let [item (al/al-get (.staged heap) i)
              result (p/call-ptr (.rewrite (.next-schema item)) (payload (.next-memory item)) (field heap journal))]
          (when (!= result 0) (break :done result))))
      (for [i 0 (al/al-len (.staged heap))]
        (when (cancelled? cancel) (break :done 3))
        (let [item (al/al-get (.staged heap) i)
              result (p/call-ptr (.check (field heap prepared-validation)) (.context (field heap prepared-validation))
                (.next-schema item) (payload (.next-memory item)))]
          (when (!= result 0) (break :done result))))
      0)]
    (if (= status 0) (set! (.phase heap) 2) (abort! heap))
    status))
;;; No allocation, callbacks or fallible work between the first header change
;;; and the last. The session keeps admission closed through its code/view swap.
(defn publish! [(heap (ptr Heap))] (-> i64)
  (assert (= (.phase heap) 2))
  (for [i 0 (al/al-len (.staged heap))]
    (let [item (al/al-get (.staged heap) i) handle (.handle item)]
      (set! (.schema handle) (.next-schema item))
      (set! (.memory handle) (.next-memory item))))
  (set! (.epoch heap) (+ (.epoch heap) 1))
  (set! (.phase heap) 3) 0)
(defn retire! [(heap (ptr Heap))] (-> i64)
  (assert (= (.phase heap) 3))
  (for [i 0 (al/al-len (.staged heap))]
    (let [item (al/al-get (.staged heap) i)]
      (p/call-ptr (.retire (.old-schema item)) (payload (.old-memory item)))
      (a/free-bytes (.allocator heap) (.old-memory item) (.alignment (.old-schema item)))))
  (set! (.len (field heap staged)) 0)
  (relocation/reset! (field heap journal))
  (set! (.phase heap) 0) 0)
(defn schema-retained? [(heap (ptr Heap)) (schema (ptr Schema)) (constructible (slice (ptr Schema)))] (-> bool)
  (block :done
    (for [i 0 (slice/slice-len constructible)]
      (when (= (slice/slice-get constructible i) schema) (break :done true)))
    (for [i 0 (al/al-len (.handles heap))]
      (when (= (.schema (al/al-get (.handles heap) i)) schema) (break :done true)))
    false))
;;; A controller may retire completed transition metadata after publishing an
;;; entire layout epoch. It supplies schemas still available for construction;
;;; actual handle layouts remain retained independently of that list.
(defn collect-schemas! [(heap (ptr Heap)) (constructible (slice (ptr Schema)))] (-> i64)
  (assert (= (.phase heap) 0))
  (set! (.len (field heap edges)) 0)
  (let [(mut kept) 0]
    (for [i 0 (al/al-len (.schemas heap))]
      (let [schema (al/al-get (.schemas heap) i)]
        (if (schema-retained? heap schema constructible)
          (do (al/al-set! (field heap schemas) (load kept) schema)
              (set! kept (+ (load kept) 1)) 0)
          (a/destroy [Schema] (.allocator heap) schema))))
    (set! (.len (field heap schemas)) (load kept))) 0)

(defn savepoint [(heap (ptr Heap))] (-> Savepoint)
  (assert (= (.phase heap) 0))
  (Savepoint :epoch (.epoch heap) :schemas (al/al-len (.schemas heap)) :edges (al/al-len (.edges heap))
    :handles (al/al-len (.handles heap)) :roots (al/al-len (.roots heap))))
;;; Candidate registrars may add schemas, transitions and initialized roots
;;; while admission is closed. Roll those additions back before unloading their
;;; native image: abort callbacks themselves belong to the candidate generation.
(defn rollback! [(heap (ptr Heap)) (point Savepoint)] (-> i64)
  (assert (!= (.phase heap) 3))
  (assert (= (.epoch heap) (.epoch point)))
  (assert (and (>= (.handles point) 0) (>= (.schemas point) 0)))
  (assert (and (and (>= (.roots point) 0) (<= (.roots point) (al/al-len (.roots heap))))
               (and (>= (.edges point) 0) (<= (.edges point) (al/al-len (.edges heap))))))
  (when (!= (.phase heap) 0) (abort! heap))
  (assert (and (<= (.handles point) (al/al-len (.handles heap)))
               (<= (.schemas point) (al/al-len (.schemas heap)))))
  (for [n (.handles point) (al/al-len (.handles heap))]
    (let [handle (al/al-get (.handles heap) (- (+ (al/al-len (.handles heap)) (.handles point)) (+ n 1)))
          schema (.schema handle)]
      (p/call-ptr (.abort schema) (payload (.memory handle)) (.fields schema))
      (a/free-bytes (.allocator heap) (.memory handle) (.alignment schema))
      (a/destroy [Handle] (.allocator heap) handle)))
  (set! (.len (field heap handles)) (.handles point))
  (set! (.len (field heap roots)) (.roots point))
  (set! (.len (field heap edges)) (.edges point))
  (for [i (.schemas point) (al/al-len (.schemas heap))]
    (a/destroy [Schema] (.allocator heap) (al/al-get (.schemas heap) i)))
  (set! (.len (field heap schemas)) (.schemas point)) 0)

(defn destroy! [(heap (ptr Heap))] (-> i64)
  (assert (= (.phase heap) 0))
  (for [i 0 (al/al-len (.handles heap))]
    (let [handle (al/al-get (.handles heap) i) schema (.schema handle)]
      (p/call-ptr (.retire schema) (payload (.memory handle)))
      (a/free-bytes (.allocator heap) (.memory handle) (.alignment schema))
      (a/destroy [Handle] (.allocator heap) handle)))
  (for [i 0 (al/al-len (.schemas heap))] (a/destroy [Schema] (.allocator heap) (al/al-get (.schemas heap) i)))
  (al/al-free! (field heap roots))
  (al/al-free! (field heap handles)) (al/al-free! (field heap schemas))
  (al/al-free! (field heap edges)) (al/al-free! (field heap staged))
  (relocation/destroy! (field heap journal)))
