(module live-poc-coil.lower)
(import "coil.primitive" :as p)
(import "live-poc-coil.policy-state" :as policy)
(import "live-poc-coil.schema-lower" :as schemas)
(import "live-poc-coil.sum-lower" :as sums)
(import "live-poc-coil.global-lower" :as globals)
(import "live-poc-coil.syntax-state" :as syntax)
(import "live-poc-coil.syntax-rewrite" :as rewrite)
(import "coil.jit.lifetime")
(import "live-poc-coil.function" :as function)
(import "live-poc-coil.eval" :as evaluation)
(import "live-poc-coil.semantic" :as semantic)

(defannotation :live/definition i64)
(defannotation :live/publication bool)
(defannotation :live/stage bool)

(extern lpc_stage_result :cc c [i64] (-> i64))
(extern lpc_preflight :cc c [] (-> i64))

(extern lpc_stage :cc c [i64 (ptr i8)] (-> i64))

(extern lpc_resolve :cc c [i64] (-> (ptr i8)))

;;; The policy recognizes concrete authored definitions before binding expansion.
;;; It owns its supported syntax rather than importing a second reload policy.
(defn definition? [(f Code)] (-> bool)
  (and (p/code-list? f) (and (>= (p/code-count f) 5)
    (and (p/code-sym? (p/code-nth f 1))
      (or (p/code-eq (p/code-nth f 0) `defn) (p/code-eq (p/code-nth f 0) `defn*))))))
(defn live-form? [(f Code)] (-> bool)
  (and (p/code-list? f) (and (> (p/code-count f) 0)
    (p/code-eq (p/code-nth f 0) `defn))))
(defn first-vector [(f Code)] (-> i64)
  (block :found
    (for [i 2 (p/code-count f)]
      (when (p/code-vector? (p/code-nth f i)) (break :found i)))
    -1))
(defn generic? [(f Code)] (-> bool)
  (let [at (first-vector f)]
    (and (>= at 0) (and (< (+ at 1) (p/code-count f))
      (p/code-vector? (p/code-nth f (+ at 1)))))))
(defn params-index [(f Code)] (-> i64)
  (let [at (first-vector f)] (if (generic? f) (+ at 1) at)))
(defn validate-header! [(f Code)] (-> i64)
  (let [params (params-index f)]
    (unless (and (>= (p/code-count f) 5)
      (and (p/code-sym? (p/code-nth f 1))
        (and (>= params 0)
          (and (< (+ params 2) (p/code-count f))
            (and (p/code-list? (p/code-nth f (+ params 1)))
              (and (= (p/code-count (p/code-nth f (+ params 1))) 2)
                (p/code-eq (p/code-nth (p/code-nth f (+ params 1)) 0) `->)))))))
      (p/error "live defn requires a name, typed parameter vector, explicit (-> Type), and body")
      0))
  0)
(defn attributes [(f Code)] (-> Code)
  (body f 2 (first-vector f)))
(defn struct-type? [(m Code) (t Code)] (-> bool)
  (let [(mut found) false]
    (for [i 1 (p/code-count m)]
      (let [f (p/code-nth m i)]
        (when (and (p/code-list? f) (and (>= (p/code-count f) 2)
          (and (p/code-eq (p/code-nth f 0) `defstruct) (p/code-eq (p/code-nth f 1) t))))
          (set! found true) 0)))
    (load found)))
(defn body [(f Code) (start i64) (end i64)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i start end] (p/code-list-push! out (p/code-nth f i)))
    (p/code-list-done out)))

;;; Session entry marker. The transform generates only staging writes here.
(defn publish [] (-> Code)
  (p/error "live publication requires the session transaction entry"))

(defn publish-blocked [(ids Code)] (-> Code)
  (p/error "blocked publication requires the session transaction entry"))
(defn marker? [(x Code)] (-> bool)
  (and (p/code-list? x)
    (or (and (= (p/code-count x) 1)
          (p/code-eq (p/code-nth x 0) `live-poc-coil.meta/publish))
        (and (= (p/code-count x) 2)
          (p/code-eq (p/code-nth x 0) `live-poc-coil.meta/publish-blocked)))))
(defn blocked-id? [(m Code) (id i64)] (-> bool)
  (block :found
    (for [i 1 (p/code-count m)]
      (let [form (p/code-nth m i)]
        (when (entry? form)
          (let [marker (p/code-nth form 4)]
            (when (= (p/code-count marker) 2)
              (let [ids (p/code-nth marker 1)]
                (for [j 0 (p/code-count ids)]
                  (when (p/code-eq (p/code-nth ids j) `~id)
                    (break :found true)))))))))
    false))

(defn entry? [(f Code)] (-> bool)
  (and (definition? f) (and (= (p/code-count f) 5) (marker? (p/code-nth f 4)))))

(defn active? [(m Code)] (-> bool)
  (let [(mut found) false]
    (for [i 1 (p/code-count m)]
      (when (entry? (p/code-nth m i)) (set! found true) 0))
    (load found)))

(defn lookup [(state Code) (module Code) (name Code)] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (p/code-count state)]
      (let [item (p/code-nth state i)]
        (when (and (p/code-eq (p/code-nth item 0) `~(p/code-str module))
          (p/code-eq (p/code-nth item 1) `~(p/code-str name)))
          (set! found i)
          0)))
    (load found)))
(defn direct-name? [(directs Code) (module Code) (name Code)] (-> bool)
  (block :found
    (for [i 0 (p/code-count directs)]
      (let [item (p/code-nth directs i)]
        (when (and (= (p/code-str (p/code-nth item 0)) (p/code-str module))
          (= (p/code-str (p/code-nth item 1)) (p/code-str name))) (break :found true))))
    false))

(defn args [(params Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count params)]
      (let [param (p/code-nth params i)]
        (unless (and (= (p/code-count param) 2)
                     (p/code-sym? (p/code-nth param 0)))
          (p/error "live parameters currently require a name and explicit type")
          0)
        (p/code-list-push! out (p/code-nth param 0))))
    (p/code-list-done out)))

(defn parameter-types [(m Code) (params Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count params)]
      (let [t (p/code-nth (p/code-nth params i) 1)]
        (p/code-list-push! out
                           (if (or (struct-type? m t)
                                   (p/code-eq (p/code-type-shape t) `struct))
                               `(ref ~t)
                               t))))
    (p/code-list-done out)))

(defn lower [(m Code) (registry (ptr Code)) (directs Code)] (-> Code)
  (let [out (p/code-list-new)
        updates (p/code-list-new)
        (mut evaluations) 0
        module (p/code-nth m 0)]
    (p/code-list-push! out module)
    (for [i 1 (p/code-count m)]
      (let [f (p/code-nth m i)]
        (cond (entry? f) 0
              (and (p/code-list? f) (and (= (p/code-count f) 2)
                (p/code-eq (p/code-nth f 0) `live-poc-coil.meta/evaluate)))
                (let [implementation (p/fresh-identifier "evaluation")]
                  (when (> (load evaluations) 0)
                    (p/error "one ordered evaluation block is permitted per submission") 0)
                  (set! evaluations (+ (load evaluations) 1))
                  (p/code-list-push! out
                    `(defn* ~implementation :jit/retain false [] (-> i64)
                       (evaluation/capture ~(p/code-nth f 1))))
                  (p/code-list-push! updates
                    `(evaluation/lpc_stage_eval (p/fnptr-of ~implementation)))
                  0)
              (staging-form? f)
                (do (p/code-list-push! out f)
                    (p/code-list-push! updates `(lpc_stage_result (~(p/code-nth f 1)))) 0)
              (live-form? f)
                (do
                  (validate-header! f)
                  (if (generic? f)
                    ; A generic is retained source, not one addressable runtime
                    ; body. Its concrete callers are regenerated by prepare-generics.
                    (do (p/code-list-push! out f) 0)
                  (let [name (p/code-nth f 1) param-at (params-index f)
                        attrs (attributes f)
                        params (p/code-nth f param-at)
                        retform (p/code-nth f (+ param-at 1))
                        ret (p/code-nth retform 1)
                        known (lookup (load registry) module name)
                        id (if (< known 0) (p/code-count (load registry)) known)
                        direct (if (< known 0) (direct-name? directs module name)
                          (and (> (p/code-count (p/code-nth (load registry) known)) 4)
                            (p/code-eq (p/code-nth (p/code-nth (load registry) known) 4) `true)))
                        binding (if (< known 0) (if direct (p/fresh-identifier "direct-binding") name)
                          (if (> (p/code-count (p/code-nth (load registry) known)) 5)
                            (p/code-nth (p/code-nth (load registry) known) 5) name))
                        helper
                          (if (< known 0)
                              (p/fresh-identifier "stage-typed")
                              (p/code-nth (p/code-nth (load registry) known) 2))
                        implementation (p/fresh-identifier (if direct "direct-implementation" (p/code-str name)))
                        gate (if direct name (p/fresh-identifier "entry-gate"))
                        types (if (< known 0) (parameter-types m params) (p/code-nth (p/code-nth (load registry) known) 3))]
                    (when (>= id 65536)
                      (p/error "live session supports at most 65536 function identities")
                      0)
                    (when (p/code-eq ret `Code)
                      (p/error "use defn* for static metaprogram helpers")
                      0)
                    (if (blocked-id? m id)
                      ; The checked prototype supplies the exact proposed ABI.
                      ; The semantic pass erases its fnptr reference before native
                      ; linking, so a blocked entry has no fake implementation.
                      (p/code-list-push! out
                        `(extern ~implementation :cc c [~@(parameter-types m params)] (-> ~ret)))
                      (p/code-list-push! out
                        `(defn* ~implementation :jit/retain false :live/definition ~id
                           ~@attrs ~params ~retform ~@(body f (+ param-at 2) (p/code-count f)))))
                    (when (< known 0)
                      (p/code-list-push! out
                                         `(defn* ~gate
                                            ~params
                                            ~retform
                                            (p/call-ptr (p/cast (fnptr c
                                                                       [~@types]
                                                                       ~ret)
                                                                (lpc_resolve ~id))
                                                        ~@(args params))))
                      (p/code-list-push! out
                                         `(def ~binding
                                            (function/Function
                                              :gate (p/fnptr-of ~gate) :id ~id)))
                      (p/code-list-push! out
                                         `(defn* ~helper [(address (fnptr c
                                                                          [~@types]
                                                                          ~ret))] (-> i64)
                                            (lpc_stage ~id
                                                       (p/cast (ptr i8) address))))
                      (store! registry
                              `(~@(load registry) (~(p/code-str module) ~(p/code-str name)
                                ~helper ~types ~direct ~binding)))
                      0)
                    ; The retained typed helper makes the checker validate the full
                    ; function-pointer ABI against the original gate on replacement.
                    (p/code-list-push! updates
                                       `(semantic/describe ~id ~(p/code-str name) ~binding (quote ~name) ~direct
                                          (p/fnptr-of ~helper) (p/fnptr-of ~implementation)
                                          ~(if (blocked-id? m id) (+ id 1) 0)))
                    0)))
              true (do (p/code-list-push! out f) 0))))
    (for [i 1 (p/code-count m)]
      (let [f (p/code-nth m i)]
        (when (entry? f)
          (p/code-list-push! out
                             `(~(p/code-nth f 0) ~(p/code-nth f 1)
                                 :live/publication true
                                 ~(p/code-nth f 2)
                                 ~(p/code-nth f 3)
                                 (do ~@(p/code-list-done updates) (lpc_preflight))))
          0)))
    (p/code-list-done out)))

(defn staging-form? [(form Code)] (-> bool)
  (block :done
    (unless (and (p/code-list? form) (>= (p/code-count form) 5)) (break :done false))
    (unless (p/code-eq (p/code-nth form 0) `defn*) (break :done false))
    (for [i 2 (p/code-count form)]
      (when (p/code-vector? (p/code-nth form i)) (break :done false))
      (when (and (p/code-eq (p/code-nth form i) `:live/stage) (< (+ i 1) (p/code-count form)))
        (break :done (p/code-eq (p/code-nth form (+ i 1)) `true))))
    false))

;;; Authored defn* bodies are compile-time artifacts. Keep a new physical name
;;; for each accepted source version and rewrite the submission to that name.
(defn authored-direct? [(form Code)] (-> bool)
  (and (definition? form) (and (p/code-eq (p/code-nth form 0) `defn*)
    (and (not (entry? form)) (not (staging-form? form))))))
(defn direct-index [(records Code) (module Code) (name Code)] (-> i64)
  (block :found
    (for [i 0 (p/code-count records)]
      (let [record (p/code-nth records i)]
        (when (and (p/code-eq (p/code-nth record 0) module)
          (p/bound-identifier=? (p/code-nth record 1) name)) (break :found i))))
    -1))
(defn direct-physical [(name Code) (version i64)] (-> Code)
  (let [parsed (p/code-read (p/code-str name "-live-direct-v" version) '(reader-config))]
    (unless (and (= (p/code-count parsed) 2) (p/code-sym? (p/code-nth parsed 1)))
      (p/error "direct physical name could not be represented as an identifier") 0)
    (p/code-nth parsed 1)))
(defn propose-direct! [(state (ptr Code)) (module Code) (form Code)] (-> i64)
  (let [records (policy/directs (load state)) name (p/code-nth form 1)
        known (direct-index records module name) index (if (< known 0) (p/code-count records) known)]
    (block :done
      (when (and (>= known 0) (p/code-eq (p/code-nth (p/code-nth records known) 4) form))
        (break :done -1))
      (let [version (if (< known 0) 1 (+ (p/code-int (p/code-nth (p/code-nth records known) 3)) 1))
            next `(~module ~name ~(direct-physical name version) ~version ~form) out (p/code-list-new)]
        (for [i 0 (p/code-count records)]
          (p/code-list-push! out (if (= i index) next (p/code-nth records i))))
        (when (= index (p/code-count records)) (p/code-list-push! out next) 0)
        (store! state (policy/with-directs (load state) (p/code-list-done out))))
      index)))
(defn direct-mapping [(state Code) (prior Code) (module Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count (policy/directs state))]
      (let [record (p/code-nth (policy/directs state) i)]
        (when (p/code-eq (p/code-nth record 0) module)
          (do
            (p/code-list-push! out `(~(p/code-nth record 1) ~(p/code-nth record 2)))
            (let [old (direct-index (policy/directs prior) module (p/code-nth record 1))]
              (when (>= old 0)
                (p/code-list-push! out `(~(p/code-nth (p/code-nth (policy/directs prior) old) 2)
                  ~(p/code-nth record 2))) 0))
            0))))
    (p/code-list-done out)))
(defn rename-direct [(form Code) (physical Code) (mapping Code)] (-> Code)
  (let [rewritten (rewrite/rewrite form mapping '()) out (p/code-list-new)]
    (for [i 0 (p/code-count rewritten)]
      (p/code-list-push! out (if (= i 1) physical (p/code-nth rewritten i))))
    (rewrite/rebuild rewritten (p/code-list-done out))))
(defn prepare-directs [(module Code) (state (ptr Code)) (accepted Code)] (-> Code)
  (let [out (p/code-list-new) name (p/code-nth module 0) (mut changed) false]
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (authored-direct? form)
          (validate-header! form)
          (when (>= (propose-direct! state name form) 0) (set! changed true) 0) 0)))
    (let [mapping (direct-mapping (load state) accepted name)]
    (for [i 0 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (if (authored-direct? form)
          (let [index (direct-index (policy/directs (load state)) name (p/code-nth form 1))]
            (p/code-list-push! out (rename-direct form
              (p/code-nth (p/code-nth (policy/directs (load state)) index) 2) mapping)))
          (p/code-list-push! out (rewrite-generics form mapping)))))
    (when (load changed)
      (for [i 0 (p/code-count (policy/authored accepted))]
        (let [record (p/code-nth (policy/authored accepted) i) form (p/code-nth record 2)]
          (when (and (p/code-eq (p/code-nth record 0) name)
            (not (incoming-name? module (p/code-nth record 1))))
            (p/code-list-push! out (rewrite-generics form mapping)) 0))))
    (p/code-list-done out))))

(defn incoming-name? [(module Code) (name Code)] (-> bool)
  (block :found
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (and (live-form? form)
          (p/bound-identifier=? (p/code-nth form 1) name)) (break :found true))))
    false))
(defn generic-index [(records Code) (module Code) (name Code)] (-> i64)
  (block :found
    (for [i 0 (p/code-count records)]
      (let [record (p/code-nth records i)]
        (when (and (p/code-eq (p/code-nth record 0) module)
          (p/bound-identifier=? (p/code-nth record 1) name)) (break :found i))))
    -1))
(defn generic-physical [(name Code) (version i64)] (-> Code)
  (let [parsed (p/code-read (p/code-str name "-live-generic-v" version) '(reader-config))]
    (unless (and (= (p/code-count parsed) 2) (p/code-sym? (p/code-nth parsed 1)))
      (p/error "generic physical name could not be represented as an identifier") 0)
    (p/code-nth parsed 1)))
(defn propose-generic! [(state (ptr Code)) (module Code) (form Code)] (-> i64)
  (let [records (policy/generics (load state)) name (p/code-nth form 1)
        known (generic-index records module name) index (if (< known 0) (p/code-count records) known)]
    (block :done
      (when (and (>= known 0) (p/code-eq (p/code-nth (p/code-nth records known) 4) form))
        (break :done -1))
      (let [version (if (< known 0) 1 (+ (p/code-int (p/code-nth (p/code-nth records known) 3)) 1))
            next `(~module ~name ~(generic-physical name version) ~version ~form)
            out (p/code-list-new)]
        (for [i 0 (p/code-count records)]
          (p/code-list-push! out (if (= i index) next (p/code-nth records i))))
        (when (= index (p/code-count records)) (p/code-list-push! out next) 0)
        (store! state (policy/with-generics (load state) (p/code-list-done out))))
      index)))
(defn generic-mapping [(state Code) (module Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count (policy/generics state))]
      (let [record (p/code-nth (policy/generics state) i)]
        (when (p/code-eq (p/code-nth record 0) module)
          (p/code-list-push! out `(~(p/code-nth record 1) ~(p/code-nth record 2))) 0)))
    (p/code-list-done out)))
(defn rename-generic [(form Code) (physical Code) (mapping Code)] (-> Code)
  (let [rewritten (rewrite/rewrite form mapping '()) out (p/code-list-new)]
    (for [i 0 (p/code-count rewritten)]
      (p/code-list-push! out (if (= i 1) physical (p/code-nth rewritten i))))
    (rewrite/rebuild rewritten (p/code-list-done out))))
(defn rewrite-generics [(form Code) (mapping Code)] (-> Code)
  (cond (or (live-form? form) (and (p/code-list? form)
          (p/code-eq (p/code-nth form 0) `defn*))) (rewrite/rewrite form mapping '())
        (and (p/code-list? form) (p/code-eq (p/code-nth form 0) `defstruct))
          (rewrite/sequence form 2 mapping '())
        (and (p/code-list? form) (or (p/code-eq (p/code-nth form 0) `def)
          (p/code-eq (p/code-nth form 0) `const))) (rewrite/sequence form 2 mapping '())
        (and (p/code-list? form) (or (p/code-eq (p/code-nth form 0) `extern)
          (p/code-eq (p/code-nth form 0) `live-poc-coil.meta/evaluate)))
          (rewrite/rewrite form mapping '())
        :else form))
(defn prepare-generics [(module Code) (state (ptr Code)) (accepted Code)] (-> Code)
  (let [(mut changed) false out (p/code-list-new) name (p/code-nth module 0)]
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (and (live-form? form) (generic? form))
          (when (>= (propose-generic! state name form) 0) (set! changed true) 0) 0)))
    (let [mapping (generic-mapping (load state) name)]
      (for [i 0 (p/code-count module)]
        (let [form (p/code-nth module i)]
          (if (and (live-form? form) (generic? form))
            (let [index (generic-index (policy/generics (load state)) name (p/code-nth form 1))]
              (p/code-list-push! out (rename-generic form
                (p/code-nth (p/code-nth (policy/generics (load state)) index) 2) mapping)))
            (p/code-list-push! out (rewrite-generics form mapping)))))
      (when (load changed)
        ; Generic instantiations are compile-time artifacts. Conservatively
        ; regenerate every accepted concrete function in the module so no caller
        ; retains a specialization of the prior template.
        (for [i 0 (p/code-count (policy/authored accepted))]
          (let [record (p/code-nth (policy/authored accepted) i) form (p/code-nth record 2)]
            (when (and (p/code-eq (p/code-nth record 0) name)
              (and (live-form? form) (and (not (generic? form))
                (not (incoming-name? module (p/code-nth record 1))))))
              (p/code-list-push! out (rewrite-generics form mapping)) 0))))
      (p/code-list-done out))))

(defn transform-session [(modules Code)] (-> Code)
  (let [(mut enabled) false]
    (for [i 0 (p/code-count modules)]
      (when (active? (p/code-nth modules i)) (set! enabled true) 0))
    (if (not (load enabled))
        `(do ~@modules)
        (let [accepted (policy/current) (mut candidate) accepted
              (mut registry) (policy/functions (policy/current))
              (mut carried) false out (p/code-list-new) prepared (p/code-list-new)]
          (for [i 0 (p/code-count modules)]
            (let [m (p/code-nth modules i)]
              (p/code-list-push! prepared (if (active? m)
                (prepare-generics (schemas/prepare (prepare-directs
                    (sums/prepare (globals/prepare m (mut candidate) accepted)
                      (mut candidate) accepted) (mut candidate) accepted) (mut candidate))
                  (mut candidate) accepted) m))))
          (let [prepared-modules (p/code-list-done prepared)]
          (for [mi 0 (p/code-count prepared-modules)]
            (let [m (p/code-nth prepared-modules mi)]
              (when (active? m)
                (for [fi 1 (p/code-count m)]
                  (let [form (p/code-nth m fi)]
                    (when (and (live-form? form) (not (generic? form)))
                      (validate-header! form)
                      (set! candidate (policy/remember (load candidate) (p/code-nth m 0) form)) 0))) 0)))
          (for [i 0 (p/code-count prepared-modules)]
            (let [m (p/code-nth prepared-modules i)]
              (if (active? m)
                (let [lowered (lower m (mut registry) (policy/directs (load candidate)))]
                  (if (load carried)
                    (do (p/code-list-push! out lowered) 0)
                    (do
                      (p/code-list-push! out `(~@lowered
                        ~(syntax/envelope (p/fresh-identifier "live-policy") (load candidate))))
                      (set! carried true) 0)))
                (do (p/code-list-push! out m) 0))))
          `(do ~@(p/code-list-done out)))))))
