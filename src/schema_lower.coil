(module live-poc-coil.schema-lower)
(import "coil.primitive" :as p)
(import "live-poc-coil.policy-state" :as policy)
(import "live-poc-coil.schema-records" :as records)
(import "live-poc-coil.schema-adapters" :as adapters)
(import "live-poc-coil.transitions" :as transitions)
(import "live-poc-coil.syntax-state" :as envelope)
(import "live-poc-coil.syntax-rewrite" :as syntax)
(import "live-poc-coil.managed-api" :as api)

(defn by-logical [(schemas Code) (logical Code)] (-> Code)
  (block :found
    (for [i 0 (p/code-count schemas)]
      (when (p/code-eq (p/code-nth (p/code-nth schemas i) 2) logical)
        (break :found (p/code-nth schemas i))))
    (p/error "persistent root has no current schema") '()))
(defn incoming-function? [(module Code) (name Code)] (-> bool)
  (block :found
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (and (syntax/head? form `defn)
          (p/bound-identifier=? (p/code-nth form 1) name)) (break :found true))))
    false))
(defn source-reference [(state Code) (module Code) (form Code)] (-> Code)
  (block :found
    (unless (p/code-sym? form) (break :found form))
    (for [i 0 (p/code-count (policy/schemas state))]
      (let [record (p/code-nth (policy/schemas state) i)]
        ; Source macro arguments precede resolution. Within the submitted
        ; module, exact spelling identifies the declaration being replaced;
        ; substitute its hygienic physical identifier before expansion.
        (when (and (p/code-eq (p/code-nth record 0) module)
          (= (p/code-str form) (p/code-str (p/code-nth record 1))))
          (break :found (p/code-nth record 4)))))
    form))
(defn source-rewrite [(state Code) (module Code) (form Code)] (-> Code)
  (cond (p/code-sym? form) (source-reference state module form)
        (not (or (p/code-list? form) (p/code-vector? form))) form
        (= (p/code-count form) 0) form
        (or (syntax/head? form `quote) (syntax/head? form `quasiquote)) form
        :else
          (let [out (p/code-list-new)]
            (for [i 0 (p/code-count form)]
              (p/code-list-push! out (source-rewrite state module (p/code-nth form i))))
            (syntax/rebuild form (p/code-list-done out)))))
(defn prepare [(module Code) (state (ptr Code))] (-> Code)
  (let [prior (load state) name (p/code-nth module 0) out (p/code-list-new)
        (mut changed) '() roots (p/code-list-new)]
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (and (records/schema? form) (not (records/physical? (load state) name form)))
          (let [index (records/propose! state name form)]
            (when (>= index 0) (set! changed `(~@(load changed) ~index)) 0)) 0)))
    ; A schema embeds the physical layout of every record-valued field. Close
    ; over that dependency graph so changing a child also versions all parents.
    (let [snapshot (load state) closure-count (p/code-count (p/code-nth snapshot 2))]
    (for [round 0 closure-count]
      (let [current (load state) current-schemas (p/code-nth current 2)]
      (for [i 0 (p/code-count current-schemas)]
        (let [record (p/code-nth current-schemas i)]
          (when (p/code-eq (p/code-nth record 0) name)
            (let [index (records/propose! state name (p/code-nth record 6))]
              (when (>= index 0) (set! changed `(~@(load changed) ~index)) 0)) 0))))))
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (transitions/declaration? form)
          (transitions/propose! state prior name form) 0)))
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (records/root? form)
          (p/code-list-push! roots `~(records/propose-root! state name form)) 0)))
    (p/code-list-push! out name)
    ; Physical schemas must precede macro consumers such as derive so Coil's
    ; generated-declaration registry exposes their compile-time reflection.
    (let [candidate (load state) changes (load changed)
          declarations (p/code-nth candidate 2) root-declarations (p/code-nth candidate 3)]
      (for [i 0 (p/code-count changes)]
        (let [record (p/code-nth declarations (p/code-int (p/code-nth changes i)))
              old-index (records/lookup (p/code-nth prior 2) name (p/code-nth record 1))]
          (p/code-list-push! out (records/physical-definition-with declarations record))
          (let [generated (adapters/emit record
                  (if (< old-index 0) '() (p/code-nth (p/code-nth prior 2) old-index))
                  declarations (p/code-nth prior 2))]
            (for [j 0 (p/code-count generated)] (p/code-list-push! out (p/code-nth generated j)))))))
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (if (records/physical? (load state) name form)
          (do (p/code-list-push! out form) 0)
          (unless (or (records/reset? form) (or (transitions/declaration? form) (or (records/schema? form) (records/root? form))))
            ; Macro inputs must see the candidate physical type before expansion;
            ; otherwise generated declarations retain an unresolved authored name.
            (p/code-list-push! out
              (if (or (syntax/head? form `defn) (or (syntax/head? form `defn*)
                      (or (syntax/head? form `def) (syntax/head? form `const))))
                form (source-rewrite (load state) name form))) 0))))
    (let [changes (load changed)]
      ; Until state dependencies are precise, recheck the module's complete live
      ; function set. This never rewrites an accepted machine-code body in place.
      (when (> (p/code-count changes) 0)
        (for [i 0 (p/code-count (policy/authored prior))]
          (let [record (p/code-nth (policy/authored prior) i)]
            (when (and (p/code-eq (p/code-nth record 0) name)
              (not (incoming-function? module (p/code-nth record 1))))
              (p/code-list-push! out (p/code-nth record 2)) 0))) 0))
    (let [indices (p/code-list-done roots)]
      (for [i 0 (p/code-count indices)]
        (let [current (load state) record (p/code-nth (p/code-nth current 3) (p/code-int (p/code-nth indices i)))
              generated (adapters/emit-root record (by-logical (p/code-nth current 2) (p/code-nth record 3)))]
          (for [j 0 (p/code-count generated)] (p/code-list-push! out (p/code-nth generated j))))))
    (for [i 1 (p/code-count module)]
      (let [form (p/code-nth module i)]
        (when (records/reset? form)
          (let [record (records/reset-record (load state) name form)
                generated (adapters/emit-root-command record
                  (by-logical (p/code-nth (load state) 2) (p/code-nth record 3)) true)]
            (for [j 0 (p/code-count generated)] (p/code-list-push! out (p/code-nth generated j)))))))
    (p/code-list-done out)))
(defn mapping [(state Code) (module Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (p/code-count (policy/schemas state))]
      (let [record (p/code-nth (policy/schemas state) i)]
        (when (p/code-eq (p/code-nth record 0) module)
          (p/code-list-push! out `(~(p/code-nth record 1) ~(p/code-nth record 4) ~(p/code-nth record 5))) 0)))
    (for [i 0 (p/code-count (policy/roots state))]
      (let [record (p/code-nth (policy/roots state) i) schema (by-logical (policy/schemas state) (p/code-nth record 3))]
        (when (p/code-eq (p/code-nth record 0) module)
          (p/code-list-push! out `(~(p/code-nth record 1)
            (p/cast (ptr ~(p/code-nth schema 4))
              (api/lpc_root_payload ~(p/code-nth record 2) ~(p/code-nth schema 2) ~(p/code-nth schema 3))))) 0)))
    (p/code-list-done out)))
(defn structure [(form Code) (map Code)] (-> Code)
  (let [out (p/code-list-new) (mut bound) '()
        fields (p/code-nth form (- (p/code-count form) 1)) clean (p/code-list-new)]
    (for [i 0 (- (p/code-count form) 1)]
      (let [part (p/code-nth form i)]
        (p/code-list-push! out part)
        (when (p/code-vector? part) (set! bound `(~@(load bound) ~@part)) 0)))
    (for [i 0 (p/code-count fields)]
      (let [field (p/code-nth fields i)]
        (p/code-list-push! clean (syntax/rebuild field
          `(~(p/code-nth field 0) ~(syntax/rewrite (p/code-nth field 1) map (load bound)))))))
    (p/code-list-push! out (syntax/rebuild fields (p/code-list-done clean)))
    (syntax/rebuild form (p/code-list-done out))))
(defn expanded [(modules Code)] (-> Code)
  (let [(mut candidate) '() out (p/code-list-new)]
    (for [mi 0 (p/code-count modules)]
      (let [module (p/code-nth modules mi)]
        (for [fi 1 (p/code-count module)]
          (when (policy/envelope? (p/code-nth module fi))
            (set! candidate (envelope/payload (p/code-nth module fi))) 0))))
    (if (= (p/code-count (load candidate)) 0) `(do ~@modules)
      (do
        (for [mi 0 (p/code-count modules)]
          (let [module (p/code-nth modules mi) map (mapping (load candidate) (p/code-nth module 0))
                next (p/code-list-new)]
            (p/code-list-push! next (p/code-nth module 0))
            (for [fi 1 (p/code-count module)]
              (let [form (p/code-nth module fi)]
                (p/code-list-push! next
                  (cond
                    (= (p/code-count map) 0) form
                    (policy/envelope? form) form
                    (syntax/head? form `defstruct) (structure form map)
                    (or (syntax/head? form `defn*) (syntax/head? form `defn)) (syntax/rewrite form map '())
                    (syntax/head? form `extern) (syntax/rewrite form map '())
                    (or (syntax/head? form `def) (syntax/head? form `const)) (syntax/sequence form 2 map '())
                    :else form))))
            (p/code-list-push! out (syntax/rebuild module (p/code-list-done next)))))
        `(do ~@(p/code-list-done out))))))
