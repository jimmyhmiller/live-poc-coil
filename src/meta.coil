(module live-poc-coil.meta)
(import "live-poc-coil.lower" :use * :reexport)
(transform transform-session :phase before-expand)
(import "live-poc-coil.semantic" :as semantic)
(transform-once semantic/transform)

(import "live-poc-coil.purity" :as purity :reexport)
(checker purity/check)

(import "live-poc-coil.schema-lower" :as schemas)
(transform schemas/expanded :phase after-expand)
