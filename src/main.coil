(module live-poc-coil.main)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.fs" :as fs)
(import "coil.str" :as str)
(import "coil.slice" :as slice)
(import "coil.jit" :as jit)
(import "coil.thread" :as thread)
(import "coil.result" :use *)
(import "live-poc-coil.session" :as session)
(import "live-poc-coil.protocol" :as protocol)
(import "live-poc-coil.server" :as server)
(import "live-poc-coil.paper")
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern chdir :cc c [(ptr i8)] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [project (getenv c"LPC_PROJECT")]
    (unless (= (p/cast i64 project) 0) (assert (= (chdir project) 0)) 0))
  (let [paper (or (< argc 2) (!= (str/cstr->str (load (p/index argv 1))) "--headless"))
        fixture (let [path (getenv c"LPC_FIXTURE")]
          (if (= (p/cast i64 path) 0) "fixtures/paper.coil" (str/cstr->str path)))
        source (if paper
          (match (fs/read-file (a/malloc-allocator) fixture)
            (Ok [text] text) (Err [_] ""))
          "(module live-demo) (import \"live-poc-coil.meta\") (defn f [] (-> i64) 42)")]
    (assert (= (session/init!) 0))
    (assert (= (protocol/init!) 0))
    (let [status (session/submit! source)]
    (when paper (a/free (a/malloc-allocator) source) 0)
    (if (!= status 0)
      (do (printf c"initial source rejected\n") (session/close!) (protocol/destroy!) 1)
      (let [compiler (field (session/instance) compiler)
            bootstrap-token (jit/jit-generation-retain-current! compiler)
            launch (if paper (jit/jit-symbol-address compiler "lpc_launch") (p/cast (ptr i8) 0))
            worker (p/alloc-stack thread/Thread)]
        (assert (> bootstrap-token 0))
        (assert (= (server/init!) 0))
        (if paper
          (do
            (assert (!= (p/cast i64 launch) 0))
            (assert (= (thread/thread-spawn-configured worker (p/fnptr-of server/worker) (p/cast (ptr i8) 0)
                        (thread/thread-config 33554432 16384)) 0))
            (p/call-ptr (p/cast (fnptr c [] i64) launch))
            (protocol/stop!)
            (assert (= (thread/thread-join worker) 0)))
          (server/serve!))
        (assert (>= (jit/jit-generation-release-token! compiler bootstrap-token) 0))
        (assert (= (session/close!) 0))
        (protocol/destroy!)
        0)))))
