(module live-poc-coil.source-plan)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "coil.slice" :as slice)
(import "live-poc-coil.source" :as source)
(import "live-poc-coil.fallible-list" :as list)
(defstruct Outcome [(index i64) (condition i64) (text (slice u8))])
(defstruct Change [(index i64) (condition i64) (revision i64) (replace-accepted bool)
  (accepted (slice u8)) (diagnostic (slice u8))])
(defstruct Plan [(changes (al/ArrayList Change)) (diagnostic (slice u8)) (ready bool)])
(defn init! [(plan (ptr Plan))] (-> i64)
  (store! plan (p/zeroed Plan))
  (set! (.changes plan) (al/al-new [Change] (a/malloc-allocator))) 0)
(defn clear! [(plan (ptr Plan))] (-> i64)
  (for [i 0 (al/al-len (.changes plan))]
    (let [change (al/al-get (.changes plan) i)]
      (a/free (a/malloc-allocator) (.accepted change))
      (a/free (a/malloc-allocator) (.diagnostic change))))
  (a/free (a/malloc-allocator) (.diagnostic plan))
  (set! (.diagnostic plan) "") (set! (.len (field plan changes)) 0)
  (set! (.ready plan) false) 0)
;;; Source metadata is allocated while native acceptance is still rollbackable.
;;; The plan owns replacements before publication and retired strings after it.
(defn prepare! [(plan (ptr Plan)) (ledger (ptr source/Ledger))
  (outcomes (slice Outcome)) (revision i64) (diagnostic (slice u8))] (-> i64)
  (assert (not (.ready plan)))
  (clear! plan)
  (set! (.diagnostic plan) (source/copy diagnostic))
  (block :done
    (unless (= (list/reserve! (field plan changes) (al/al-len (.forms ledger))) 0)
      (clear! plan) (break :done -4))
    (for [i 0 (al/al-len (.forms ledger))]
      (let [form (al/al-get (.forms ledger) i) (mut condition) (.condition form)
            (mut affected) (= (.attempt form) (.attempt ledger)) (mut text) (.desired form)]
        (for [j 0 (slice/slice-len outcomes)]
          (let [outcome (slice/slice-get outcomes j)]
            (when (= (.index outcome) i)
              (set! affected true) (set! condition (.condition outcome)) (set! text (.text outcome)))))
        (when (load affected)
          (let [replace (= (load condition) 0)]
            (al/al-push! (field plan changes)
              (Change :index i :condition (load condition)
                :revision (if replace revision (.revision form)) :replace-accepted replace
                :accepted (if replace (source/copy (load text)) "")
                :diagnostic (source/copy (if replace
                  (if (= (load text) (.desired form)) "" (.diagnostic form)) diagnostic))))))))
    (set! (.ready plan) true) 0))
(defn publish! [(plan (ptr Plan)) (ledger (ptr source/Ledger))] (-> i64)
  (assert (.ready plan))
  (for [i 0 (al/al-len (.changes plan))]
    (let [change (al/al-elem [Change] (field plan changes) i)
          form (al/al-elem [source/Form] (field ledger forms) (.index change))
          old-diagnostic (.diagnostic form)]
      (set! (.condition form) (.condition change))
      (set! (.revision form) (.revision change))
      (set! (.diagnostic form) (.diagnostic change))
      (set! (.diagnostic change) old-diagnostic)
      (when (.replace-accepted change)
        (let [old (.accepted form)]
          (set! (.accepted form) (.accepted change))
          (set! (.accepted change) old)))))
  (let [old (.diagnostic ledger)]
    (set! (.diagnostic ledger) (.diagnostic plan))
    (set! (.diagnostic plan) old))
  (set! (.ready plan) false) 0)
(defn destroy! [(plan (ptr Plan))] (-> i64)
  (clear! plan) (al/al-free! (field plan changes)))
