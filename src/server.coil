(module live-poc-coil.server)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.arraylist" :as al)
(import "live-poc-coil.jobs" :as jobs)
(import "coil.slice" :as slice)
(import "coil.socket" :as socket)
(import "coil.selectors" :as select)
(import "coil.scratch" :as scratch)
(import "coil.time" :as time)
(import "coil.str" :as str)
(import "coil.result" :use *)
(import "live-poc-coil.bencode" :as b)
(import "live-poc-coil.protocol" :as protocol)
(import "live-poc-coil.metrics" :as metrics)
(cimport "fcntl.h" :use [fcntl open O_NONBLOCK F_GETFL F_SETFL O_WRONLY O_CREAT O_TRUNC O_NOFOLLOW])
(cimport "sys/stat.h" :use [fchmod])
(extern write :cc c [i32 (ptr i8) u64] (-> i64))
(extern close :cc c [i32] (-> i32))
(extern memmove :cc c [(ptr i8) (ptr i8) u64] (-> (ptr i8)))
(extern snprintf :cc c [(ptr i8) u64 (ptr i8) ...] (-> i32))
(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern fflush :cc c [(ptr i8)] (-> i32))

(const CAPACITY 65536)
(defstruct Frame [(bytes (slice u8)) (job (ptr jobs/Job))])
(defstruct Client [(connection socket/TcpConnection) (active bool)
  (input (slice u8)) (used i64) (outbox (al/ArrayList Frame)) (jobs (al/ArrayList (ptr jobs/Job))) (sent i64) (output-bytes i64)
  (arena scratch/ScratchArena) (touched f64)])
(defstruct Server [(listener socket/TcpListener) (clients (array Client 32)) (port i64)])
(defn state [] (-> (ptr Server)) (p/alloc-static Server))
(defn nonblocking! [(fd i32)] (-> bool)
  (let [flags (fcntl fd F_GETFL)]
    (and (>= flags 0) (= (fcntl fd F_SETFL (| flags O_NONBLOCK)) 0))))
(defn write-discovery [(path (ptr i8)) (text (slice u8))] (-> i64)
  (let [fd (open path (p/cast i32 (| O_WRONLY (| O_CREAT (| O_TRUNC O_NOFOLLOW)))) (p/cast u32 384))]
    (if (< fd 0) -1
      (let [secure (fchmod fd (p/cast u16 384))
            written (if (= secure 0) (write fd (p/cast (ptr i8) (slice/slice-data text))
                                      (p/cast u64 (slice/slice-len text))) -1)
            closed (close fd)]
        (if (and (= written (slice/slice-len text)) (= closed 0)) 0 -1)))))
(defn execute-job [(job (ptr jobs/Job))] (-> i64)
  (set! (.response job)
    (protocol/dispatch-context (scratch/scratch-allocator (field job arena)) (field job request)
      (.received job) (field job cancel) (field job committed)))
  0)
(defn init! [] (-> i64)
  (let [s (state)]
    (store! s (p/zeroed Server))
    (match (socket/tcp-listen (a/malloc-allocator) (field s listener) "127.0.0.1" 0 true 32)
      (Err [e] (socket/socket-error-code e))
      (Ok [_]
        (match (socket/tcp-listener-port (field s listener))
          (Err [e] (socket/socket-error-code e))
          (Ok [port]
            (let [buffer (p/alloc-stack (array i8 32))]
              (set! (.port s) port)
              (assert (nonblocking! (.fd (field s listener))))
              (snprintf (p/cast (ptr i8) buffer) 32 c"%lld\n" port)
              (assert (= (write-discovery c".nrepl-port" (str/cstr->str (p/cast (ptr i8) buffer))) 0))
              (assert (= (write-discovery c".live-token" (.token (protocol/state))) 0))
              (jobs/init! (p/fnptr-of execute-job))
              (printf c"PORT=%lld\n" port)
              (fflush (p/cast (ptr i8) 0))
              0)))))))
(defn drop-frame! [(frame Frame)] (-> i64)
  (if (= (p/cast i64 (.job frame)) 0)
    (a/free (a/malloc-allocator) (.bytes frame)) (jobs/release! (.job frame)))
  0)
(defn output? [(c (ptr Client))] (-> bool) (> (al/al-len (.outbox c)) 0))
(defn close-client! [(c (ptr Client))] (-> i64)
  (when (.active c)
    (socket/tcp-connection-close! (field c connection))
    (for [i 0 (al/al-len (.jobs c))] (jobs/release! (al/al-get (.jobs c) i)))
    (for [i 0 (al/al-len (.outbox c))] (drop-frame! (al/al-get (.outbox c) i)))
    (al/al-free! (field c jobs)) (al/al-free! (field c outbox))
    (a/free (a/malloc-allocator) (.input c))
    (scratch/scratch-close! (field c arena))
    (set! (.active c) false))
  0)
(defn accept! [] (-> i64)
  (let [s (state) connection (p/alloc-stack socket/TcpConnection) (mut slot) -1]
    (for [i 0 32] (when (and (< (load slot) 0) (not (.active (p/index (field s clients) i)))) (set! slot i)))
    (match (socket/tcp-accept (field s listener) connection)
      (Err [_] -1)
      (Ok [_]
        (if (< (load slot) 0) (socket/tcp-connection-close! connection)
          (let [c (p/index (field s clients) (load slot))]
            (store! c (p/zeroed Client))
            (set! (.connection c) (load connection))
            (if (not (nonblocking! (.fd connection))) (socket/tcp-connection-close! connection)
              (match (a/alloc [u8] (a/malloc-allocator) CAPACITY)
                (None [] (socket/tcp-connection-close! connection))
                (Some [bytes]
                  (set! (.input c) bytes)
                  (set! (.jobs c) (al/al-new [(ptr jobs/Job)] (a/malloc-allocator)))
                  (set! (.outbox c) (al/al-new [Frame] (a/malloc-allocator)))
                  (set! (.active c) true)
                  (set! (.touched c) (metrics/now))
                  (scratch/scratch-init (field c arena) (a/malloc-allocator))
                  0)))))))))
(defn append-frame! [(c (ptr Client)) (bytes (slice u8)) (job (ptr jobs/Job))] (-> i64)
  (al/al-push! (field c outbox) (Frame :bytes bytes :job job))
  (set! (.output-bytes c) (+ (.output-bytes c) (slice/slice-len bytes)))
  0)
(defn harvest! [(c (ptr Client))] (-> i64)
  (when (.active c)
    (let [(mut kept) 0]
      (for [i 0 (al/al-len (.jobs c))]
        (let [job (al/al-get (.jobs c) i)]
          (if (jobs/ready? job)
            (append-frame! c (.response job) job)
            (do (al/al-set! (field c jobs) (load kept) job)
                (set! kept (+ (load kept) 1)) 0))))
      (set! (.len (field c jobs)) (load kept)))
    (when (> (.output-bytes c) 1048576) (close-client! c)))
  0)
(defn process-buffer! [(c (ptr Client))] (-> i64)
  ; Decode pipelined control messages while previous edits remain in flight.
  ; Budget each visit so a busy client cannot monopolize the network lane.
  (for [turn 0 8]
    (unless (.active c) (break))
    (let [request (p/alloc-stack b/Request)
          wire (slice/slice-new (slice/slice-data (.input c)) (.used c))
          consumed (b/bdecode-request wire request)]
      (when (< consumed 0) (close-client! c) (break))
      (when (= consumed 0)
        (when (= (.used c) CAPACITY) (close-client! c))
        (break))
      (scratch/scratch-reset! (field c arena))
      (let [allocator (scratch/scratch-allocator (field c arena))]
        (if (and (protocol/authorized? request)
                 (or (= (.op request) "eval") (= (.op request) "load-file")))
          (let [job (if (< (al/al-len (.jobs c)) 8)
                      (jobs/enqueue! (slice/subslice wire 0 consumed) (metrics/now))
                      (p/cast (ptr jobs/Job) 0))]
            (if (!= (p/cast i64 job) 0)
              (al/al-push! (field c jobs) job)
              (let [(mut response) (b/response-new allocator)]
                (b/response-string! (mut response) "id" (.id request))
                (protocol/failure! (mut response) "compiler queue capacity reached; request was not admitted")
                (append-frame! c (protocol/copy-text (a/malloc-allocator)
                  (b/response-finish! (mut response))) (p/cast (ptr jobs/Job) 0)))))
          (append-frame! c (protocol/copy-text (a/malloc-allocator)
            (protocol/dispatch-request allocator request)) (p/cast (ptr jobs/Job) 0))))
      (set! (.used c) (- (.used c) consumed))
      (memmove (p/cast (ptr i8) (slice/slice-data (.input c)))
        (p/cast (ptr i8) (p/index (slice/slice-data (.input c)) consumed)) (p/cast u64 (.used c)))
      (when (> (.output-bytes c) 1048576) (close-client! c))
      (when (= (protocol/stopping) 1) (break))))
  0)
(defn retryable? [(error socket/SocketError)] (-> bool)
  (match error
    (socket/IoFailed [code] (or (= code 35) (or (= code 11) (= code 4))))
    (_ false)))
(defn read-client! [(c (ptr Client))] (-> i64)
  (match (socket/tcp-read (field c connection)
           (p/cast (ptr i8) (p/index (slice/slice-data (.input c)) (.used c))) (- CAPACITY (.used c)))
    (Err [e] (unless (retryable? e) (close-client! c)) 0)
    (Ok [n] (if (= n 0) (close-client! c)
      (do (set! (.used c) (+ (.used c) n)) (set! (.touched c) (metrics/now)) 0)))))
(defn write-client! [(c (ptr Client))] (-> i64)
  (when (and (.active c) (output? c))
    (let [frame (al/al-get (.outbox c) 0)]
      (match (socket/tcp-write (field c connection)
               (p/cast (ptr i8) (p/index (slice/slice-data (.bytes frame)) (.sent c)))
               (- (slice/slice-len (.bytes frame)) (.sent c)))
        (Err [e] (unless (retryable? e) (close-client! c)) 0)
        (Ok [n] (if (= n 0) (close-client! c)
          (do
            (set! (.sent c) (+ (.sent c) n)) (set! (.touched c) (metrics/now))
            (when (= (.sent c) (slice/slice-len (.bytes frame)))
              (set! (.output-bytes c) (- (.output-bytes c) (slice/slice-len (.bytes frame))))
              (drop-frame! frame)
              (for [i 1 (al/al-len (.outbox c))]
                (al/al-set! (field c outbox) (- i 1) (al/al-get (.outbox c) i)))
              (set! (.len (field c outbox)) (- (al/al-len (.outbox c)) 1))
              (set! (.sent c) 0))
            0))))))
  0)
(defn serve! [] (-> i64)
  (let [s (state) watches (p/alloc-stack (array select/Watch 34))
        (mut count) 0 (mut cursor) 0
        duration (match (time/duration-millis 50) (Ok [d] d) (Err [_] (p/zeroed time/Duration)))]
    (loop
      (when (= (protocol/stopping) 1) (break))
      (set! count 2)
      (store! (p/index watches 0) (socket/tcp-listener-watch (field s listener) -1))
      (store! (p/index watches 1) (select/watch (.wake-read (jobs/state)) (select/interest-readable) -2))
      (for [j 0 32]
        (let [i (% (+ j (load cursor)) 32) c (p/index (field s clients) i)]
          (harvest! c)
          (process-buffer! c)
          (when (and (.active c) (> (- (metrics/now) (.touched c)) 30.0)) (close-client! c))
          (when (.active c)
            (store! (p/index watches (load count))
              (socket/tcp-connection-watch (field c connection)
                (if (output? c)
                  (select/interest-read-write) (select/interest-readable)) i))
            (set! count (+ (load count) 1)))))
      (match (select/wait-many-for (a/malloc-allocator) (slice/slice-new (p/cast (ptr select/Watch) watches) (load count)) duration)
        (Err [_] 0)
        (Ok [selection]
          (let [selected selection]
          (cond (= (.token selected) -1) (accept!)
                (= (.token selected) -2) (jobs/drain-network!)
                true
            (let [i (.token selected) c (p/index (field s clients) i)]
              (set! cursor (% (+ i 1) 32))
              (write-client! c)
              (when (.active c) (read-client! c))))))))
    (jobs/close!)
    ; Complete an already encoded shutdown reply without admitting new work.
    (for [i 0 32]
      (let [c (p/index (field s clients) i)]
        (when (.active c) (write-client! c))
        (close-client! c)))
    (jobs/destroy!)
    (socket/tcp-listener-close! (field s listener))))
(defn worker [(unused (ptr i8))] (-> (ptr i8)) (serve!) (p/cast (ptr i8) 0))
